{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mac-debug",
      "displayName": "macOS Apple Silicon Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "mac-release",
      "displayName": "macOS Apple Silicon Release",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/build/mac-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-size",
      "displayName": "macOS Apple Silicon Size",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/build/mac-size",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "mac-asan",
      "displayName": "macOS Apple Silicon AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/build/mac-asan",
      "cacheVariables": { "VEXEL_SANITIZER": "asan-ubsan" }
    },
    {
      "name": "mac-ubsan",
      "displayName": "macOS Apple Silicon UndefinedBehaviorSanitizer",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/build/mac-ubsan",
      "cacheVariables": { "VEXEL_SANITIZER": "ubsan" }
    },
    {
      "name": "mac-tsan",
      "displayName": "macOS Apple Silicon ThreadSanitizer (worker and snapshot only)",
      "inherits": "mac-debug",
      "binaryDir": "${sourceDir}/build/mac-tsan",
      "cacheVariables": { "VEXEL_SANITIZER": "tsan" }
    }
  ],
  "buildPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" },
    { "name": "mac-size", "configurePreset": "mac-size" },
    { "name": "mac-asan", "configurePreset": "mac-asan" },
    { "name": "mac-ubsan", "configurePreset": "mac-ubsan" },
    { "name": "mac-tsan", "configurePreset": "mac-tsan" }
  ],
  "testPresets": [
    { "name": "mac-asan", "configurePreset": "mac-asan", "output": { "outputOnFailure": true } },
    { "name": "mac-ubsan", "configurePreset": "mac-ubsan", "output": { "outputOnFailure": true } },
    { "name": "mac-tsan", "configurePreset": "mac-tsan", "output": { "outputOnFailure": true } }
  ]
}
