   138	/// Original reference predicates: 4,096 comments, 512 rectangles, two stops.
   139	#[test]
   140	fn cached_gradient_scan_reference_predicate() {
   141	    let mut bytes = br#"<svg width="8" height="8"><defs><linearGradient id="g"><stop stop-color="red"/><stop offset="1" stop-color="blue"/>"#.to_vec();
   142	    for _ in 0..4096 {
   143	        bytes.extend_from_slice(b"<!-- padding -->");
   144	    }
   145	    bytes.extend_from_slice(b"</linearGradient></defs>");
   146	    for _ in 0..512 {
   147	        bytes.extend_from_slice(b"<rect width=\"1\" height=\"1\" fill=\"url(#g)\"/>");
   148	    }
   149	    bytes.extend_from_slice(b"</svg>");
   150	    let original = bytes.clone();
   151	    let source = Arc::new(bytes);
   152	    let mut run = Run;
   153	    let doc = LexicalDocument::parse(source.clone(), 2 * 1024 * 1024, &mut run).unwrap();
   154	    let mut shared = DecodeSource::new(&doc, &mut run).unwrap();
   155	    let mut cache = PaintCache::default();
   156	    let mut ledger = ChargeLedger::new(&source, 32 * 1024 * 1024, 4096).unwrap();
   157	    let mut rects = 0;
   158	    let mut stop_count = 0;
   159	    let comment_count = doc
   160	        .tokens()
   161	        .iter()
   162	        .filter(|t| t.kind == TokenKind::Comment)
   163	        .count();
   164	    assert_eq!(comment_count, 4096);
   165	    for (i, t) in doc.tokens().iter().enumerate() {
   166	        if t.kind == TokenKind::EmptyElement && t.local_name.slice(&source) == Some(b"stop") {
   167	            stop_count += 1;
   168	        }
   169	        if !matches!(t.kind, TokenKind::StartElement | TokenKind::EmptyElement)
   170	            || t.local_name.slice(&source) != Some(b"rect")
   171	        {
   172	            continue;
   173	        }
   174	        rects += 1;
   175	        let style = shared.compute_style(ElementId(i), None, &mut run).unwrap();
   176	        let span = style.value(Property::Fill).unwrap().span;
   177	        let edges = [vexel_geometry::Edge {
   178	            a: vexel_geometry::Point { x: 0., y: 0. },
   179	            b: vexel_geometry::Point { x: 1., y: 1. },
   180	        }];
   181	        let resolved = vexel_svg_paint::resolve_cached_fill(
   182	            &mut shared,
   183	            &mut cache,
   184	            &mut ledger,
   185	            span,
   186	            &edges,
   187	            affine_identity(),
   188	            [8., 8.],
   189	            &mut run,
   190	        )
   191	        .unwrap();
   192	        assert_eq!(resolved.stops.len(), 2);
   193	    }
   194	    assert_eq!(rects, 512);
   195	    assert_eq!(stop_count, 2);
   196	    assert_eq!(cache.entries.len(), 1);
   197	    assert_eq!(cache.entries[0].stops.len(), 2);
   198	    println!(
   199	        "gradient comments={comment_count} rects={rects} stops={stop_count} token_visits={}",
   200	        cache.token_visits
   201	    );
   202	    assert!(
   203	        (4096..=37376).contains(&cache.token_visits),
   204	        "{}",
   205	        cache.token_visits
   206	    );
   207	    assert_eq!(source.as_slice(), original.as_slice());
   208	}
