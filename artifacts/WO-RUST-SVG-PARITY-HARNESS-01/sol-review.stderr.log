   294	/// Original C reference clip boundary predicate: 65,536 succeeds; +1 is a typed limit.
   295	#[test]
   296	fn clip_source_and_aggregate_bounds_reference_predicate() {
   297	    let mut p = DefinitionPlanner::new();
   298	    let (ok, src) = plan_clip(clip_bytes(65536, 1), &mut p);
   299	    assert_eq!(ok, Ok(()));
   300	    assert!(!src.is_empty());
   301	    let (over, src) = plan_clip(clip_bytes(65537, 1), &mut p);
   302	    let e = over.unwrap_err();
   303	    assert_eq!(e.kind, ErrorKind::Limit(LimitKind::References));
   304	    assert_eq!(
   305	        e.offset,
   306	        src.windows(b"clipPath".len())
   307	            .position(|w| w == b"clipPath")
   308	            .unwrap()
   309	    );
   310	    println!(
   311	        "clip single exact=65536 success; over=65537 error={:?} offset={}",
   312	        e.kind, e.offset
   313	    );
   314	    let wrapper = b"<svg width=\"1\" height=\"1\" viewBox=\"0 0 1 1\">".len() + b"</svg>".len() + 1;
   315	    let child = 65536 - wrapper;
   316	    assert_eq!((wrapper + child) * 8, 512 * 1024);
   317	    let aggregate = clip_bytes(child, 1);
   318	    assert_eq!(plan_repeated(aggregate.clone(), 8), Ok(()));
   319	    let total = (wrapper + child) * 8;
   320	    println!("clip aggregate wrapper={wrapper} child={child} total={total} eight=success");
   321	    let e = plan_repeated(aggregate, 9).unwrap_err();
   322	    assert_eq!(e.kind, ErrorKind::Limit(LimitKind::References));
   323	    assert_eq!(e.offset, 33);
   324	    println!("clip aggregate nine error={:?} offset={}", e.kind, e.offset);
   325	}
