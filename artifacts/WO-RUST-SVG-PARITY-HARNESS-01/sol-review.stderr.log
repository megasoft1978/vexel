   108	fn attribute(
   109	    source: &[u8],
   110	    tokens: &[vexel_xml::XmlToken],
   111	    element: &vexel_xml::XmlToken,
   112	    name: &[u8],
   113	) -> Option<XmlSpan> {
   114	    let i = tokens.iter().position(|t| std::ptr::eq(t, element))?;
   115	    tokens
   116	        .get(i + 1..)?
   117	        .iter()
   118	        .take_while(|t| t.kind == TokenKind::Attribute)
   119	        .find(|t| t.local_name.slice(source) == Some(name))
   120	        .map(|t| t.value)
   121	}
   122	fn named(source: &[u8], tokens: &[vexel_xml::XmlToken], tag: &[u8], id: &[u8]) -> ElementId {
   123	    ElementId(
   124	        tokens
   125	            .iter()
   126	            .enumerate()
   127	            .find_map(|(i, t)| {
   128	                (matches!(t.kind, TokenKind::StartElement | TokenKind::EmptyElement)
   129	                    && t.local_name.slice(source) == Some(tag)
   130	                    && attribute(source, tokens, t, b"id")
   131	                        .is_some_and(|v| v.slice(source) == Some(id)))
   132	                .then_some(i)
   133	            })
   134	            .unwrap(),
   135	    )
   136	}
