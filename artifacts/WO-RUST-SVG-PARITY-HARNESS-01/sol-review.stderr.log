   210	fn clip_bytes(child: usize, declarations: usize) -> Vec<u8> {
   211	    let prefix=b"<svg width=\"1\" height=\"1\"><defs><clipPath id=\"c\" clipPathUnits=\"objectBoundingBox\">";
   212	    let cp = b"<!--";
   213	    let middle = b"--><rect width=\"1\" height=\"1\"/>";
   214	    let suffix = b"</clipPath></defs>";
   215	    let declaration = b"<rect width=\"1\" height=\"1\" clip-path=\"url(#c)\"/>";
   216	    let mut out = Vec::new();
   217	    out.extend_from_slice(prefix);
   218	    out.extend_from_slice(cp);
   219	    out.resize(out.len() + child - cp.len() - middle.len(), b'b');
   220	    out.extend_from_slice(middle);
   221	    out.extend_from_slice(suffix);
   222	    for _ in 0..declarations {
   223	        out.extend_from_slice(declaration)
   224	    }
   225	    out.extend_from_slice(b"<path id=\"owner\" d=\"M0 0L1 0L1 1Z\"/></svg>");
   226	    out
   227	}
   228	fn plan_clip(
   229	    bytes: Vec<u8>,
   230	    planner: &mut DefinitionPlanner,
   231	) -> (std::result::Result<(), Diagnostic>, Vec<u8>) {
   232	    let (source, doc, mut builder, scene, owner, owner_element, mut ledger) = source_fixture(bytes);
   233	    let before = source.to_vec();
   234	    let mut run = Run;
   235	    let mut shared = DecodeSource::new(&doc, &mut run).unwrap();
   236	    let style = shared.compute_style(owner_element, None, &mut run).unwrap();
   237	    let definition = named(&source, doc.tokens(), b"clipPath", b"c");
   238	    let mut active = ActiveDefinitions::default();
   239	    let mut context = DefinitionContext {
   240	        shared: &mut shared,
   241	        builder: &mut builder,
   242	        scene,
   243	        active: &mut active,
   244	        ledger: &mut ledger,
   245	    };
   246	    let result = planner
   247	        .plan(
   248	            &mut context,
   249	            DefinitionKind::Clip,
   250	            definition,
   251	            owner,
   252	            affine_identity(),
   253	            [0., 0., 1., 1.],
   254	            &style,
   255	            &mut run,
   256	        )
   257	        .map(|_| ());
   258	    assert_eq!(source.as_slice(), before);
   259	    (result, before)
   260	}
   261	
   262	fn plan_repeated(bytes: Vec<u8>, count: usize) -> std::result::Result<(), Diagnostic> {
   263	    let (source, doc, mut builder, scene, owner, owner_element, mut ledger) = source_fixture(bytes);
   264	    let before = source.to_vec();
   265	    let mut run = Run;
   266	    let mut shared = DecodeSource::new(&doc, &mut run).unwrap();
   267	    let style = shared.compute_style(owner_element, None, &mut run).unwrap();
   268	    let definition = named(&source, doc.tokens(), b"clipPath", b"c");
   269	    let mut active = ActiveDefinitions::default();
   270	    let mut planner = DefinitionPlanner::new();
   271	    let mut context = DefinitionContext {
   272	        shared: &mut shared,
   273	        builder: &mut builder,
   274	        scene,
   275	        active: &mut active,
   276	        ledger: &mut ledger,
   277	    };
   278	    for _ in 0..count {
   279	        planner.plan(
   280	            &mut context,
   281	            DefinitionKind::Clip,
   282	            definition,
   283	            owner,
   284	            affine_identity(),
   285	            [0., 0., 1., 1.],
   286	            &style,
   287	            &mut run,
   288	        )?;
   289	    }
   290	    assert_eq!(source.as_slice(), before);
   291	    Ok(())
   292	}
