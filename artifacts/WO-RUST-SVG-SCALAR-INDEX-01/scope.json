  "operations": [
    {
      "owner": "RASTER_INDEX",
      "name": "bounds",
      "signature": "fn build_bounds(view: SceneView<'_>, map: ViewMapping, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<BoundsSet>; fn mark_boundaries(view: SceneView<'_>, map: ViewMapping, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<BoundaryMask>; fn mark_clip_boundaries(view: SceneView<'_>, map: ViewMapping, boundary: &mut BoundaryMask, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<()>; fn boundary_test(mask: &BoundaryMask, pixel: usize) -> bool",
      "contract": "Bounds include every paintable scalar sample: caps/joins/dashes/clips. Full boundary marking on invalid clip inverse. Preserve conservative degenerate/full-tile cases; 200M boundary-work cap; own/drop arrays. KernelResources is passed explicitly to operations requiring clip/stroke queries; lower writer consumes the shared interface and the coordinator supplies actual implementations."
    },
    {
      "owner": "RASTER_INDEX",
      "name": "scanline",
      "signature": "fn create_scanlines(view: SceneView<'_>, bounds: &BoundsSet, map: ViewMapping, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<ScanlineIndex>; fn reset_scanlines(index: &mut ScanlineIndex); fn build_row(index: &mut ScanlineIndex, view: SceneView<'_>, pixel_y: u32, rows: &mut RowBuffers, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<usize>",
      "contract": "Original event/tree algorithm, 5 samples rows, active capacities explicit, no hidden allocations per row; ascending shape painter order, original tiebreaks. KernelResources is passed explicitly to operations requiring clip/stroke queries; lower writer consumes the shared interface and the coordinator supplies actual implementations."
    },
    {
      "owner": "RASTER_INDEX",
      "name": "fill cache",
      "signature": "fn create_fill_cache(view: SceneView<'_>, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<FillCache>; fn eligible(cache: &FillCache, shape: ShapeId) -> bool; fn color(view: SceneView<'_>, shape: ShapeId) -> Option<[u8;4]>; fn build_fill_row(cache: &mut FillCache, view: SceneView<'_>, shape: ShapeId, y: u32, map: ViewMapping, rows: &RowBuffers, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<FillRowWork>; fn build_runs(cache: &mut FillCache, view: SceneView<'_>, bounds: PixelBounds, y: u32, boundary: &BoundaryMask, map: ViewMapping, resources: &dyn KernelResources, control: &mut dyn WorkControl) -> Result<usize>; fn pixel_runs(cache: &FillCache) -> &[PixelRun]; fn interval_pixel_range(view: SceneView<'_>, bounds: PixelBounds, map: ViewMapping, sample_offset: f64, interval: FillInterval) -> Result<(TableRange,usize)>; fn fill_contains(cache: &FillCache, sample_row: usize, x: f64) -> (bool,usize)",
      "contract": "FillRowWork records edge_visits/work_units. Entire uniform fill eligibility/exclusions, heap sort crossings/winding/interval algorithms and binary comparisons stay; >4096-edge shapes use original scalar fallback rather than refusal. KernelResources is passed explicitly to operations requiring clip/stroke queries; lower writer consumes the shared interface and the coordinator supplies actual implementations."
    },
    {
