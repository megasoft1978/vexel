  "operations": [
    {
      "owner": "DECODE",
      "name": "Decoder::new",
      "signature": "fn new(source: &'a SourceOwner, tokens: &'a [XmlToken], generation: u64, options: DecodeOptions<'a>, control: &mut dyn WorkControl) -> Result<Decoder<'a>>",
      "contract": "Own builder and bounded continuation stack, borrow external immutable source/tokens, own ephemeral CSS/reference caches borrowing same external data. No self reference. Cancellation invalidates draft and outstanding tickets."
    },
    {
      "owner": "DECODE",
      "name": "Decoder::step",
      "signature": "fn step<'s>(&'s mut self, work_quantum: u64, operations: &mut dyn DecodeOperations, control: &mut dyn WorkControl) -> Result<DecodeEvent<'s>>",
      "contract": "Bounded engine handles XML-depth/inherited style/viewport/transform/group/text stacks and local use expansions. No calls from lower definition/media/paint modules back into engine; planners enqueue typed child/post operations."
    },
    {
      "owner": "DECODE",
      "name": "Decoder::resume_pattern",
      "signature": "fn resume_pattern(&mut self, ticket: PatternTicket, result: Result<Tile>, control: &mut dyn WorkControl) -> Result<()>",
      "contract": "After request view borrow ends, validate ticket/dimensions/capacity; move rendered pixels once into pattern; update cache/budget then continue same position. Error aborts job, no fallback or skipping. Nested patterns finish before parent event."
    },
    {
      "owner": "DECODE",
      "name": "Decoder::finish",
      "signature": "fn finish(self, control: &mut dyn WorkControl) -> Result<SceneGraph>",
      "contract": "Only Complete state allowed; all indices/ranges/inverses/graph and pattern readiness checked; move arrays and Arc clone, no parsing or source copy."
    },
    {
      "owner": "DECODE",
      "name": "geometry",
      "signature": "fn geometry(element: ElementView<'_>, flavor: DecodeFlavor, style: &CssPaint<'_>, transform: Affine, builder: &mut SceneBuilder, scene: SceneId, control: &mut dyn WorkControl) -> Result<TableRange>",
      "contract": "Entire shape_geometry/path/custom API: primitives, poly lists, transformed tolerance, implicit fill closure, open stroke, source numbers/segments/subpaths. Reuse accepted path parser and G3 flatten/number cursor; custom glyph/image geometry passes owned edges/metadata into same style finalization transaction."
    },
    {
      "owner": "DECODE",
      "name": "style",
      "signature": "fn parse_style(source: &[u8], paint: &CssPaint<'_>, percentage_reference: f64, transform: Affine, viewport: Viewport, builder: &mut SceneBuilder, control: &mut dyn WorkControl) -> Result<ResolvedStyle>",
      "contract": "ResolvedStyle owns fill [u8;4], Stroke, fill/stroke server spans, clip/filter/mask/marker spans, opacity, visibility/display, blend/isolation; no borrowed CSS retained after decode. Preserve currentColor, dash compaction, alpha rounding, non-scaling stroke, join fallback, crisp edges and paint order."
    }
  ],
