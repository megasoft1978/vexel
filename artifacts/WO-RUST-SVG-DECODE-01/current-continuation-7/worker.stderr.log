+fn allocation_source(comment_padding: usize, uses: usize) -> String {
+    let mut source = String::from(
+        "<svg width='8' height='8'><defs><g id='target'><rect width='1' height='1'/></g></defs><!--",
+    );
+    source.push_str(&"p".repeat(comment_padding));
+    source.push_str("-->");
+    for _ in 0..uses {
