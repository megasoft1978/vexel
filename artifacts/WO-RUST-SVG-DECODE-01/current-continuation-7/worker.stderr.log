+        unreachable!()
+    };
+    assert_eq!(small.graph.root().shapes.len(), 1);
+    assert_eq!(padded_one.graph.root().shapes.len(), 1);
+    assert_eq!(padded_many.graph.root().shapes.len(), many_uses);
+
