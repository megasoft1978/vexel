+#[test]
+fn original_three_input_source_token_and_reference_accounting_deltas() {
+    let many_uses = 32usize;
+    let use_len = b"<use href='#target'/>".len();
+    let padding = 64 * 1024;
+    let padding_many = padding - (many_uses - 1) * use_len;
+    let inputs = [
+        allocation_source(0, 1),
