    17	/// Owned, top-left-origin, tightly packed RGBA8 pixels.
    18	///
    19	/// RGB channels are straight (unassociated) sRGB values and alpha is an
    20	/// independent linear coverage byte, matching Vexel UI pixels. Rows are
    21	/// stored from top to bottom with no padding, so row zero is the visual top.
    22	/// Presentation converts RGB to premultiplied sRGB bytes for CoreGraphics.
    23	/// The backing scale follows the window boundary's supported integral scales
    24	/// of `1`, `2`, or `3` pixels per point.
    25	#[derive(Debug, PartialEq)]
    26	pub struct RgbaFrame {
