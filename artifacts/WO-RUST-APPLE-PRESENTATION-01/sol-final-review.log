   146	            || !(1.0..=4096.0).contains(&size.width)
   147	            || !(1.0..=4096.0).contains(&size.height)
   148	        {
   149	            return Err(WindowError::InvalidConfig);
   150	        }
   151	        guard_native_call(|| {
   152	            h.window
   153	                .setContentSize(NSSize::new(size.width, size.height))
   154	        })
   155	        .map_err(WindowError::Native)
   156	    }
