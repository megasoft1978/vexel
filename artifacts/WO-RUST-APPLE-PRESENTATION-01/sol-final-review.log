   186	    pub fn set_text_input_state(&mut self, state: TextInputState) -> Result<(), WindowError> {
   187	        let h = self.handles()?;
   188	        if !validate_text_state(self.id, &state) {
   189	            return Err(WindowError::InvalidTextInputState);
   190	        }
   191	        if !h.route.publish(state, None) {
   192	            h.route.fault(QueueFaultReason::InputOverflow);
   193	            return Err(WindowError::QueueFault);
   194	        }
   195	        // Invalidating candidate coordinates can synchronously query the client.
   196	        guard_native_call(|| {
   197	            if let Some(context) = h.view.inputContext() {
   198	                context.invalidateCharacterCoordinates();
   199	            }
   200	        })
   201	        .map_err(WindowError::Native)
   202	    }
   203	    pub fn clear_text_input_state(&mut self) -> Result<(), WindowError> {
   204	        let h = self.handles()?;
   205	        h.route.text.borrow_mut().take();
   206	        h.route.no_target.set(true);
   207	        h.route.composition.borrow_mut().take();
   208	        h.route.queue.borrow_mut().set_external_payload(0);
   209	        guard_native_call(|| {
   210	            if let Some(context) = h.view.inputContext() {
   211	                context.discardMarkedText();
   212	                context.invalidateCharacterCoordinates();
   213	            }
   214	        })
