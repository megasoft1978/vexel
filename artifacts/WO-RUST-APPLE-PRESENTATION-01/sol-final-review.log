   217	    pub fn acknowledge_input_reset(&mut self, sequence: u64) -> Result<(), WindowError> {
   218	        let h = self.handles()?;
   219	        if h.route.queue.borrow_mut().acknowledge_reset(sequence) {
   220	            Ok(())
   221	        } else {
   222	            Err(WindowError::QueueFault)
   223	        }
   224	    }
   225	    pub fn request_ticks(&mut self, enabled: bool) -> Result<(), WindowError> {
   226	        let h = self.handles()?;
   227	        let owner = self.owner.upgrade().ok_or(WindowError::ExpiredOwner)?;
   228	        let previous = {
   229	            let mut state = owner.borrow_mut();
   230	            let r = slot_mut(&mut state, self.id)?.record.as_mut().unwrap();
   231	            if enabled
   232	                && r.timer
   233	                    .as_ref()
   234	                    .is_some_and(|t| t.1 == h.route.tick_generation.get())
   235	            {
   236	                return Ok(());
   237	            }
   238	            r.timer.take()
   239	        };
   240	        let generation = h.route.tick_generation.get().checked_add(1).unwrap_or(0);
   241	        h.route.tick_generation.set(generation);
   242	        if let Some(timer) = previous {
   243	            if let Err(fault) = super::ticks::cancel(&timer.0) {
   244	                let mut state = owner.borrow_mut();
   245	                if let Ok(slot) = slot_mut(&mut state, self.id) {
   246	                    slot.record.as_mut().unwrap().timer = Some(timer);
   247	                }
   248	                return Err(WindowError::Native(fault));
   249	            }
   250	        }
   251	        if !enabled {
   252	            return Ok(());
   253	        }
   254	        if generation == 0 {
   255	            return Err(WindowError::QueueFault);
   256	        }
   257	        let timer = match guard_native_call(|| {
   258	            let target = super::callbacks::TickTarget::new(h.mt, &h.route, generation);
   259	            super::ticks::install(&target)
   260	        })
   261	        .and_then(|r| r)
   262	        {
   263	            Ok(timer) => timer,
   264	            Err(fault) => {
   265	                h.route
   266	                    .tick_generation
   267	                    .set(generation.checked_add(1).unwrap_or(0));
   268	                return Err(WindowError::Native(fault));
   269	            }
   270	        };
   271	        // A timer installation may reenter; validate owner and generation again.
   272	        let mut state = owner.borrow_mut();
   273	        match slot_mut(&mut state, self.id) {
   274	            Ok(slot) => slot.record.as_mut().unwrap().timer = Some((timer, generation)),
   275	            Err(error) => {
   276	                drop(state);
   277	                let _ = super::ticks::cancel(&timer);
   278	                return Err(error);
   279	            }
   280	        }
   281	        drop(state);
   282	        super::ticks::wake();
   283	        Ok(())
   284	    }
