   294	/// Copies the caller-owned byte slice into immutable CFData, then constructs a
   295	/// CGImage whose provider retains that CFData for the image's full lifetime.
   296	fn prepare_rgba_image(width: u32, height: u32, pixels: &[u8]) -> Option<objc2_core_foundation::CFRetained<CGImage>> {
   297	    // SAFETY: this extern static is Apple's process-lifetime sRGB color-space
   298	    // name constant; its pointer remains valid for the synchronous call.
   299	    let srgb_name = unsafe { objc2_core_graphics::kCGColorSpaceSRGB };
   300	    let byte_count = isize::try_from(pixels.len()).ok()?;
   301	    // SAFETY: `pixels` points to a live initialized slice for `byte_count`
   302	    // bytes. CFDataCreate copies the bytes synchronously; the pointer does not
   303	    // escape and the bounded frame length fits CFIndex.
   304	    let data = unsafe { CFData::new(None, pixels.as_ptr(), byte_count) }?;
   305	    let provider = CGDataProvider::with_cf_data(Some(&data))?;
   306	    let color_space = CGColorSpace::with_name(Some(srgb_name))?;
   307	    let bytes_per_row = usize::try_from(width).ok()?.checked_mul(4)?;
   308	    // SAFETY: dimensions and row size were validated by RgbaFrame; provider
   309	    // owns a CFData copy containing exactly height * bytes_per_row bytes. The
   310	    // decode table is null as required for no custom decode mapping.
   311	    unsafe {
   312	        CGImage::new(
   313	            width as usize,
   314	            height as usize,
   315	            8,
   316	            32,
   317	            bytes_per_row,
   318	            Some(&color_space),
   319	            CGBitmapInfo(CGImageAlphaInfo::PremultipliedLast.0),
   320	            Some(&provider),
   321	            std::ptr::null(),
   322	            true,
   323	            CGColorRenderingIntent::RenderingIntentDefault,
   324	        )
   325	    }
   326	}

