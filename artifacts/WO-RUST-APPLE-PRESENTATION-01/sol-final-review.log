    67	    /// Converts straight-alpha sRGB input to the premultiplied RGBA encoding
    68	    /// declared to CoreGraphics. Integer rounding is deterministic.
    69	    pub(crate) fn into_premultiplied_pixels(self) -> Vec<u8> {
    70	        let mut pixels = self.pixels;
    71	        for pixel in pixels.chunks_exact_mut(BYTES_PER_PIXEL) {
    72	            let alpha = u16::from(pixel[3]);
    73	            for channel in &mut pixel[..3] {
    74	                *channel = ((u16::from(*channel) * alpha + 127) / 255) as u8;
    75	            }
    76	        }
    77	        pixels
    78	    }
    79	}
    80	
    81	fn checked_byte_len(width: usize, height: usize) -> Result<usize, RgbaFrameError> {
    82	    let bytes = width
    83	        .checked_mul(height)
    84	        .and_then(|pixels| pixels.checked_mul(BYTES_PER_PIXEL))
    85	        .ok_or(RgbaFrameError::ArithmeticOverflow)?;
    86	    if bytes > MAX_FRAME_BYTES {
    87	        return Err(RgbaFrameError::DimensionTooLarge);
    88	    }
    89	    Ok(bytes)
    90	}
