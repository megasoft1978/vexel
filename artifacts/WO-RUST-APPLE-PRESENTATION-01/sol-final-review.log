    53	        if pixels.len() != expected {
    54	            return Err(RgbaFrameError::ByteCountMismatch);
    55	        }
    56	        if pixels.capacity() > MAX_FRAME_BYTES {
    57	            return Err(RgbaFrameError::CapacityTooLarge);
    58	        }
    59	        Ok(Self { width, height, backing_scale, pixels })
    60	    }
