   286	    /// a real layer to this retained NSView after handle validation; no pointer,
   287	    /// fake presenter or rendering promise is exposed by the public API.
   288	    #[allow(dead_code)]
   289	    pub(crate) fn surface_view(&self) -> Result<Retained<NSView>, WindowError> {
   290	        Ok(self.handles()?.view)
   291	    }
   292	}
