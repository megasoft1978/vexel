    33	impl RgbaFrame {
    34	    pub fn new(
    35	        width: u32,
    36	        height: u32,
    37	        backing_scale: f64,
    38	        pixels: Vec<u8>,
    39	    ) -> Result<Self, RgbaFrameError> {
    40	        if width == 0 || height == 0 {
    41	            return Err(RgbaFrameError::ZeroDimension);
    42	        }
    43	        if width > MAX_FRAME_AXIS || height > MAX_FRAME_AXIS {
    44	            return Err(RgbaFrameError::DimensionTooLarge);
    45	        }
    46	        if !backing_scale.is_finite()
    47	            || !(1.0..=3.0).contains(&backing_scale)
    48	            || backing_scale.fract() != 0.0
