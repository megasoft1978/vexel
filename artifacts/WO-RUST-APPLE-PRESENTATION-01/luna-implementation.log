                    .slots
                    .try_reserve(1)
                    .map_err(|_| WindowError::QueueFault)?;
                let additional = state.slots.len() + 1 - state.free.len();
                state
                    .free
                    .try_reserve(additional)
                    .map_err(|_| WindowError::QueueFault)?;
