+    /// Synchronously prepares and publishes one owned RGBA8 frame.
+    ///
+    /// All Objective-C/CoreGraphics interaction stays inside this platform
+    /// crate. Core Foundation copies the bytes before this call returns, and
+    /// the view's layer retains the resulting CGImage as its contents. A
+    /// rejected frame or failed image preparation leaves the published image
+    /// untouched; publication is one guarded CALayer contents assignment.
+    pub fn present_rgba(&mut self, frame: super::frame::RgbaFrame) -> Result<(), WindowError> {
+        let (width, height, scale) = (frame.width(), frame.height(), frame.backing_scale());
+        let pixels = frame.into_pixels();
+        let h = self.handles()?;
+        let layer = guard_native_call(|| h.view.layer())
+            .map_err(WindowError::Native)?
+            .ok_or(WindowError::PresentationUnavailable)?;
+        guard_native_call(|| layer.setContentsGravity(kCAGravityResize))
+            .map_err(WindowError::Native)?;
+        let image = guard_native_call(|| prepare_rgba_image(width, height, &pixels))
+            .map_err(WindowError::Native)?
+            .ok_or(WindowError::PresentationUnavailable)?;
+        // Scale is set before the atomic contents swap. Save it for rollback in
+        // case an exception is raised by the publication call.
+        let old_scale = guard_native_call(|| layer.contentsScale()).map_err(WindowError::Native)?;
+        guard_native_call(|| layer.setContentsScale(scale)).map_err(WindowError::Native)?;
+        let published = guard_native_call(|| {
+            // SAFETY: CGImage is the exact Core Graphics object type required
+            // by CALayer.contents. The CGImage is retained by `image` here;
+            // CALayer retains its contents synchronously before this returns.
+            let object: &objc2::runtime::AnyObject = unsafe {
+                &*(image.as_ref() as *const CGImage as *const objc2::runtime::AnyObject)
+            };
+            // SAFETY: the object above is a valid retained CGImage, which is
+            // one of the documented CALayer.contents payload types.
+            unsafe { layer.setContents(Some(object)); }
+        });
+        if let Err(fault) = published {
+            // Best-effort restoration is guarded as well. The old contents were
+            // never assigned away when the single setter raised an exception.
+            let _ = guard_native_call(|| layer.setContentsScale(old_scale));
+            return Err(WindowError::Native(fault));
+        }
+        Ok(())
+    }
