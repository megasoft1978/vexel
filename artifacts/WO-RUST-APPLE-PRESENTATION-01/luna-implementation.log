 use crate::{MainThread, guard_native_call};
 use objc2::rc::Retained;
 use objc2_app_kit::{NSView, NSVisualEffectView, NSWindow};
+use objc2_core_foundation::CFData;
+use objc2_core_graphics::{
+    CGBitmapInfo, CGColorSpace, CGDataProvider, CGImage, CGImageAlphaInfo,
+    CGColorRenderingIntent,
+};
 use objc2_foundation::{NSOperatingSystemVersion, NSProcessInfo, NSSize, NSString};
+use objc2_quartz_core::CALayer;
+use objc2_quartz_core::{kCAGravityResize};
 use std::cell::RefCell;
 use std::rc::{Rc, Weak};
 
@@ -61,6 +68,58 @@
         guard_native_call(|| h.window.setTitle(&NSString::from_str(&title)))
             .map_err(WindowError::Native)
     }
+    /// Synchronously prepares and publishes one owned RGBA8 frame.
+    ///
+    /// All Objective-C/CoreGraphics interaction stays inside this platform
+    /// crate. Core Foundation copies the bytes before this call returns, and
+    /// the view's layer retains the resulting CGImage as its contents. A
+    /// rejected frame or failed image preparation leaves the published image
+    /// untouched; publication is one guarded CALayer contents assignment.
+    pub fn present_rgba(&mut self, frame: super::frame::RgbaFrame) -> Result<(), WindowError> {
+        let (width, height, scale) = (frame.width(), frame.height(), frame.backing_scale());
+        let pixels = frame.into_pixels();
+        let h = self.handles()?;
+        let layer = guard_native_call(|| h.view.layer())
+            .map_err(WindowError::Native)?
+            .ok_or(WindowError::PresentationUnavailable)?;
+        guard_native_call(|| layer.setContentsGravity(kCAGravityResize))
+            .map_err(WindowError::Native)?;
+        let image = guard_native_call(|| prepare_rgba_image(width, height, &pixels))
+            .map_err(WindowError::Native)?
+            .ok_or(WindowError::PresentationUnavailable)?;
+        // Keep a strong copy of the prior image and scale so even an exception
+        // after a partial native update can restore the last visible frame.
+        // SAFETY: CALayer.contents is nullable and, when non-null, returns a
+        // retained object handle owned by the returned `Retained` value.
+        let old_contents = guard_native_call(|| unsafe { layer.contents() })
+            .map_err(WindowError::Native)?;
+        let old_scale = guard_native_call(|| layer.contentsScale()).map_err(WindowError::Native)?;
+        if let Err(fault) = guard_native_call(|| layer.setContentsScale(scale)) {
+            let _ = guard_native_call(|| layer.setContentsScale(old_scale));
+            return Err(WindowError::Native(fault));
+        }
+        let published = guard_native_call(|| {
+            // SAFETY: CGImage is the exact Core Graphics object type required
+            // by CALayer.contents. The CGImage is retained by `image` here;
+            // CALayer retains its contents synchronously before this returns.
+            let object: &objc2::runtime::AnyObject = unsafe {
+                &*(image.as_ref() as *const CGImage as *const objc2::runtime::AnyObject)
+            };
+            // SAFETY: the object above is a valid retained CGImage, which is
+            // one of the documented CALayer.contents payload types.
+            unsafe { layer.setContents(Some(object)); }
+            layer.setNeedsDisplay();
+        });
+        if let Err(fault) = published {
+            // Restore both properties before returning. Retaining old_contents
+            // above keeps the previous CGImage alive across a failed swap.
+            let _ = guard_native_call(|| unsafe { layer.setContents(old_contents.as_deref()) });
+            let _ = guard_native_call(|| layer.setContentsScale(old_scale));
+            let _ = guard_native_call(|| layer.setNeedsDisplay());
+            return Err(WindowError::Native(fault));
+        }
+        Ok(())
+    }
     pub fn set_visible(&mut self, visible: bool) -> Result<(), WindowError> {
         let h = self.handles()?;
         guard_native_call(|| {
@@ -227,3 +286,35 @@
         Ok(self.handles()?.view)
     }
 }
+
+/// Copies the caller-owned byte slice into immutable CFData, then constructs a
+/// CGImage whose provider retains that CFData for the image's full lifetime.
+fn prepare_rgba_image(width: u32, height: u32, pixels: &[u8]) -> Option<objc2_core_foundation::CFRetained<CGImage>> {
+    use objc2_core_graphics::kCGColorSpaceSRGB;
+    let byte_count = isize::try_from(pixels.len()).ok()?;
+    // SAFETY: `pixels` points to a live initialized slice for `byte_count`
+    // bytes. CFDataCreate copies the bytes synchronously; the pointer does not
+    // escape and the bounded frame length fits CFIndex.
+    let data = unsafe { CFData::new(None, pixels.as_ptr(), byte_count) }?;
+    let provider = CGDataProvider::with_cf_data(Some(&data))?;
+    let color_space = CGColorSpace::with_name(Some(kCGColorSpaceSRGB))?;
+    let bytes_per_row = usize::try_from(width).ok()?.checked_mul(4)?;
+    // SAFETY: dimensions and row size were validated by RgbaFrame; provider
+    // owns a CFData copy containing exactly height * bytes_per_row bytes. The
+    // decode table is null as required for no custom decode mapping.
+    unsafe {
+        CGImage::new(
+            width as usize,
+            height as usize,
+            8,
+            32,
+            bytes_per_row,
+            Some(&color_space),
+            CGBitmapInfo(CGImageAlphaInfo::PremultipliedLast.0),
+            Some(&provider),
+            std::ptr::null(),
+            true,
+            CGColorRenderingIntent::RenderingIntentDefault,
+        )
+    }
+}

