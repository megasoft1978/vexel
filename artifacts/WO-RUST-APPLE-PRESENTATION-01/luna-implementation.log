+/// Maximum frame dimension on either axis. This matches the native window
+/// sizing limit and caps a full RGBA frame at 64 MiB.
+pub const MAX_FRAME_AXIS: u32 = 4096;
+const BYTES_PER_PIXEL: usize = 4;
+const MAX_FRAME_BYTES: usize = MAX_FRAME_AXIS as usize * MAX_FRAME_AXIS as usize * BYTES_PER_PIXEL;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RgbaFrameError {
+    ZeroDimension,
+    DimensionTooLarge,
+    ArithmeticOverflow,
+    ByteCountMismatch,
+    InvalidScale,
+}
+
+/// Owned, top-left-origin, tightly packed RGBA8 pixels.
+///
+/// RGB channels use the sRGB transfer function in CoreGraphics' sRGB color
+/// space; alpha is premultiplied (each color channel is already multiplied by
+/// alpha). Rows are stored from top to bottom with no padding. The backing
+/// backing scale follows the window boundary's supported integral scales of
+/// `1`, `2`, or `3` pixels per point.
+#[derive(Debug, PartialEq)]
+pub struct RgbaFrame {
+    width: u32,
+    height: u32,
+    backing_scale: f64,
+    pixels: Vec<u8>,
+}
+
+impl RgbaFrame {
+    pub fn new(
+        width: u32,
+        height: u32,
+        backing_scale: f64,
+        pixels: Vec<u8>,
+    ) -> Result<Self, RgbaFrameError> {
+        if width == 0 || height == 0 {
+            return Err(RgbaFrameError::ZeroDimension);
+        }
+        if width > MAX_FRAME_AXIS || height > MAX_FRAME_AXIS {
+            return Err(RgbaFrameError::DimensionTooLarge);
+        }
+        if !backing_scale.is_finite()
+            || !(1.0..=3.0).contains(&backing_scale)
+            || backing_scale.fract() != 0.0
+        {
+            return Err(RgbaFrameError::InvalidScale);
+        }
+        let expected = checked_byte_len(width as usize, height as usize)?;
+        if pixels.len() != expected {
+            return Err(RgbaFrameError::ByteCountMismatch);
+        }
+        Ok(Self { width, height, backing_scale, pixels })
+    }
+
+    pub fn width(&self) -> u32 { self.width }
+    pub fn height(&self) -> u32 { self.height }
+    pub fn backing_scale(&self) -> f64 { self.backing_scale }
+    pub fn pixels(&self) -> &[u8] { &self.pixels }
+
+    pub(crate) fn into_pixels(self) -> Vec<u8> { self.pixels }
+}
+
+fn checked_byte_len(width: usize, height: usize) -> Result<usize, RgbaFrameError> {
+    let bytes = width
+        .checked_mul(height)
+        .and_then(|pixels| pixels.checked_mul(BYTES_PER_PIXEL))
+        .ok_or(RgbaFrameError::ArithmeticOverflow)?;
+    if bytes > MAX_FRAME_BYTES {
+        return Err(RgbaFrameError::DimensionTooLarge);
+    }
+    Ok(bytes)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rejects_zero_and_oversized_dimensions() {
+        assert_eq!(RgbaFrame::new(0, 1, 1.0, vec![]).unwrap_err(), RgbaFrameError::ZeroDimension);
+        assert_eq!(RgbaFrame::new(1, 0, 1.0, vec![]).unwrap_err(), RgbaFrameError::ZeroDimension);
+        assert_eq!(RgbaFrame::new(MAX_FRAME_AXIS + 1, 1, 1.0, vec![]).unwrap_err(), RgbaFrameError::DimensionTooLarge);
+    }
+
+    #[test]
+    fn checks_byte_arithmetic_and_exact_pixel_length() {
+        assert_eq!(checked_byte_len(usize::MAX, 2), Err(RgbaFrameError::ArithmeticOverflow));
+        assert_eq!(RgbaFrame::new(2, 2, 1.0, vec![0; 15]).unwrap_err(), RgbaFrameError::ByteCountMismatch);
+        assert_eq!(RgbaFrame::new(2, 2, 1.0, vec![0; 17]).unwrap_err(), RgbaFrameError::ByteCountMismatch);
+    }
+
+    #[test]
+    fn rejects_nonfinite_nonpositive_and_unbounded_scale() {
+        for scale in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY, 0.0, -1.0, 0.5, 2.5, 3.01] {
+            assert_eq!(RgbaFrame::new(1, 1, scale, vec![0; 4]).unwrap_err(), RgbaFrameError::InvalidScale);
+        }
+    }
+
+    #[test]
+    fn accepts_axis_boundary_and_minimum_scale() {
+        let frame = RgbaFrame::new(MAX_FRAME_AXIS, 1, 1.0, vec![0; MAX_FRAME_AXIS as usize * 4]).unwrap();
+        assert_eq!(frame.width(), MAX_FRAME_AXIS);
+        assert_eq!(frame.backing_scale(), 1.0);
+        let tall = RgbaFrame::new(1, MAX_FRAME_AXIS, 3.0, vec![0; MAX_FRAME_AXIS as usize * 4]).unwrap();
+        assert_eq!(tall.height(), MAX_FRAME_AXIS);
+    }
+}
