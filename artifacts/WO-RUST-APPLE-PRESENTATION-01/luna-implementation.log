+        CGImage::new(
+            width as usize,
+            height as usize,
+            8,
+            32,
+            bytes_per_row,
+            Some(&color_space),
+            CGBitmapInfo(CGImageAlphaInfo::PremultipliedLast.0),
+            Some(&provider),
+            std::ptr::null(),
+            true,
+            CGColorRenderingIntent::RenderingIntentDefault,
+        )
+    }
+}

