    pub const COMMAND: u32 = 2;
    pub const OPTION: u32 = 4;
    pub const CONTROL: u32 = 8;
    pub const fn from_native_bits(bits: u64) -> Self {
        let mut out = 0;
        if bits & (1 << 17) != 0 {
            out |= Self::SHIFT;
        }
        if bits & (1 << 20) != 0 {
            out |= Self::COMMAND;
        }
        if bits & (1 << 19) != 0 {
            out |= Self::OPTION;
        }
        if bits & (1 << 18) != 0 {
            out |= Self::CONTROL;
        }
        Self(out)
    }
}

