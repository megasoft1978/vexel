+#ifndef VEXEL_XML_TOKENIZER_H
+#define VEXEL_XML_TOKENIZER_H
+
+#include "base.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef enum svg_xml_token_kind {
+    SVG_XML_TOKEN_DECLARATION = 1,
+    SVG_XML_TOKEN_PROCESSING_INSTRUCTION,
+    SVG_XML_TOKEN_COMMENT,
+    SVG_XML_TOKEN_START_ELEMENT,
+    SVG_XML_TOKEN_END_ELEMENT,
+    SVG_XML_TOKEN_EMPTY_ELEMENT,
+    SVG_XML_TOKEN_ATTRIBUTE,
+    SVG_XML_TOKEN_TEXT,
+    SVG_XML_TOKEN_CDATA
+} svg_xml_token_kind;
+
+typedef enum svg_xml_error {
+    SVG_XML_ERROR_NONE = 0,
+    SVG_XML_ERROR_INVALID_ARGUMENT,
+    SVG_XML_ERROR_INPUT_LIMIT,
+    SVG_XML_ERROR_INVALID_UTF8,
+    SVG_XML_ERROR_INVALID_CHARACTER,
+    SVG_XML_ERROR_UNSUPPORTED_ENCODING,
+    SVG_XML_ERROR_INVALID_NAME,
+    SVG_XML_ERROR_MALFORMED_SYNTAX,
+    SVG_XML_ERROR_DUPLICATE_ATTRIBUTE,
+    SVG_XML_ERROR_MISMATCHED_TAG,
+    SVG_XML_ERROR_DEPTH_LIMIT,
+    SVG_XML_ERROR_NODE_LIMIT,
+    SVG_XML_ERROR_ATTRIBUTE_LIMIT,
+    SVG_XML_ERROR_TEXT_LIMIT,
+    SVG_XML_ERROR_OUTPUT_EXHAUSTED,
+    SVG_XML_ERROR_UNSUPPORTED_DTD,
+    SVG_XML_ERROR_MULTIPLE_ROOTS,
+    SVG_XML_ERROR_INCOMPLETE_DOCUMENT
+} svg_xml_error;
+
+typedef struct svg_xml_span {
+    size_t offset;
+    size_t length;
+} svg_xml_span;
+
+typedef struct svg_xml_token {
+    svg_xml_token_kind kind;
+    svg_xml_span source;
+    svg_xml_span name;
+    svg_xml_span value;
+    svg_xml_span prefix;
+    svg_xml_span local_name;
+    size_t depth;
+} svg_xml_token;
+
+typedef struct svg_xml_limits {
+    size_t input_bytes;
+    size_t nesting_depth;
+    size_t nodes;
+    size_t attributes_per_element;
+    size_t total_attributes;
+    size_t text_run_bytes;
+} svg_xml_limits;
+
+typedef struct svg_xml_options {
+    svg_xml_limits limits;
+} svg_xml_options;
+
+typedef struct svg_xml_diagnostic {
+    svg_xml_error category;
+    size_t offset;
+} svg_xml_diagnostic;
+
+typedef struct svg_xml_result {
+    size_t token_count;
+    size_t element_count;
+    size_t attribute_count;
+    size_t node_count;
+    svg_xml_diagnostic diagnostic;
+} svg_xml_result;
+
+svg_xml_options svg_xml_default_options(void);
+svg_xml_result svg_xml_tokenize(base_bytes input, svg_xml_options options,
+                                svg_xml_token *tokens, size_t token_capacity);
+const char *svg_xml_error_name(svg_xml_error error);
+
+#endif
diff --git a/tests/svg/xml/compare_expat.py b/tests/svg/xml/compare_expat.py
new file mode 100644
index 0000000..d41091c
--- /dev/null
+++ b/tests/svg/xml/compare_expat.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Test-only differential check for pinned corpus fixtures."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import xml.parsers.expat as expat
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--expect-expat", required=True)
+    parser.add_argument("--binary", default="build/mac-debug/bin/xml_tokenizer_cli")
+    parser.add_argument("--output", default="artifacts/WO-M2-02/expat-comparison.json")
+    args = parser.parse_args()
+    actual = expat.EXPAT_VERSION
+    if actual != args.expect_expat:
+        print(f"expected {args.expect_expat}, found {actual}", file=sys.stderr)
+        return 2
+    manifest = json.loads((ROOT / "bench/corpus/manifest.json").read_text())
+    records = []
+    for fixture in manifest["fixtures"]:
+        path = ROOT / fixture["path"]
+        data = path.read_bytes()
+        digest = hashlib.sha256(data).hexdigest()
+        if digest != fixture["sha256"]:
+            raise RuntimeError(f"fixture hash mismatch: {fixture['fixture_id']}")
+        elements, attributes = 0, 0
+        p = expat.ParserCreate()
+        def start(_name, attrs):
+            nonlocal elements, attributes
+            elements += 1
+            attributes += len(attrs)
+        p.StartElementHandler = start
+        try:
+            p.Parse(data, True)
+            expat_ok = True
+        except expat.ExpatError:
+            expat_ok = False
+        if not expat_ok:
+            raise RuntimeError(f"pinned corpus fixture is not well-formed XML: {fixture['fixture_id']}")
+        run = subprocess.run([str(ROOT / args.binary), str(path)], check=True, capture_output=True, text=True)
+        result = json.loads(run.stdout)
+        if not result["ok"] or result["elements"] != elements or result["attributes"] != attributes:
+            raise RuntimeError(f"acceptance/count mismatch for {fixture['fixture_id']}: {result}, Expat={(elements, attributes)}")
+        records.append({"fixture_id": fixture["fixture_id"], "sha256": digest,
+                        "expat_accepted": expat_ok, "tokenizer_accepted": result["ok"],
+                        "elements": elements, "attributes": attributes})
+    report = {"python": sys.version.split()[0], "expat": actual, "fixtures_checked": len(records),
+              "unsupported_dtd_cases": [], "results": records}
+    out = ROOT / args.output
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"compared {len(records)} pinned fixtures using Python {report['python']} / {actual}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
