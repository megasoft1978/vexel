{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wo_id",
    "verdict",
    "base_sha",
    "head_sha",
    "acceptance",
    "scope_findings",
    "risk_flags",
    "summary"
  ],
  "properties": {
    "wo_id": { "type": "string" },
    "verdict": { "enum": ["pass", "fail", "uncertain"] },
    "base_sha": { "type": "string" },
    "head_sha": { "type": "string" },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence", "detail"],
        "properties": {
          "id": { "type": "string" },
          "result": { "enum": ["pass", "fail", "not_testable"] },
          "evidence": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "scope_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "finding", "severity"],
        "properties": {
          "path": { "type": "string" },
          "finding": { "type": "string" },
          "severity": { "enum": ["info", "low", "high", "critical"] }
        }
      }
    },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "maxLength": 1600 }
  }
}
