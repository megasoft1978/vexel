    }
    pub(crate) fn finish_owned(self) -> RenderMemoryStats {
        let mut stats = self.stats();
        drop(self);
        stats.live_bytes = 0;
        stats.token_array_bytes = 0;
        stats.reference_index_bytes = 0;
        stats.clip_copy_bytes = 0;
        stats.output_bytes = 0;
        stats
    }
