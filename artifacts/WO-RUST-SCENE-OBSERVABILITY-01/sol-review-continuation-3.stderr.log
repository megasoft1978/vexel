   309	    /// A zero-copy replacement allocator used only by the owning job. The
   310	    /// active entry reserves requested bytes before Vec::try_reserve_exact;
   311	    /// exclusive ledger access also holds the remaining overlap budget in escrow
   312	    /// until the actual capacity has been checked and the lease finalized.
   313	    pub(crate) fn allocate<T>(
   314	        &mut self,
   315	        tag: AllocationTag,
   316	        capacity: usize,
   317	        control: &mut dyn WorkControl,
   318	    ) -> Result<(Vec<T>, AllocationLease)> {
   319	        control.checkpoint().map_err(crate::types::stopped)?;
   320	        let requested = match capacity.checked_mul(std::mem::size_of::<T>()) {
   321	            Some(requested) => requested,
   322	            None => {
   323	                self.stats.overflow = true;
   324	                return Err(arithmetic());
   325	            }
   326	        };
   327	        // Mint a zero lease first: registry growth is admitted before payload
   328	        // allocation, and retained even when payload allocation subsequently fails.
   329	        let lease = self.admit(tag, 0)?;
   330	        let result = (|| {
   331	            if requested > self.available() {
   332	                return Err(limit(LimitKind::ReservedBytes));
   333	            }
   334	            add(self.stats.total_allocated_bytes, requested)?;
   335	            self.stats
   336	                .allocation_count
   337	                .checked_add(usize::from(requested != 0))
   338	                .ok_or_else(arithmetic)?;
   339	            let tagged_reservation = add(self.per_tag[tag as usize], requested)?;
   340	            let live_reservation = add(self.stats.live_bytes, requested)?;
   341	            // The active registry entry is a real pre-allocation reservation.
   342	            // Failure releases it; only successful physical reserves enter history.
   343	            self.entries[lease.slot].bytes = requested;
   344	            self.per_tag[tag as usize] = tagged_reservation;
   345	            self.stats.live_bytes = live_reservation;
   346	            let mut values = Vec::new();
   347	            values.try_reserve_exact(capacity).map_err(|_| Diagnostic {
   348	                kind: ErrorKind::OutOfMemory,
   349	                offset: 0,
   350	            })?;
   351	            let actual = bytes(&values)?;
   352	            // Vec may report excess capacity. No values are transferred or
   353	            // published until actual capacity and history pass the SAME budget.
   354	            let history = add(self.stats.total_allocated_bytes, actual)?;
   355	            let payload_history = add(self.payload_history[tag as usize], actual)?;
   356	            let count = self
   357	                .stats
   358	                .allocation_count
   359	                .checked_add(usize::from(actual != 0))
   360	                .ok_or_else(arithmetic)?;
   361	            self.stats.total_allocated_bytes = history;
   362	            self.payload_history[tag as usize] = payload_history;
   363	            self.stats.allocation_count = count;
   364	            let escrow = add(requested, self.available())?;
   365	            if actual > escrow {
   366	                return Err(limit(LimitKind::ReservedBytes));
   367	            }
   368	            let tagged = add(self.per_tag[tag as usize] - requested, actual)?;
   369	            let live = add(self.stats.live_bytes - requested, actual)?;
   370	            self.entries[lease.slot].bytes = actual;
   371	            self.per_tag[tag as usize] = tagged;
   372	            self.stats.live_bytes = live;
   373	            self.stats.peak_live_bytes = self.stats.peak_live_bytes.max(live);
   374	            control.checkpoint().map_err(crate::types::stopped)?;
   375	            Ok(values)
   376	        })();
   377	        match result {
   378	            Ok(values) => Ok((values, lease)),
   379	            Err(e) => {
   380	                self.release(lease)?;
   381	                if e.kind == ErrorKind::Limit(LimitKind::Arithmetic) {
   382	                    self.stats.overflow = true;
   383	                }
   384	                Err(e)
   385	            }
   386	        }
   387	    }
