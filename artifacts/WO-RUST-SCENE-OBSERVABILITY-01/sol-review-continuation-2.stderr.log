   424	    #[test]
   425	    fn exhausted_history_count_and_lease_serial_never_allocate_or_change_live_storage() {
   426	        let source = std::sync::Arc::new(Vec::new());
   427	        let mut ledger = ChargeLedger::new(&source, 1 << 20, 64).unwrap();
   428	        let lease = ledger.admit(AllocationTag::Output, 0).unwrap();
   429	        ledger.release(lease).unwrap();
   430	        let live = ledger.stats.live_bytes;
   431	        ledger.stats.total_allocated_bytes = usize::MAX;
   432	        assert_eq!(
   433	            ledger
   434	                .allocate::<u8>(AllocationTag::Output, 1, &mut Run)
   435	                .unwrap_err()
   436	                .kind,
   437	            ErrorKind::Limit(LimitKind::Arithmetic)
   438	        );
   439	        assert_eq!(ledger.stats.live_bytes, live);
   440	        assert_eq!(ledger.stats.total_allocated_bytes, usize::MAX);
   441	        assert_eq!(ledger.stats().output_bytes, 0);
   442	        ledger.stats.total_allocated_bytes = 0;
   443	        ledger.stats.allocation_count = usize::MAX;
   444	        assert!(
   445	            ledger
   446	                .allocate::<u8>(AllocationTag::Output, 1, &mut Run)
   447	                .is_err()
   448	        );
   449	        assert_eq!(ledger.stats.live_bytes, live);
   450	        assert_eq!(ledger.stats.total_allocated_bytes, 0);
   451	        ledger.stats.allocation_count = 0;
   452	        ledger.next = u64::MAX;
   453	        assert!(
   454	            ledger
   455	                .allocate::<u8>(AllocationTag::Output, 1, &mut Run)
   456	                .is_err()
   457	        );
   458	        assert_eq!(ledger.stats.live_bytes, live);
   459	        assert!(ledger.entries.iter().all(|entry| !entry.active));
