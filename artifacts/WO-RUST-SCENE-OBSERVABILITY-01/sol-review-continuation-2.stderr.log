    81	#[test]
    82	fn payload_history_survives_release_reuse_and_buffer_replacement() {
    83	    let source = Arc::new(Vec::new());
    84	    let mut ledger = ChargeLedger::new(&source, 1 << 20, 16).unwrap();
    85	    let first = ledger.admit(AllocationTag::Output, 31).unwrap();
    86	    ledger.release(first).unwrap();
    87	    let again = ledger.admit(AllocationTag::Output, 9).unwrap();
    88	    assert_eq!(
    89	        ledger.allocation_history()[AllocationTag::Output as usize],
    90	        40
    91	    );
    92	    ledger.release(again).unwrap();
    93	    let mut buffer = ledger
    94	        .allocate_buffer::<u8>(AllocationTag::ReferenceIndex, 16, &mut Run)
    95	        .unwrap();
    96	    let before = ledger.allocation_history();
    97	    buffer
    98	        .replace_capacity(&mut ledger, AllocationTag::ReferenceIndex, 32, &mut Run)
    99	        .unwrap();
   100	    let after = ledger.allocation_history();
   101	    let replacement_capacity = buffer.capacity(&ledger).unwrap();
   102	    assert!(replacement_capacity >= 32);
   103	    assert_eq!(
   104	        after[AllocationTag::ReferenceIndex as usize]
   105	            - before[AllocationTag::ReferenceIndex as usize],
   106	        replacement_capacity * std::mem::size_of::<u8>()
   107	    );
   108	    buffer.release(&mut ledger).unwrap();
   109	    assert_eq!(ledger.allocation_history(), after);
   110	    assert!(ledger.stats().live_bytes >= ledger.stats().source_bytes);
   111	}
