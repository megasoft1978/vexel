   483	        let source = std::sync::Arc::new(Vec::new());
   484	        let mut ledger = ChargeLedger::new(&source, 1 << 20, 8).unwrap();
   485	        let old_capacity = ledger.entries.capacity();
   486	        let old_history = ledger.payload_history[AllocationTag::None as usize];
   487	        let lease = ledger.admit(AllocationTag::None, 7).unwrap();
   488	        let metadata_bytes =
   489	            (ledger.entries.capacity() - old_capacity) * std::mem::size_of::<Entry>();
   490	        assert_eq!(
