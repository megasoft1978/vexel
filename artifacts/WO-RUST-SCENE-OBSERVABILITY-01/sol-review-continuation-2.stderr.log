   176	        if self.free.is_none() {
   177	            count.checked_add(1).ok_or_else(arithmetic)?;
   178	            let metadata_headroom = usize::MAX
   179	                .checked_sub(self.stats.total_allocated_bytes)
   180	                .ok_or_else(arithmetic)?
   181	                .min(
   182	                    usize::MAX
   183	                        .checked_sub(if tag == AllocationTag::None {
   184	                            tagged
   185	                        } else {
   186	                            self.per_tag[0]
   187	                        })
   188	                        .ok_or_else(arithmetic)?,
   189	                )
   190	                .min(
   191	                    usize::MAX
   192	                        .checked_sub(if tag == AllocationTag::None {
   193	                            payload_history
   194	                        } else {
   195	                            self.payload_history[0]
   196	                        })
   197	                        .ok_or_else(arithmetic)?,
   198	                );
   199	            let (new, old) = reserve(
   200	                &mut self.entries,
   201	                1,
   202	                self.max_leases,
   203	                overlap.min(usize::MAX - history).min(metadata_headroom),
   204	            )?;
   205	            if new != 0 {
   206	                let current = add(total, new)?;
   207	                let new_history = add(history, new)?;
   208	                let new_count = count.checked_add(1).ok_or_else(arithmetic)?;
   209	                self.stats.peak_live_bytes = self.stats.peak_live_bytes.max(current);
   210	                self.stats.live_bytes = add(self.stats.live_bytes - old, new)?;
   211	                self.per_tag[0] = add(self.per_tag[0] - old, new)?;
   212	                self.payload_history[0] = add(self.payload_history[0], new)?;
   213	                self.stats.total_allocated_bytes = new_history - amount;
   214	                self.stats.allocation_count = new_count - usize::from(amount != 0);
   215	            }
   216	        }
   217	        // Recalculate after registry growth. Metadata is itself retained and charged.
   218	        let current = add(self.stats.live_bytes, amount)?;
   219	        if current > self.reserved_bytes {
   220	            return Err(limit(LimitKind::ReservedBytes));
   221	        }
   222	        let serial = self.next;
   223	        self.next = next;
   224	        let slot = if let Some(slot) = self.free {
   225	            self.free = self.entries[slot].next_free;
   226	            slot
   227	        } else {
   228	            self.entries.len()
   229	        };
   230	        let entry = Entry {
   231	            serial,
   232	            tag,
   233	            bytes: amount,
   234	            active: true,
   235	            next_free: None,
   236	        };
   237	        if slot == self.entries.len() {
   238	            self.entries.push(entry);
   239	        } else {
   240	            self.entries[slot] = entry;
   241	        }
   242	        self.per_tag[tag as usize] = if tag == AllocationTag::None {
   243	            add(self.per_tag[0], amount)?
   244	        } else {
   245	            tagged
   246	        };
   247	        self.stats.live_bytes = current;
   248	        self.stats.peak_live_bytes = self.stats.peak_live_bytes.max(current);
   249	        self.stats.total_allocated_bytes = add(self.stats.total_allocated_bytes, amount)?;
   250	        self.payload_history[tag as usize] = if tag == AllocationTag::None {
   251	            add(self.payload_history[0], amount)?
   252	        } else {
   253	            payload_history
   254	        };
   255	        self.stats.allocation_count = self
   256	            .stats
   257	            .allocation_count
   258	            .checked_add(usize::from(amount != 0))
   259	            .ok_or_else(arithmetic)?;
   260	        Ok(AllocationLease {
   261	            owner: self.owner,
   262	            slot,
   263	            serial,
   264	        })
   265	    }
   266	    pub fn release(&mut self, lease: AllocationLease) -> Result<()> {
   267	        if lease.owner != self.owner {
   268	            return Err(invalid(0));
   269	        }
   270	        let entry = self.entries.get_mut(lease.slot).ok_or_else(|| invalid(0))?;
   271	        if !entry.active || entry.serial != lease.serial {
   272	            return Err(invalid(0));
   273	        }
   274	        entry.active = false;
   275	        self.per_tag[entry.tag as usize] -= entry.bytes;
   276	        self.stats.live_bytes -= entry.bytes;
   277	        entry.next_free = self.free;
   278	        self.free = Some(lease.slot);
   279	        Ok(())
   280	    }
   281	}
