    30	#[test]
    31	fn source_reference_hits_and_misses_expose_real_probe_deltas() {
    32	    let bytes = Arc::new(b"<svg><g id=\"present\"/></svg>".to_vec());
    33	    let doc = LexicalDocument::parse(bytes.clone(), 1 << 20, &mut Run).unwrap();
    34	    let mut source = DecodeSource::new(&doc, &mut Run).unwrap();
    35	    let mut reference = vexel_svg_reference::ReferenceIndex::create(&bytes, doc.tokens()).unwrap();
    36	    let before = source.reference_lookup_probes();
    37	    let direct_before = reference.lookup_probes();
    38	    let hit = source
    39	        .find_reference(
    40	            XmlSpan {
    41	                offset: 12,
    42	                length: 7,
    43	            },
    44	            &mut Run,
    45	        )
    46	        .unwrap();
    47	    let after_hit = source.reference_lookup_probes();
    48	    let direct_hit = reference.find(XmlSpan {
    49	        offset: 12,
    50	        length: 7,
    51	    });
    52	    assert_eq!(hit.map(|id| id.0), direct_hit);
    53	    assert_eq!(
    54	        after_hit - before,
    55	        reference.lookup_probes() - direct_before
    56	    );
    57	    let before_miss = source.reference_lookup_probes();
    58	    let direct_before_miss = reference.lookup_probes();
    59	    let miss = source
    60	        .find_reference(
    61	            XmlSpan {
    62	                offset: 0,
    63	                length: 3,
    64	            },
    65	            &mut Run,
    66	        )
    67	        .unwrap();
    68	    assert!(miss.is_none());
    69	    let direct_miss = reference.find(XmlSpan {
    70	        offset: 0,
    71	        length: 3,
    72	    });
    73	    assert_eq!(miss.map(|id| id.0), direct_miss);
    74	    assert_eq!(
    75	        source.reference_lookup_probes() - before_miss,
    76	        reference.lookup_probes() - direct_before_miss
    77	    );
    78	    assert_eq!(source.source(), bytes.as_slice());
    79	}
