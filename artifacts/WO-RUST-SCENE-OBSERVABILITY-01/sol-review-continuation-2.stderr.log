   283	impl ChargeLedger {
   284	    pub(crate) fn check_lease(&self, lease: AllocationLease) -> Result<()> {
   285	        if lease.owner != self.owner
   286	            || !self
   287	                .entries
   288	                .get(lease.slot)
   289	                .is_some_and(|e| e.active && e.serial == lease.serial)
   290	        {
   291	            return Err(invalid(0));
   292	        }
   293	        Ok(())
   294	    }
   295	    pub(crate) fn identity(&self) -> u64 {
   296	        self.owner
   297	    }
   298	
   299	    /// A zero-copy replacement allocator used only by the owning job. The
   300	    /// active entry reserves requested bytes before Vec::try_reserve_exact;
   301	    /// exclusive ledger access also holds the remaining overlap budget in escrow
   302	    /// until the actual capacity has been checked and the lease finalized.
   303	    pub(crate) fn allocate<T>(
   304	        &mut self,
   305	        tag: AllocationTag,
   306	        capacity: usize,
   307	        control: &mut dyn WorkControl,
   308	    ) -> Result<(Vec<T>, AllocationLease)> {
   309	        control.checkpoint().map_err(crate::types::stopped)?;
   310	        let requested = match capacity.checked_mul(std::mem::size_of::<T>()) {
   311	            Some(requested) => requested,
   312	            None => {
   313	                self.stats.overflow = true;
   314	                return Err(arithmetic());
   315	            }
   316	        };
   317	        // Mint a zero lease first: registry growth is admitted before payload
   318	        // allocation, and retained even when payload allocation subsequently fails.
   319	        let lease = self.admit(tag, 0)?;
   320	        let result = (|| {
   321	            if requested > self.available() {
   322	                return Err(limit(LimitKind::ReservedBytes));
   323	            }
   324	            add(self.stats.total_allocated_bytes, requested)?;
   325	            self.stats
   326	                .allocation_count
   327	                .checked_add(usize::from(requested != 0))
   328	                .ok_or_else(arithmetic)?;
   329	            let tagged_reservation = add(self.per_tag[tag as usize], requested)?;
   330	            let live_reservation = add(self.stats.live_bytes, requested)?;
   331	            // The active registry entry is a real pre-allocation reservation.
   332	            // Failure releases it; only successful physical reserves enter history.
   333	            self.entries[lease.slot].bytes = requested;
   334	            self.per_tag[tag as usize] = tagged_reservation;
   335	            self.stats.live_bytes = live_reservation;
   336	            let mut values = Vec::new();
   337	            values.try_reserve_exact(capacity).map_err(|_| Diagnostic {
   338	                kind: ErrorKind::OutOfMemory,
   339	                offset: 0,
   340	            })?;
   341	            let actual = bytes(&values)?;
   342	            // Vec may report excess capacity. No values are transferred or
   343	            // published until actual capacity and history pass the SAME budget.
   344	            let history = add(self.stats.total_allocated_bytes, actual)?;
   345	            let payload_history = add(self.payload_history[tag as usize], actual)?;
   346	            let count = self
   347	                .stats
   348	                .allocation_count
   349	                .checked_add(usize::from(actual != 0))
   350	                .ok_or_else(arithmetic)?;
   351	            self.stats.total_allocated_bytes = history;
   352	            self.payload_history[tag as usize] = payload_history;
   353	            self.stats.allocation_count = count;
   354	            let escrow = add(requested, self.available())?;
   355	            if actual > escrow {
   356	                return Err(limit(LimitKind::ReservedBytes));
   357	            }
   358	            let tagged = add(self.per_tag[tag as usize] - requested, actual)?;
   359	            let live = add(self.stats.live_bytes - requested, actual)?;
   360	            self.entries[lease.slot].bytes = actual;
   361	            self.per_tag[tag as usize] = tagged;
   362	            self.stats.live_bytes = live;
   363	            self.stats.peak_live_bytes = self.stats.peak_live_bytes.max(live);
   364	            control.checkpoint().map_err(crate::types::stopped)?;
   365	            Ok(values)
   366	        })();
   367	        match result {
   368	            Ok(values) => Ok((values, lease)),
   369	            Err(e) => {
   370	                self.release(lease)?;
   371	                if e.kind == ErrorKind::Limit(LimitKind::Arithmetic) {
   372	                    self.stats.overflow = true;
   373	                }
   374	                Err(e)
   375	            }
   376	        }
   377	    }
   378	    pub(crate) fn empty_lease(&mut self, lease: AllocationLease) -> Result<()> {
   379	        if lease.owner != self.owner {
   380	            return Err(invalid(0));
   381	        }
   382	        let entry = self.entries.get_mut(lease.slot).ok_or_else(|| invalid(0))?;
   383	        if !entry.active || entry.serial != lease.serial {
   384	            return Err(invalid(0));
   385	        }
   386	        self.stats.live_bytes -= entry.bytes;
   387	        self.per_tag[entry.tag as usize] -= entry.bytes;
   388	        entry.bytes = 0;
   389	        Ok(())
   390	    }
   391	}
   392	impl ChargeLedger {
   393	    pub(crate) fn require_no_leases(&self) -> Result<()> {
   394	        if self.entries.iter().any(|e| e.active) {
   395	            Err(invalid(0))
   396	        } else {
   397	            Ok(())
   398	        }
   399	    }
   400	    pub(crate) fn finish_owned(self) -> RenderMemoryStats {
   401	        let mut stats = self.stats();
   402	        drop(self);
   403	        stats.live_bytes = 0;
   404	        stats.token_array_bytes = 0;
   405	        stats.reference_index_bytes = 0;
   406	        stats.clip_copy_bytes = 0;
   407	        stats.output_bytes = 0;
   408	        stats
   409	    }
   410	}
