    pub fn release(&mut self, job: &mut ChargeLedger, lease: &TrackedAllocationLease) -> Result<()> {
        self.check_job(job)?;
        if !Arc::ptr_eq(&self.owner, &lease.owner) || lease.released.get() {
            return Err(invalid());
        }
        let active = self.active.checked_sub(1).ok_or_else(arithmetic)?;
        job.release(lease.lease)?;
        lease.released.set(true);
        self.active = active;
        Ok(())
    }
