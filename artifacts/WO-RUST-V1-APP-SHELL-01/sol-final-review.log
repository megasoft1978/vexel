   327	/// Copies the caller-owned byte slice into immutable CFData, then constructs a
   328	/// CGImage whose provider retains that CFData for the image's full lifetime.
   329	fn prepare_rgba_image(
   330	    width: u32,
   331	    height: u32,
   332	    pixels: &[u8],
   333	) -> Option<objc2_core_foundation::CFRetained<CGImage>> {
   334	    // SAFETY: this extern static is Apple's process-lifetime sRGB color-space
   335	    // name constant; its pointer remains valid for the synchronous call.
   336	    let srgb_name = unsafe { objc2_core_graphics::kCGColorSpaceSRGB };
   337	    let byte_count = isize::try_from(pixels.len()).ok()?;
   338	    // SAFETY: `pixels` points to a live initialized slice for `byte_count`
   339	    // bytes. CFDataCreate copies the bytes synchronously; the pointer does not
   340	    // escape and the bounded frame length fits CFIndex.
   341	    let data = unsafe { CFData::new(None, pixels.as_ptr(), byte_count) }?;
   342	    let provider = CGDataProvider::with_cf_data(Some(&data))?;
   343	    let color_space = CGColorSpace::with_name(Some(srgb_name))?;
   344	    let bytes_per_row = usize::try_from(width).ok()?.checked_mul(4)?;
   345	    // SAFETY: dimensions and row size were validated by RgbaFrame; provider
   346	    // owns a CFData copy containing exactly height * bytes_per_row bytes. The
   347	    // decode table is null as required for no custom decode mapping.
   348	    unsafe {
   349	        CGImage::new(
   350	            width as usize,
   351	            height as usize,
   352	            8,
   353	            32,
   354	            bytes_per_row,
   355	            Some(&color_space),
   356	            CGBitmapInfo(CGImageAlphaInfo::PremultipliedLast.0),
   357	            Some(&provider),
   358	            std::ptr::null(),
   359	            true,
   360	            CGColorRenderingIntent::RenderingIntentDefault,
   361	        )
   362	    }
   363	}

