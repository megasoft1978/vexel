//! Bounded borrowed widget canvas and custom raster painter.
use crate::{theme_tokens, type_scale, ControlState, IconCache, IconKind, Rect, Theme, Tokens};

pub const MAX_CANVAS_AXIS:u32=16_384;
pub const MAX_TEXT_BYTES:usize=1_048_576;
const FONT_PT:u32=13;
#[path="widget_geometry.rs"] mod geometry;
