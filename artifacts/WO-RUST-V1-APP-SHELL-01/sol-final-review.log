   505	fn wrap_lines(
   506	    text: &str,
   507	    max_width: f64,
   508	    font: *mut Font,
   509	    key: *const c_void,
   510	) -> Result<Vec<String>, TextError> {
   511	    let mut lines = Vec::new();
   512	    for paragraph in text.split('\n') {
   513	        let mut current = String::new();
   514	        for word in paragraph.split_whitespace() {
   515	            let candidate = if current.is_empty() {
   516	                word.to_owned()
   517	            } else {
   518	                format!("{current} {word}")
   519	            };
   520	            let line = create_line(&candidate, font, key)?;
   521	            let width = unsafe {
   522	                CTLineGetTypographicBounds(
   523	                    line.as_ptr(),
   524	                    ptr::null_mut(),
   525	                    ptr::null_mut(),
   526	                    ptr::null_mut(),
   527	                )
   528	            };
   529	            if !width.is_finite() || width < 0.0 {
   530	                return Err(TextError::NativeUnavailable);
   531	            }
   532	            if !current.is_empty() && width > max_width {
   533	                lines.push(std::mem::take(&mut current));
   534	                current.push_str(word);
   535	            } else {
   536	                current = candidate;
   537	            }
   538	        }
   539	        if !current.is_empty() {
   540	            lines.push(current);
   541	        }
   542	    }
   543	    Ok(lines)
   544	}
