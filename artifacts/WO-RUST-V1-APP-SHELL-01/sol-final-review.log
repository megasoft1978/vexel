   207	            0 => self.select_mode(Mode::Animate),
   208	            _ => false,
   209	        }
   210	    }
   211	    pub fn pointer(&mut self, layout: &Layout, point: (u32, u32)) -> bool {
   212	        match layout.hit_test(point) {
   213	            Some(Target::DrawMode) => self.select_mode(Mode::Draw),
   214	            Some(Target::AnimateMode) => self.select_mode(Mode::Animate),
   215	            Some(Target::Tool(_)) | None => false,
   216	        }
   217	    }
   218	}
