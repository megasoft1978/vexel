   415	fn copy_to_premultiplied(
   416	    source: &[u8],
   417	    stride: usize,
   418	    rect: (u32, u32, u32, u32),
   419	    row: usize,
   420	    out: &mut [u8],
   421	) {
   422	    let (x, y, _width, height) = rect;
   423	    for line in 0..height as usize {
   424	        let src = (y as usize + line) * stride + x as usize * 4;
   425	        let dst = line * row;
   426	        out[dst..dst + row].copy_from_slice(&source[src..src + row]);
   427	        for pixel in out[dst..dst + row].chunks_exact_mut(4) {
   428	            let alpha = u16::from(pixel[3]);
   429	            for channel in &mut pixel[..3] {
   430	                *channel = ((u16::from(*channel) * alpha + 127) / 255) as u8;
   431	            }
   432	        }
   433	    }
   434	}
   435	
   436	fn copy_from_premultiplied(
   437	    source: &mut [u8],
   438	    row: usize,
   439	    target: &mut [u8],
   440	    stride: usize,
   441	    rect: (u32, u32, u32, u32),
   442	) {
   443	    let (x, y, width, height) = rect;
   444	    let copy_len = width as usize * 4;
   445	    for line in 0..height as usize {
   446	        let src = line * row;
   447	        for pixel in source[src..src + copy_len].chunks_exact_mut(4) {
   448	            let alpha = u16::from(pixel[3]);
   449	            if alpha == 0 {
   450	                pixel[..3].fill(0);
   451	            } else {
   452	                for channel in &mut pixel[..3] {
   453	                    *channel = ((u16::from(*channel) * 255 + alpha / 2) / alpha).min(255) as u8;
   454	                }
   455	            }
   456	        }
   457	        let dst = (y as usize + line) * stride + x as usize * 4;
   458	        target[dst..dst + copy_len].copy_from_slice(&source[src..src + copy_len]);
   459	    }
   460	}
