   178	#[derive(Debug)]
   179	pub struct Model {
   180	    pub mode: Mode,
   181	    pub dark: bool,
   182	    pub dirty: bool,
   183	    pub status: &'static str,
   184	}
   185	impl Model {
   186	    pub fn new(dark: bool) -> Self {
   187	        Self {
   188	            mode: Mode::Draw,
   189	            dark,
   190	            dirty: true,
   191	            status: "No document open",
   192	        }
   193	    }
   194	    pub fn select_mode(&mut self, mode: Mode) -> bool {
   195	        if self.mode == mode {
   196	            return false;
   197	        }
   198	        self.mode = mode;
   199	        self.dirty = true;
   200	        true
   201	    }
   202	    pub fn key(&mut self, code: u16) -> bool {
   203	        match code {
   204	            2 => self.select_mode(Mode::Draw),
   205	            0 => self.select_mode(Mode::Animate),
   206	            _ => false,
   207	        }
   208	    }
   209	    pub fn pointer(&mut self, layout: &Layout, point: (u32, u32)) -> bool {
   210	        match layout.hit_test(point) {
   211	            Some(Target::DrawMode) => self.select_mode(Mode::Draw),
   212	            Some(Target::AnimateMode) => self.select_mode(Mode::Animate),
   213	            Some(Target::Tool(_)) | None => false,
   214	        }
   215	    }
   216	}
