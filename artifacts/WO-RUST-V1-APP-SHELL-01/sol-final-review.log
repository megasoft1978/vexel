   165	pub fn checked_pixel_geometry(points: (u32, u32), scale: u32) -> Option<(u32, u32)> {
   166	    if !(1..=3).contains(&scale) {
   167	        return None;
   168	    }
   169	    let width = points.0.checked_mul(scale)?;
   170	    let height = points.1.checked_mul(scale)?;
   171	    if width == 0 || height == 0 || width > 4096 || height > 4096 {
   172	        return None;
   173	    }
   174	    let bytes = (width as usize)
   175	        .checked_mul(height as usize)?
   176	        .checked_mul(4)?;
   177	    (bytes <= 64 * 1024 * 1024).then_some((width, height))
   178	}
