    22	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
    23	pub struct Layout {
    24	    pub width: u32,
    25	    pub height: u32,
    26	    pub top: Rect,
    27	    pub draw_mode: Rect,
    28	    pub animate_mode: Rect,
    29	    pub rail: Rect,
    30	    pub stage: Rect,
    31	    pub inspector: Option<Rect>,
    32	    pub timeline: Option<Rect>,
    33	    pub activity: Rect,
    34	    pub status: Rect,
    35	    pub tools: [Rect; 4],
    36	}
    37	impl Layout {
    38	    pub fn new(width: u32, height: u32, mode: Mode) -> Option<Self> {
    39	        if width < 440 || height < 300 || width > 4096 || height > 4096 {
    40	            return None;
    41	        }
    42	        let top_h = 48.min(height / 6);
    43	        let status_h = 28.min(height / 8);
    44	        let activity_h = 70.min(height / 5);
    45	        let content_y = top_h;
    46	        let content_h = height.saturating_sub(top_h + status_h + activity_h);
    47	        if content_h < 140 {
    48	            return None;
    49	        }
    50	        let rail_w = 54.min(width / 8);
    51	        let inspector = (width >= 900).then(|| {
    52	            let w = (width / 5).clamp(208, 252);
    53	            Rect {
    54	                x: width - w,
    55	                y: content_y,
    56	                width: w,
    57	                height: content_h,
    58	            }
    59	        });
    60	        let stage_x = rail_w;
    61	        let stage_right = inspector.map_or(width, |r| r.x);
    62	        let stage_w = stage_right.saturating_sub(stage_x);
    63	        if stage_w < 260 {
    64	            return None;
    65	        }
    66	        let timeline_h = if mode == Mode::Animate {
    67	            106.min(content_h / 3)
    68	        } else {
    69	            0
    70	        };
    71	        let stage = Rect {
    72	            x: stage_x,
    73	            y: content_y,
    74	            width: stage_w,
    75	            height: content_h - timeline_h,
    76	        };
    77	        let timeline = (timeline_h > 0).then_some(Rect {
    78	            x: stage_x,
    79	            y: content_y + content_h - timeline_h,
    80	            width: stage_w,
    81	            height: timeline_h,
    82	        });
    83	        let tool_h = 42;
    84	        let tools = std::array::from_fn(|i| Rect {
    85	            x: 5,
    86	            y: content_y + 8 + i as u32 * (tool_h + 5),
    87	            width: rail_w.saturating_sub(10),
    88	            height: tool_h,
    89	        });
    90	        let mode_w = 86;
    91	        let mode_y = 9;
    92	        let draw_mode = Rect {
    93	            x: width / 2 - mode_w,
    94	            y: mode_y,
    95	            width: mode_w,
    96	            height: 30,
    97	        };
    98	        let animate_mode = Rect {
    99	            x: width / 2,
   100	            y: mode_y,
   101	            width: mode_w,
   102	            height: 30,
   103	        };
   104	        Some(Self {
   105	            width,
   106	            height,
   107	            top: Rect {
   108	                x: 0,
   109	                y: 0,
   110	                width,
   111	                height: top_h,
   112	            },
   113	            draw_mode,
   114	            animate_mode,
   115	            rail: Rect {
   116	                x: 0,
   117	                y: content_y,
   118	                width: rail_w,
   119	                height: content_h,
   120	            },
   121	            stage,
   122	            inspector,
   123	            timeline,
   124	            activity: Rect {
   125	                x: 0,
   126	                y: height - status_h - activity_h,
   127	                width,
   128	                height: activity_h,
   129	            },
   130	            status: Rect {
   131	                x: 0,
   132	                y: height - status_h,
   133	                width,
   134	                height: status_h,
   135	            },
   136	            tools,
   137	        })
   138	    }
   139	    pub fn hit_test(&self, point: (u32, u32)) -> Option<Target> {
   140	        if contains(self.draw_mode, point) {
   141	            return Some(Target::DrawMode);
   142	        }
   143	        if contains(self.animate_mode, point) {
   144	            return Some(Target::AnimateMode);
   145	        }
   146	        for (index, rect) in self.tools.iter().enumerate() {
   147	            if contains(*rect, point) {
   148	                return Some(Target::Tool(
   149	                    [Tool::Select, Tool::Pen, Tool::Rectangle, Tool::Ellipse][index],
   150	                ));
   151	            }
   152	        }
   153	        None
   154	    }
   155	}
   156	fn contains(r: Rect, p: (u32, u32)) -> bool {
   157	    p.0 >= r.x
   158	        && p.1 >= r.y
   159	        && p.0 < r.x.saturating_add(r.width)
   160	        && p.1 < r.y.saturating_add(r.height)
   161	}
   162	
   163	pub fn checked_pixel_geometry(points: (u32, u32), scale: u32) -> Option<(u32, u32)> {
   164	    if !(1..=3).contains(&scale) {
   165	        return None;
   166	    }
   167	    let width = points.0.checked_mul(scale)?;
   168	    let height = points.1.checked_mul(scale)?;
   169	    if width == 0 || height == 0 || width > 4096 || height > 4096 {
   170	        return None;
   171	    }
   172	    let bytes = (width as usize)
   173	        .checked_mul(height as usize)?
   174	        .checked_mul(4)?;
   175	    (bytes <= 64 * 1024 * 1024).then_some((width, height))
   176	}
