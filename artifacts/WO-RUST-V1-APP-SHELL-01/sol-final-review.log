//! Bounded CoreText rasterization into caller-owned RGBA pixels.
//!
//! This module keeps CoreText/CoreGraphics pointers private. All native calls
//! use value-only Core Foundation/Core Graphics APIs and are contained here.
use std::ffi::c_void;
use std::ptr;

const MAX_AXIS: u32 = 4096;
const MAX_BYTES: usize = 64 * 1024 * 1024;
const MAX_TEXT_BYTES: usize = 8192;
const MAX_GLYPHS: usize = 4096;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TextFace {
    System,
    Monospaced,
}
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TextEmphasis {
    Regular,
    Semibold,
}
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TextError {
    InvalidBuffer,
    InvalidBounds,
    InvalidText,
    InvalidSize,
    NativeUnavailable,
}

#[repr(C)]
#[derive(Clone, Copy)]
struct Point {
    x: f64,
    y: f64,
}
#[repr(C)]
#[derive(Clone, Copy)]
struct NativeRect {
    origin: Point,
    size: NativeSize,
}
#[repr(C)]
#[derive(Clone, Copy)]
struct NativeSize {
    width: f64,
    height: f64,
}
#[repr(C)]
struct CfString {
    _private: [u8; 0],
}
#[repr(C)]
struct Font {
    _private: [u8; 0],
}
#[repr(C)]
struct ColorSpace {
    _private: [u8; 0],
}
#[repr(C)]
struct Context {
    _private: [u8; 0],
}

#[link(name = "CoreFoundation", kind = "framework")]
unsafe extern "C" {
    fn CFStringCreateWithBytes(
        allocator: *const c_void,
        bytes: *const u8,
        count: isize,
        encoding: u32,
        external: bool,
    ) -> *const CfString;
    fn CFRelease(value: *const c_void);
}
#[link(name = "CoreGraphics", kind = "framework")]
unsafe extern "C" {
    fn CGColorSpaceCreateDeviceRGB() -> *mut ColorSpace;
    fn CGColorSpaceRelease(space: *mut ColorSpace);
    fn CGBitmapContextCreate(
        data: *mut c_void,
        width: usize,
        height: usize,
        bits: usize,
        bytes_per_row: usize,
        space: *mut ColorSpace,
        bitmap_info: u32,
    ) -> *mut Context;
    fn CGContextRelease(context: *mut Context);
    fn CGContextSaveGState(context: *mut Context);
    fn CGContextRestoreGState(context: *mut Context);
    fn CGContextTranslateCTM(context: *mut Context, tx: f64, ty: f64);
    fn CGContextScaleCTM(context: *mut Context, sx: f64, sy: f64);
    fn CGContextClipToRect(context: *mut Context, rect: NativeRect);
    fn CGContextSetRGBFillColor(context: *mut Context, red: f64, green: f64, blue: f64, alpha: f64);
}
#[link(name = "CoreText", kind = "framework")]
unsafe extern "C" {
    fn CTFontCreateWithName(name: *const CfString, size: f64, matrix: *const c_void) -> *mut Font;
    fn CTFontCreateCopyWithSymbolicTraits(
        font: *mut Font,
        size: f64,
        matrix: *const c_void,
        traits: u32,
        mask: u32,
    ) -> *mut Font;
    fn CTFontGetGlyphsForCharacters(
        font: *mut Font,
        characters: *const u16,
        glyphs: *mut u16,
        count: isize,
    ) -> bool;
    fn CTFontGetAdvancesForGlyphs(
        font: *mut Font,
        orientation: u32,
        glyphs: *const u16,
        advances: *mut NativeSize,
        count: isize,
    ) -> f64;
    fn CTFontDrawGlyphs(
        font: *mut Font,
        glyphs: *const u16,
        positions: *const Point,
        count: isize,
        context: *mut Context,
    );
}

/// Draws clipped system or SF Mono text into a top-left-origin RGBA8 buffer.
/// Dimensions, stride, text length, and font size are bounded before native calls.
pub fn draw_text_rgba(
    rgba: &mut [u8],
    width: u32,
    height: u32,
    stride: usize,
    backing_scale: u32,
    text: &str,
    clip: (u32, u32, u32, u32),
    color: u32,
    face: TextFace,
    emphasis: TextEmphasis,
    size_pixels: u32,
) -> Result<(), TextError> {
    if width == 0
        || height == 0
        || width > MAX_AXIS
        || height > MAX_AXIS
        || !(1..=3).contains(&backing_scale)
    {
        return Err(TextError::InvalidBuffer);
    }
    let row = (width as usize)
        .checked_mul(4)
        .ok_or(TextError::InvalidBuffer)?;
    let bytes = stride
        .checked_mul(height as usize)
        .ok_or(TextError::InvalidBuffer)?;
    if stride < row || bytes > MAX_BYTES || rgba.len() != bytes {
        return Err(TextError::InvalidBuffer);
    }
    let (x, y, w, h) = clip;
    if w == 0
        || h == 0
        || x.checked_add(w).is_none_or(|v| v > width)
        || y.checked_add(h).is_none_or(|v| v > height)
    {
        return Err(TextError::InvalidBounds);
    }
    if text.len() > MAX_TEXT_BYTES || text.contains('\0') {
        return Err(TextError::InvalidText);
    }
    if !(1..=256).contains(&size_pixels) {
        return Err(TextError::InvalidSize);
    }
    if text.is_empty() {
        return Ok(());
    }
    let utf16: Vec<u16> = text.encode_utf16().take(MAX_GLYPHS + 1).collect();
    if utf16.is_empty() || utf16.len() > MAX_GLYPHS {
        return Err(TextError::InvalidText);
    }
    let mut glyphs = Vec::new();
    glyphs
        .try_reserve_exact(utf16.len())
        .map_err(|_| TextError::NativeUnavailable)?;
    glyphs.resize(utf16.len(), 0u16);
    let mut advances = Vec::new();
    advances
        .try_reserve_exact(utf16.len())
        .map_err(|_| TextError::NativeUnavailable)?;
    advances.resize(
        utf16.len(),
        NativeSize {
            width: 0.0,
            height: 0.0,
        },
    );
    let mut positions = Vec::new();
    positions
        .try_reserve_exact(utf16.len())
        .map_err(|_| TextError::NativeUnavailable)?;
    let clip_stride = (w as usize)
        .checked_mul(4)
        .ok_or(TextError::InvalidBounds)?;
    let clip_len = clip_stride
        .checked_mul(h as usize)
        .filter(|n| *n <= MAX_BYTES)
        .ok_or(TextError::InvalidBounds)?;
    let mut clipped = Vec::new();
    clipped
        .try_reserve_exact(clip_len)
        .map_err(|_| TextError::NativeUnavailable)?;
    clipped.resize(clip_len, 0);
    for row in 0..h as usize {
        let source = (y as usize + row) * stride + x as usize * 4;
        let target = row * clip_stride;
        clipped[target..target + clip_stride].copy_from_slice(&rgba[source..source + clip_stride]);
        for pixel in clipped[target..target + clip_stride].chunks_exact_mut(4) {
            let alpha = u16::from(pixel[3]);
            for channel in &mut pixel[..3] {
                *channel = ((u16::from(*channel) * alpha + 127) / 255) as u8;
            }
        }
    }
    let font_name = match face {
        TextFace::System => b".AppleSystemUIFont".as_slice(),
        TextFace::Monospaced => b"SFMono-Regular".as_slice(),
    };
    // UTF-8 encoding constant 0x08000100 is kCFStringEncodingUTF8.
    // SAFETY: font_name is a static valid UTF-8 byte slice with a bounded length.
    let name = unsafe {
        CFStringCreateWithBytes(
            ptr::null(),
            font_name.as_ptr(),
            font_name.len() as isize,
            0x0800_0100,
            false,
        )
    };
    if name.is_null() {
        return Err(TextError::NativeUnavailable);
    }
    // SAFETY: the CFString remains alive until after CTFontCreateWithName returns.
    let regular = unsafe { CTFontCreateWithName(name, size_pixels as f64, ptr::null()) };
    // SAFETY: name is a live CFString retained above.
    unsafe {
        CFRelease(name.cast());
    }
    if regular.is_null() {
        return Err(TextError::NativeUnavailable);
    }
    let font = if emphasis == TextEmphasis::Semibold {
        // kCTFontBoldTrait is bit zero; the result is a retained font or null.
        // SAFETY: regular is a live CTFont and null matrix requests the same font matrix.
        let bold = unsafe {
            CTFontCreateCopyWithSymbolicTraits(regular, size_pixels as f64, ptr::null(), 1, 1)
        };
        if !bold.is_null() {
            unsafe {
                CFRelease(regular.cast());
            }
            bold
        } else {
            regular
        }
    } else {
        regular
    };
    // SAFETY: source and destination are valid arrays with exactly `count` elements.
    let converted = unsafe {
        CTFontGetGlyphsForCharacters(
            font,
            utf16.as_ptr(),
            glyphs.as_mut_ptr(),
            utf16.len() as isize,
        )
    };
    if !converted {
        unsafe {
            CFRelease(font.cast());
        }
        return Err(TextError::NativeUnavailable);
    }
    // SAFETY: glyph and advance arrays are valid for the same bounded count.
    unsafe {
        CTFontGetAdvancesForGlyphs(
            font,
            0,
            glyphs.as_ptr(),
            advances.as_mut_ptr(),
            glyphs.len() as isize,
        );
    }
    let mut pen: f64 = 0.0;
    let baseline = (size_pixels as f64 * 0.2).max(1.0);
    for advance in &advances {
        if !advance.width.is_finite()
            || advance.width < 0.0
            || advance.width > MAX_AXIS as f64
            || !pen.is_finite()
            || pen > MAX_AXIS as f64
        {
            unsafe {
                CFRelease(font.cast());
            }
            return Err(TextError::NativeUnavailable);
        }
        positions.push(Point {
            x: pen,
            y: baseline,
        });
        pen += advance.width;
    }
    // SAFETY: creates an owned device RGB color space; released below.
    let space = unsafe { CGColorSpaceCreateDeviceRGB() };
    if space.is_null() {
        unsafe {
            CFRelease(font.cast());
        }
        return Err(TextError::NativeUnavailable);
    }
    // RGBA byte order + premultiplied alpha. Existing workbench pixels are opaque.
    // SAFETY: `clipped` is exclusively borrowed, length/stride were checked, and context does not escape.
    let context = unsafe {
        CGBitmapContextCreate(
            clipped.as_mut_ptr().cast(),
            w as usize,
            h as usize,
            8,
            clip_stride,
            space,
            0x4002,
        )
    };
    // SAFETY: owned values from CoreGraphics/CoreText are released once after use.
    unsafe {
        CGColorSpaceRelease(space);
    }
    if context.is_null() {
        unsafe {
            CFRelease(font.cast());
        }
        return Err(TextError::NativeUnavailable);
    }
    let (r, g, b, a) = (
        ((color >> 24) & 255) as f64 / 255.0,
        ((color >> 16) & 255) as f64 / 255.0,
        ((color >> 8) & 255) as f64 / 255.0,
        (color & 255) as f64 / 255.0,
    );
    // Flip the clipped context to top-left coordinates before drawing.
    // SAFETY: context and font are live; local clip dimensions are within checked bounds.
    unsafe {
        CGContextSaveGState(context);
        CGContextTranslateCTM(context, 0.0, h as f64);
        CGContextScaleCTM(context, 1.0, -1.0);
        CGContextClipToRect(
            context,
            NativeRect {
                origin: Point { x: 0.0, y: 0.0 },
                size: NativeSize {
                    width: w as f64,
                    height: h as f64,
                },
            },
        );
        CGContextSetRGBFillColor(context, r, g, b, a);
        CTFontDrawGlyphs(
            font,
            glyphs.as_ptr(),
            positions.as_ptr(),
            glyphs.len() as isize,
            context,
        );
        CGContextRestoreGState(context);
        CGContextRelease(context);
        CFRelease(font.cast());
    }
    for row in 0..h as usize {
        let target = (y as usize + row) * stride + x as usize * 4;
        let source = row * clip_stride;
        for pixel in clipped[source..source + clip_stride].chunks_exact_mut(4) {
            let alpha = u16::from(pixel[3]);
            if alpha == 0 {
                pixel[..3].fill(0);
            } else {
                for channel in &mut pixel[..3] {
                    *channel = ((u16::from(*channel) * 255 + alpha / 2) / alpha).min(255) as u8;
                }
            }
        }
        rgba[target..target + clip_stride].copy_from_slice(&clipped[source..source + clip_stride]);
    }
    Ok(())
}

