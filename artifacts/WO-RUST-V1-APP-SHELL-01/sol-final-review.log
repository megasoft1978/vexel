   258	    pub fn request_ticks(&mut self, enabled: bool) -> Result<(), WindowError> {
   259	        let h = self.handles()?;
   260	        let owner = self.owner.upgrade().ok_or(WindowError::ExpiredOwner)?;
   261	        let previous = {
   262	            let mut state = owner.borrow_mut();
   263	            let r = slot_mut(&mut state, self.id)?.record.as_mut().unwrap();
   264	            if enabled
   265	                && r.timer
   266	                    .as_ref()
   267	                    .is_some_and(|t| t.1 == h.route.tick_generation.get())
   268	            {
   269	                return Ok(());
   270	            }
   271	            r.timer.take()
   272	        };
   273	        let generation = h.route.tick_generation.get().checked_add(1).unwrap_or(0);
   274	        h.route.tick_generation.set(generation);
   275	        if let Some(timer) = previous {
   276	            if let Err(fault) = super::ticks::cancel(&timer.0) {
   277	                let mut state = owner.borrow_mut();
   278	                if let Ok(slot) = slot_mut(&mut state, self.id) {
   279	                    slot.record.as_mut().unwrap().timer = Some(timer);
   280	                }
   281	                return Err(WindowError::Native(fault));
   282	            }
   283	        }
   284	        if !enabled {
   285	            return Ok(());
   286	        }
   287	        if generation == 0 {
   288	            return Err(WindowError::QueueFault);
   289	        }
   290	        let timer = match guard_native_call(|| {
   291	            let target = super::callbacks::TickTarget::new(h.mt, &h.route, generation);
   292	            super::ticks::install(&target)
   293	        })
   294	        .and_then(|r| r)
   295	        {
   296	            Ok(timer) => timer,
   297	            Err(fault) => {
   298	                h.route
   299	                    .tick_generation
   300	                    .set(generation.checked_add(1).unwrap_or(0));
   301	                return Err(WindowError::Native(fault));
   302	            }
   303	        };
   304	        // A timer installation may reenter; validate owner and generation again.
   305	        let mut state = owner.borrow_mut();
   306	        match slot_mut(&mut state, self.id) {
   307	            Ok(slot) => slot.record.as_mut().unwrap().timer = Some((timer, generation)),
   308	            Err(error) => {
   309	                drop(state);
   310	                let _ = super::ticks::cancel(&timer);
   311	                return Err(error);
   312	            }
   313	        }
   314	        drop(state);
   315	        super::ticks::wake();
   316	        Ok(())
   317	    }
