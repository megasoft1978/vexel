/// Native text drawing hook. The closure receives borrowed UTF-8 and caller-owned pixels.
pub type TextDraw<'a>=dyn FnMut(&str,Rect,Theme,u32,u32,FontFamily,FontWeight,&mut[u8],u32,u32,usize)->bool+'a;
pub struct WidgetCanvas<'a>{pub rgba:&'a mut[u8],pub capacity:usize,pub stride:usize,pub width:u32,pub height:u32,pub backing_scale:u32,pub ui_scale:f64,pub text_scale_percent:u8,pub theme:Theme,pub increased_contrast:bool,pub tokens:Tokens,draw_text:Option<&'a mut TextDraw<'a>>,icons:IconCache,geometry:Option<GeometryPreflight>}
impl<'a> WidgetCanvas<'a>{
 pub fn new(rgba:&'a mut[u8],capacity:usize,width:u32,height:u32,stride:usize,backing_scale:u32,theme:Theme,increased_contrast:bool,draw_text:Option<&'a mut TextDraw<'a>>)->Option<Self>{Self::new_scaled(rgba,capacity,width,height,stride,backing_scale,1.0,theme,increased_contrast,draw_text)}
 pub fn new_scaled(rgba:&'a mut[u8],capacity:usize,width:u32,height:u32,stride:usize,backing_scale:u32,ui_scale:f64,theme:Theme,increased_contrast:bool,draw_text:Option<&'a mut TextDraw<'a>>)->Option<Self>{let row=(width as usize).checked_mul(4)?;let needed=(height as usize).checked_mul(stride)?;if width==0||height==0||width>MAX_CANVAS_AXIS||height>MAX_CANVAS_AXIS||backing_scale==0||backing_scale>3||!ui_scale.is_finite()||!(1.0..=2.0).contains(&ui_scale)||stride<row||capacity<needed||rgba.len()<capacity{return None}Some(Self{rgba,capacity,stride,width,height,backing_scale,ui_scale,text_scale_percent:100,theme,increased_contrast,tokens:theme_tokens(theme,increased_contrast),draw_text,icons:IconCache::default(),geometry:None})}
 pub fn set_text_scale(&mut self,scale:u8)->bool{if !(100..=200).contains(&scale)||scale%25!=0{return false}self.text_scale_percent=scale;true}
 pub fn paint_text(&mut self,text:&str,bounds:Rect,color:u32,family:FontFamily,weight:FontWeight,font_points:u32)->bool{if text.len()>MAX_TEXT_BYTES{return false}self.text(text,bounds,color,family,weight,font_points)}
 pub fn paint_icon(&mut self,icon:IconKind,bounds:Rect,state:ControlState)->bool{self.icon(icon,bounds,state,None)}
 pub fn paint_icon_color(&mut self,icon:IconKind,bounds:Rect,color:u32)->bool{self.icon(icon,bounds,ControlState::Rest,Some(color))}
 pub fn paint_state_foreground(&self,state:ControlState)->u32{self.state_fg(state)}
 pub fn paint_tree_row(&mut self,spec:&WidgetDrawSpec<'_>)->bool{let mut s=*spec;s.kind=WidgetKind::TreeRow;if !preflight(self,&s){return false}draw_tree_row(self,&s)}
 pub fn paint_empty_state(&mut self,spec:&WidgetDrawSpec<'_>)->bool{let mut s=*spec;s.kind=WidgetKind::EmptyState;if !preflight(self,&s){return false}draw_empty(self,&s)}
 fn valid(&self)->bool{self.width>0&&self.height>0&&self.width<=MAX_CANVAS_AXIS&&self.height<=MAX_CANVAS_AXIS&&self.backing_scale>0&&self.backing_scale<=3&&self.ui_scale.is_finite()&&(1.0..=2.0).contains(&self.ui_scale)&&(100..=200).contains(&self.text_scale_percent)&&self.text_scale_percent%25==0&&self.stride>=self.width as usize*4&&(self.height as usize).checked_mul(self.stride).is_some_and(|n|self.capacity>=n&&self.rgba.len()>=n)}
 fn scale(&self)->f64{self.backing_scale as f64*self.ui_scale}
 fn pixel_rect(&self,r:Rect)->Option<Rect>{if let Some(g)=&self.geometry{if !g.check(r,self.scale(),true){return None}}scaled_rect(r,self.scale())}
 fn pixel(&mut self,x:u32,y:u32,color:u32,cov:u8){if self.geometry.is_some(){return}if x>=self.width||y>=self.height{return}let at=y as usize*self.stride+x as usize*4;blend(&mut self.rgba[at..at+4],color,cov)}
 pub fn paint_rect(&mut self,r:Rect,color:u32){if !self.valid(){return}if let Some(g)=&self.geometry{g.check(r,self.scale(),r.width>0&&r.height>0);return}let Some(p)=self.pixel_rect(r)else{return};for y in p.y..p.y.saturating_add(p.height).min(self.height){for x in p.x..p.x.saturating_add(p.width).min(self.width){self.pixel(x,y,color,255)}}}
 pub fn paint_round(&mut self,r:Rect,radius:u32,fill:u32,edge:u32,edge_points:u32){if !self.valid(){return}if let Some(g)=&self.geometry{g.check(r,self.scale(),r.width>0&&r.height>0);return}let Some(p)=self.pixel_rect(r)else{return};let right=p.x.saturating_add(p.width).min(self.width);let bottom=p.y.saturating_add(p.height).min(self.height);let s=self.scale();let rad=(radius as f64*s).min(p.width as f64/2.0).min(p.height as f64/2.0);let inset=edge_points as f64*s;for y in p.y..bottom{for x in p.x..right{let(mut fc,mut ec)=(0u32,0u32);for sy in 0..4{for sx in 0..4{let xx=x as f64+(sx as f64+0.5)/4.0;let yy=y as f64+(sy as f64+0.5)/4.0;if rounded(xx,yy,p.x as f64,p.y as f64,(p.x+p.width)as f64,(p.y+p.height)as f64,rad){if edge_points>0&&inside_inner(xx,yy,p,inset,(rad-inset).max(0.0)){if fill!=0{fc+=1}}else if edge_points>0{ec+=1}else if fill!=0{fc+=1}}}}if fc>0{self.pixel(x,y,fill,((fc*255+8)/16)as u8)}if ec>0&&edge!=0{self.pixel(x,y,edge,((ec*255+8)/16)as u8)}}}}
 fn text(&mut self,text:&str,bounds:Rect,color:u32,family:FontFamily,weight:FontWeight,points:u32)->bool{if !self.valid(){return false}if let Some(g)=&self.geometry{let ok=g.check(bounds,self.scale(),!text.is_empty());let size=(points as f64*self.scale()*self.text_scale_percent as f64/100.0).ceil();if !text.is_empty()&&!(1.0..=256.0).contains(&size){g.reject();return false}return ok}if text.is_empty(){return true}let Some(bounds)=self.pixel_rect(bounds)else{return false};let size=((points as f64*self.scale()*self.text_scale_percent as f64/100.0).ceil()) as u32;if !(1..=256).contains(&size){return false}if let Some(cb)=self.draw_text.as_deref_mut(){cb(text,bounds,self.theme,size,color,family,weight,self.rgba,self.width,self.height,self.stride)}else{crate::scalar_text_draw(text,bounds,size,color,self.rgba,self.width,self.height,self.stride)}}
 fn icon(&mut self,icon:IconKind,bounds:Rect,state:ControlState,color:Option<u32>)->bool{if !self.valid(){return false}if let Some(g)=&self.geometry{return g.check(bounds,self.scale(),true)}let Some(p)=self.pixel_rect(bounds)else{return false};let scale=self.scale();let (icons,rgba)=(&mut self.icons,&mut *self.rgba);let result=if let Some(c)=color{icons.paint(icon,self.theme,scale,p,c,rgba,self.width,self.height,self.stride)}else{icons.paint_state(icon,self.theme,self.increased_contrast,scale,p,state,&self.tokens,rgba,self.width,self.height,self.stride)};result.is_ok()}
 fn state_fg(&self,s:ControlState)->u32{match s{ControlState::Disabled=>self.tokens.disabled_text,ControlState::Invalid=>self.tokens.error,_=>self.tokens.text_primary}}
 fn state_surface(&self,s:ControlState,normal:u32)->u32{match s{ControlState::Hover=>self.tokens.panel_hover,ControlState::Pressed=>self.tokens.pressed_fill,ControlState::Selected=>self.tokens.selection_fill,ControlState::Disabled=>self.tokens.panel_raised,_=>normal}}
}
fn rounded(x:f64,y:f64,l:f64,t:f64,r:f64,b:f64,rad:f64)->bool{if x<l||x>=r||y<t||y>=b{return false}let cx=if x<l+rad{l+rad}else if x>=r-rad{r-rad}else{x};let cy=if y<t+rad{t+rad}else if y>=b-rad{b-rad}else{y};(x-cx).powi(2)+(y-cy).powi(2)<=rad*rad}
fn inside_inner(x:f64,y:f64,p:Rect,i:f64,r:f64)->bool{let l=p.x as f64+i;let t=p.y as f64+i;let right=(p.x+p.width)as f64-i;let bottom=(p.y+p.height)as f64-i;right>l&&bottom>t&&rounded(x,y,l,t,right,bottom,r)}
fn blend(dst:&mut[u8],color:u32,cov:u8){let a=(((color&255)*cov as u32)+127)/255;let inv=255-a;let da=dst[3]as u32;let oa=a+(da*inv+127)/255;if oa==0{return}for(i,sh)in[24,16,8].into_iter().enumerate(){let src=(color>>sh)&255;let n=src*a*255+dst[i]as u32*da*inv;dst[i]=((n+oa*127)/(oa*255))as u8}dst[3]=oa as u8}

#[derive(Debug,Clone,Copy)] pub struct WidgetDrawSpec<'a>{pub kind:WidgetKind,pub state:ControlState,pub bounds:Rect,pub icon:IconKind,pub label:Option<&'a str>,pub value:Option<&'a str>,pub secondary:Option<&'a str>,pub unit:Option<&'a str>,pub numeric_value:f64,pub rgba:u32,pub font_size_pt:u8,pub font_family:FontFamily,pub font_weight:FontWeight,pub segment_index:u8,pub segment_count:u8,pub segment_labels:&'a[&'a str],pub indent:u8,pub selection_start:u16,pub selection_length:u16,pub cursor_byte_offset:u16,pub tone:crate::Tone,pub text_color:u32,pub checked:bool,pub expanded:bool,pub invalid:bool,pub placeholder:bool,pub focus_visible:bool,pub has_children:bool,pub visible:bool,pub locked:bool,pub show_row_actions:bool,pub has_transition:bool,pub transition_from:ControlState,pub transition_to:ControlState,pub transition_progress_permille:u16,pub transition_from_color:u32,pub transition_to_color:u32}
impl<'a> WidgetDrawSpec<'a>{pub fn new(kind:WidgetKind,bounds:Rect)->Self{Self{kind,state:ControlState::Rest,bounds,icon:IconKind::None,label:None,value:None,secondary:None,unit:None,numeric_value:0.0,rgba:0,font_size_pt:0,font_family:FontFamily::System,font_weight:FontWeight::Regular,segment_index:0,segment_count:0,segment_labels:&[],indent:0,selection_start:0,selection_length:0,cursor_byte_offset:0,tone:crate::Tone::Neutral,text_color:0,checked:false,expanded:false,invalid:false,placeholder:false,focus_visible:false,has_children:false,visible:true,locked:false,show_row_actions:false,has_transition:false,transition_from:ControlState::Rest,transition_to:ControlState::Rest,transition_progress_permille:0,transition_from_color:0,transition_to_color:0}}}

fn text(s:Option<&str>)->&str{s.unwrap_or("")}
fn inset(r:Rect,l:u32,t:u32,right:u32,b:u32)->Rect{if l.saturating_add(right)>=r.width||t.saturating_add(b)>=r.height{return Rect{x:r.x,y:r.y,width:0,height:0}}Rect{x:r.x+l,y:r.y+t,width:r.width-l-right,height:r.height-t-b}}
