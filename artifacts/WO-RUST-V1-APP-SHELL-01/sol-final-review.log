   360	fn validate(
   361	    width: u32,
   362	    height: u32,
   363	    stride: usize,
   364	    len: usize,
   365	    backing_scale: u32,
   366	    text: &str,
   367	    clip: (u32, u32, u32, u32),
   368	    size_pixels: u32,
   369	) -> Result<(), TextError> {
   370	    if width == 0
   371	        || height == 0
   372	        || width > MAX_AXIS
   373	        || height > MAX_AXIS
   374	        || !(1..=3).contains(&backing_scale)
   375	    {
   376	        return Err(TextError::InvalidBuffer);
   377	    }
   378	    let row = (width as usize)
   379	        .checked_mul(4)
   380	        .ok_or(TextError::InvalidBuffer)?;
   381	    let bytes = stride
   382	        .checked_mul(height as usize)
   383	        .ok_or(TextError::InvalidBuffer)?;
   384	    if stride < row || bytes > MAX_BYTES || len != bytes {
   385	        return Err(TextError::InvalidBuffer);
   386	    }
   387	    let (x, y, w, h) = clip;
   388	    if w == 0
   389	        || h == 0
   390	        || x.checked_add(w).is_none_or(|v| v > width)
   391	        || y.checked_add(h).is_none_or(|v| v > height)
   392	    {
   393	        return Err(TextError::InvalidBounds);
   394	    }
   395	    if text.len() > MAX_TEXT_BYTES
   396	        || text.contains('\0')
   397	        || text.encode_utf16().count() > MAX_GLYPHS
   398	    {
   399	        return Err(TextError::InvalidText);
   400	    }
   401	    if !(1..=256).contains(&size_pixels) {
   402	        return Err(TextError::InvalidSize);
   403	    }
   404	    Ok(())
   405	}
