     3	mod model;
     4	mod render;
     5	
     6	use model::{Layout, Mode, Model};
     7	use std::{num::NonZeroUsize, thread, time::Duration};
     8	use vexel_platform_apple::{MainThread, NativeApp, PointerKind, WindowConfig, WindowEvent};
     9	
    10	fn main() {
    11	    if let Err(message) = run() {
    12	        eprintln!("Vexel shell stopped: {message}");
    13	    }
    14	}
    15	fn run() -> Result<(), &'static str> {
    16	    let main_thread =
    17	        MainThread::acquire().map_err(|_| "launch must begin on the macOS main thread")?;
    18	    let mut app = NativeApp::start(main_thread).map_err(|_| "macOS application startup failed")?;
    19	    let config = WindowConfig {
    20	        title: "Vexel".to_owned(),
    21	        width_points: 1280,
    22	        height_points: 820,
    23	        resizable: true,
    24	        initially_hidden: false,
    25	    };
    26	    let mut window = app
    27	        .create_window(config)
    28	        .map_err(|_| "could not create the Vexel window")?;
    29	    let (mut logical, mut scale, mut geometry_valid, initial_status) =
    30	        match window.surface_metrics() {
    31	            Ok((points, pixels, scale)) => {
    32	                let logical = checked_points(points.width, points.height).unwrap_or((1280, 820));
    33	                let valid = model::checked_pixel_geometry(logical, scale as u32)
    34	                    == Some((pixels.width, pixels.height))
    35	                    && Layout::new(logical.0, logical.1, Mode::Draw).is_some();
    36	                (
    37	                    logical,
    38	                    scale,
    39	                    valid,
    40	                    if valid {
    41	                        "No document open"
    42	                    } else {
    43	                        "Initial window geometry is unsupported"
    44	                    },
    45	                )
    46	            }
    47	            Err(_) => (
    48	                (1280, 820),
    49	                1.0,
    50	                false,
    51	                "Initial window geometry is unsupported",
    52	            ),
    53	        };
    54	    let dark = window.is_dark_appearance().unwrap_or(true);
    55	    let mut model = Model::new(dark);
    56	    model.status = initial_status;
    57	    let mut dirty = true;
    58	    let event_budget = NonZeroUsize::new(128).ok_or("invalid event budget")?;
    59	    let mut closing = false;
    60	    while !closing {
    61	        if dirty || model.dirty {
    62	            let (draw_size, draw_scale) = if geometry_valid {
    63	                (logical, scale as u32)
    64	            } else {
    65	                safe_render_geometry(logical, scale)
    66	            };
    67	            match render::render(draw_size.0, draw_size.1, draw_scale, &model) {
    68	                Ok(frame) => window
    69	                    .present_rgba(frame)
    70	                    .map_err(|_| "native frame presentation failed")?,
    71	                Err(problem) => {
    72	                    eprintln!("Vexel redraw rejected safely: {problem}");
    73	                    model.status = "Redraw unavailable: unsupported window geometry";
    74	                }
    75	            }
    76	            dirty = false;
    77	            model.dirty = false;
    78	        }
    79	        let batch = app
    80	            .poll_events(window.id(), event_budget)
    81	            .map_err(|_| "native event polling failed")?;
    82	        for event in batch.events {
    83	            match event {
    84	                WindowEvent::Open | WindowEvent::Focus(_) => dirty = true,
    85	                WindowEvent::AppearanceChanged { dark } => {
    86	                    model.dark = dark;
    87	                    dirty = true;
    88	                }
    89	                WindowEvent::Resize { points, pixels } => {
    90	                    if let Some(next) = checked_points(points.width, points.height) {
    91	                        logical = next;
    92	                        dirty = true;
    93	                        geometry_valid = model::checked_pixel_geometry(logical, scale as u32)
    94	                            == Some((pixels.width, pixels.height))
    95	                            && Layout::new(logical.0, logical.1, model.mode).is_some();
    96	                        model.status = if geometry_valid {
    97	                            "No document open"
    98	                        } else {
    99	                            "Resize rejected: unsupported pixel geometry"
   100	                        };
   101	                    } else {
   102	                        geometry_valid = false;
   103	                        dirty = true;
   104	                        model.status = "Resize rejected: invalid point geometry";
   105	                    }
   106	                }
   107	                WindowEvent::BackingScaleChanged {
   108	                    scale: next_scale,
   109	                    pixels,
   110	                } => {
   111	                    if next_scale.is_finite()
   112	                        && (1.0..=3.0).contains(&next_scale)
   113	                        && next_scale.fract() == 0.0
   114	                        && model::checked_pixel_geometry(logical, next_scale as u32)
   115	                            == Some((pixels.width, pixels.height))
   116	                    {
   117	                        scale = next_scale;
   118	                        geometry_valid = Layout::new(logical.0, logical.1, model.mode).is_some();
   119	                        model.status = if geometry_valid {
   120	                            "No document open"
   121	                        } else {
   122	                            "Resize rejected: window is too small for the shell"
   123	                        };
   124	                        dirty = true;
   125	                    } else {
   126	                        geometry_valid = false;
   127	                        dirty = true;
   128	                        model.status = "Backing scale rejected: unsupported pixel geometry";
   129	                    }
   130	                }
   131	                WindowEvent::KeyDown { code, .. } => {
   132	                    if model.key(code) {
   133	                        dirty = true;
   134	                    }
   135	                }
   136	                WindowEvent::Pointer(pointer) if pointer.kind == PointerKind::Down => {
   137	                    if pointer.logical.0 >= 0 && pointer.logical.1 >= 0 {
   138	                        if let Some(layout) = Layout::new(logical.0, logical.1, model.mode) {
   139	                            if model.pointer(
   140	                                &layout,
   141	                                (pointer.logical.0 as u32, pointer.logical.1 as u32),
   142	                            ) {
   143	                                dirty = true;
   144	                            }
   145	                        }
   146	                    }
   147	                }
   148	                WindowEvent::CloseRequested => {
   149	                    closing = true;
   150	                    break;
   151	                }
   152	                WindowEvent::QueueFault(_) => return Err("native input queue reported a fault"),
   153	                _ => {}
   154	            }
   155	        }
   156	        if !batch.pending {
   157	            thread::sleep(Duration::from_millis(16));
   158	        }
   159	    }
   160	    app.destroy_window(window.id())
   161	        .map_err(|_| "native window shutdown failed")?;
   162	    app.shutdown()
