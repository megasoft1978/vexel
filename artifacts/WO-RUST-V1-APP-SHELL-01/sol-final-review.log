    let y = display.origin.y + cocoa_screen.origin.y + cocoa_screen.size.height
        - (content.origin.y + content.size.height);
    [x, y]
        .iter()
        .all(|v| v.is_finite() && v.abs() <= 1.0e9)
        .then_some(Point { x, y })
}

