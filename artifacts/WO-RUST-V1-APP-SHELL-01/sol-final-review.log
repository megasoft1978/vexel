use super::types::{Point, Size, SizeU32};

pub(crate) fn pixels(points: Size, scale: f64) -> Option<SizeU32> {
    if !points.width.is_finite()
        || !points.height.is_finite()
        || !scale.is_finite()
        || !(1.0..=3.0).contains(&scale)
        || scale.fract() != 0.0
        || points.width < 1.0
        || points.height < 1.0
    {
        return None;
    }
    let w = (points.width * scale).round();
    let h = (points.height * scale).round();
    if !w.is_finite()
        || !h.is_finite()
        || w < 1.0
        || h < 1.0
        || w > u32::MAX as f64
        || h > u32::MAX as f64
    {
        return None;
    }
    Some(SizeU32 {
        width: w as u32,
        height: h as u32,
    })
}
pub(crate) fn top_left(local_bottom_left: Point, height: f64) -> Option<Point> {
    let y = height - local_bottom_left.y;
    (local_bottom_left.x.is_finite()
        && local_bottom_left.y.is_finite()
        && height.is_finite()
        && y.is_finite())
    .then_some(Point {
        x: local_bottom_left.x,
        y,
    })
}
pub(crate) fn checked_screen_origin(
    display: Rect,
    cocoa_screen: Rect,
    content: Rect,
) -> Option<Point> {
    let x = display.origin.x + content.origin.x - cocoa_screen.origin.x;
    let y = display.origin.y + cocoa_screen.origin.y + cocoa_screen.size.height
        - (content.origin.y + content.size.height);
    [x, y]
        .iter()
        .all(|v| v.is_finite() && v.abs() <= 1.0e9)
        .then_some(Point { x, y })
}

use super::types::Rect;

use super::types::WindowError;
use objc2_app_kit::{
    NSAppearanceCustomization, NSAppearanceNameAqua, NSAppearanceNameDarkAqua, NSView, NSWindow,
};
use objc2_foundation::{NSArray, NSNumber, NSPoint, NSRect, NSSize, NSString};

pub(crate) fn ns_rect(rect: Rect) -> NSRect {
    NSRect::new(
        NSPoint::new(rect.origin.x, rect.origin.y),
        NSSize::new(rect.size.width, rect.size.height),
    )
}
pub(crate) fn rect(rect: NSRect) -> Rect {
    Rect {
        origin: Point {
            x: rect.origin.x,
            y: rect.origin.y,
        },
        size: Size {
            width: rect.size.width,
            height: rect.size.height,
        },
    }
}
pub(crate) fn scale(window: &NSWindow) -> Option<f64> {
    let b = window.convertRectToBacking(NSRect::new(NSPoint::new(0.0, 0.0), NSSize::new(1.0, 1.0)));
    (b.size.width == b.size.height
        && pixels(
            Size {
                width: 1.0,
                height: 1.0,
            },
            b.size.width,
        )
        .is_some())
    .then_some(b.size.width)
}
pub(crate) fn screen_origin(window: &NSWindow, view: &NSView) -> Result<Point, WindowError> {
    let screen = window.screen().ok_or(WindowError::InvalidConfig)?;
    let description = screen.deviceDescription();
    let key = NSString::from_str("NSScreenNumber");
    let number = description
        .objectForKey(&key)
        .ok_or(WindowError::InvalidConfig)?;
    let number = number
        .downcast::<NSNumber>()
        .map_err(|_| WindowError::InvalidConfig)?;
    let display = number.unsignedIntValue();
    if display == 0 {
        return Err(WindowError::InvalidConfig);
    }
    // Raw CoreGraphics call is not covered by objc2 catch-all; CGDisplayBounds
    // uses a value-only ABI and does not raise Objective-C exceptions.
    let quartz = objc2_core_graphics::CGDisplayBounds(display);
    if !quartz.size.width.is_finite()
        || !quartz.size.height.is_finite()
        || quartz.size.width <= 0.0
        || quartz.size.height <= 0.0
    {
        return Err(WindowError::InvalidConfig);
    }
    let content = window.convertRectToScreen(view.convertRect_toView(view.bounds(), None));
    display_origin(
        Some(Rect {
            origin: Point {
                x: quartz.origin.x,
                y: quartz.origin.y,
            },
            size: Size {
                width: quartz.size.width,
                height: quartz.size.height,
            },
        }),
        rect(screen.frame()),
        rect(content),
    )
    .ok_or(WindowError::InvalidConfig)
}
pub(crate) fn dark(window: &NSWindow) -> bool {
    // SAFETY: baseline AppKit process-lifetime NSString constants, available on macOS13.
    let names = unsafe { NSArray::from_slice(&[NSAppearanceNameAqua, NSAppearanceNameDarkAqua]) };
    window
        .effectiveAppearance()
        .bestMatchFromAppearancesWithNames(&names)
        .is_some_and(|name| unsafe { name.isEqualToString(NSAppearanceNameDarkAqua) })
}
pub(crate) fn candidate_to_screen(window: &NSWindow, view: &NSView, candidate: Rect) -> NSRect {
    let local = ns_rect(candidate_local(candidate, view.bounds().size.height));
    window.convertRectToScreen(view.convertRect_toView(local, None))
}
pub(crate) fn screen_to_content(window: &NSWindow, view: &NSView, point: NSPoint) -> Option<Point> {
    let local = view.convertPoint_fromView(window.convertPointFromScreen(point), None);
    top_left(
        Point {
            x: local.x,
            y: local.y,
        },
        view.bounds().size.height,
    )
    .filter(|p| p.x.abs() <= 1.0e6 && p.y.abs() <= 1.0e6)
}

pub(crate) fn display_origin(display: Option<Rect>, cocoa: Rect, content: Rect) -> Option<Point> {
    let display = display?;
    if !display.size.width.is_finite()
        || !display.size.height.is_finite()
        || display.size.width <= 0.0
        || display.size.height <= 0.0
    {
        return None;
    }
    checked_screen_origin(display, cocoa, content)
}

pub(crate) fn candidate_local(candidate: Rect, height: f64) -> Rect {
    Rect {
        origin: Point {
            x: candidate.origin.x,
            y: height - candidate.origin.y - candidate.size.height,
        },
        size: candidate.size,
    }
}
use super::{route::RouteState, types::*};
use objc2::msg_send;
use objc2_app_kit::{NSEvent, NSView};
pub(crate) fn modifiers(native_flags: u64) -> Modifiers {
    Modifiers::from_native_bits(native_flags)
}
pub(crate) fn finite_point(x: f64, y: f64) -> Option<Point> {
    (x.is_finite() && y.is_finite() && x.abs() <= 1.0e6 && y.abs() <= 1.0e6)
        .then_some(Point { x, y })
}
fn location(route: &RouteState, view: &NSView, event: &NSEvent) -> Option<(Point, f64, f64)> {
    let p = view.convertPoint_fromView(event.locationInWindow(), None);
    let point = super::geometry::top_left(Point { x: p.x, y: p.y }, view.bounds().size.height)?;
    let point = finite_point(point.x, point.y)?;
    let (window, _) = route.native()?;
    let scale = super::geometry::scale(&window)?;
    Some((point, scale, route.timestamp(event.timestamp())?))
}
pub(crate) fn key(route: &RouteState, event: &NSEvent, down: bool) {
    let Some(timestamp_seconds) = route.timestamp(event.timestamp()) else {
        return;
    };
    let code = event.keyCode();
    let modifiers = modifiers(event.modifierFlags().bits() as u64);
    route.emit(
        if down {
            WindowEvent::KeyDown {
                code,
                modifiers,
                timestamp_seconds,
            }
        } else {
            WindowEvent::KeyUp {
                code,
                modifiers,
                timestamp_seconds,
            }
        },
        false,
    );
}
pub(crate) fn pointer(route: &RouteState, view: &NSView, event: &NSEvent, kind: PointerKind) {
    let Some((at, scale, timestamp_seconds)) = location(route, view, event) else {
        route.fail(QueueFaultReason::InputOverflow);
        return;
    };
    let button = if kind == PointerKind::Move {
        None
    } else {
        let Ok(button) = u8::try_from(event.buttonNumber()) else {
            route.fail(QueueFaultReason::InputOverflow);
            return;
        };
        Some(button)
    };
    let click_count = event.clickCount().clamp(0, 255) as u8;
    route.emit(
        WindowEvent::Pointer(PointerEvent {
            kind,
            scale,
            at,
            logical: (
                at.x.round().clamp(i32::MIN as f64, i32::MAX as f64) as i32,
                at.y.round().clamp(i32::MIN as f64, i32::MAX as f64) as i32,
            ),
            button,
            click_count,
            modifiers: modifiers(event.modifierFlags().bits() as u64),
            timestamp_seconds,
        }),
        false,
    );
}
pub(crate) fn scroll(route: &RouteState, view: &NSView, event: &NSEvent) {
    let Some((at, scale, timestamp_seconds)) = location(route, view, event) else {
        route.fail(QueueFaultReason::InputOverflow);
        return;
    };
    // SAFETY: baseline NSEvent CGFloat getters have f64 ABI on Apple Silicon.
    let delta = unsafe {
        Point {
            x: msg_send![event, scrollingDeltaX],
            y: msg_send![event, scrollingDeltaY],
        }
    };
    if !delta.x.is_finite()
        || !delta.y.is_finite()
        || delta.x.abs() > 10000.0
        || delta.y.abs() > 10000.0
    {
        route.fail(QueueFaultReason::InputOverflow);
        return;
    }
    route.emit(
        WindowEvent::Scroll(ScrollEvent {
            logical: (at.x.round() as i32, at.y.round() as i32),
            at,
            delta,
            scale,
            modifiers: modifiers(event.modifierFlags().bits() as u64),
            timestamp_seconds,
        }),
        false,
    );
}
pub(crate) fn magnify(route: &RouteState, view: &NSView, event: &NSEvent) {
    let Some((at, scale, timestamp_seconds)) = location(route, view, event) else {
        route.fail(QueueFaultReason::InputOverflow);
        return;
    }; // SAFETY: baseline NSEvent magnification getter returns CGFloat=f64.
    let amount: f64 = unsafe { msg_send![event, magnification] };
    if !amount.is_finite() || amount.abs() > 100.0 {
        route.fail(QueueFaultReason::InputOverflow);
        return;
    }
    route.emit(
        WindowEvent::Magnify {
            logical: (at.x.round() as i32, at.y.round() as i32),
            at,
            amount,
            scale,
            modifiers: modifiers(event.modifierFlags().bits() as u64),
            timestamp_seconds,
        },
        false,
    );
}
//! Main-thread callback state. Native delegates retain only Weak<RouteState>.
use std::cell::{Cell, RefCell};
use std::rc::{Rc, Weak};

use super::{queue::EventQueue, types::*};
use crate::{NativeFault, guard_native_call};
use objc2::rc::{Retained, Weak as NativeWeak};
use objc2_app_kit::{NSView, NSWindow};

pub(crate) struct RouteState {
    pub id: WindowId,
    pub active: Cell<bool>,
    pub focused: Cell<bool>,
    pub queue: RefCell<EventQueue>,
    pub text: RefCell<Option<TextInputState>>,
    pub no_target: Cell<bool>,
    pub composition: RefCell<Option<Composition>>,
    pub native_fault: Cell<Option<NativeFault>>,
    native: RefCell<Option<(NativeWeak<NSWindow>, NativeWeak<NSView>)>>,
    pub tick_generation: Cell<u64>,
    last_timestamp: Cell<f64>,
}
impl RouteState {
    pub fn new(id: WindowId) -> Rc<Self> {
        Rc::new(Self {
            id,
            active: Cell::new(true),
            focused: Cell::new(false),
            queue: RefCell::new(EventQueue::default()),
            text: RefCell::new(None),
            no_target: Cell::new(false),
            composition: RefCell::new(None),
            native_fault: Cell::new(None),
            native: RefCell::new(None),
            tick_generation: Cell::new(0),
            last_timestamp: Cell::new(0.0),
        })
    }
    pub fn bind(&self, window: &Retained<NSWindow>, view: &Retained<NSView>) {
        let weak = (
            NativeWeak::from_retained(window),
            NativeWeak::from_retained(view),
        );
        *self.native.borrow_mut() = Some(weak);
    }
    pub fn native(&self) -> Option<(Retained<NSWindow>, Retained<NSView>)> {
        if !self.active.get() {
            return None;
        }
        // objc2's weak load/clone performs runtime retain bookkeeping, not a
        // message send. Retain/release exceptions are outside our unwind fence.
        let pair = self
            .native
            .borrow()
            .as_ref()
            .map(|(w, v)| (w.clone(), v.clone()))?;
        Some((pair.0.load()?, pair.1.load()?))
    }
    pub fn timestamp(&self, value: f64) -> Option<f64> {
        if !value.is_finite() || value < 0.0 || value > 1.0e12 {
            self.fail(QueueFaultReason::InputOverflow);
            return None;
        }
        let value = value.max(self.last_timestamp.get());
        self.last_timestamp.set(value);
        Some(value)
    }

    pub fn emit(&self, event: WindowEvent, control: bool) {
        if !self.active.get() {
            return;
        }
        // Enqueue failure is represented by fault/reset latches, or by a reset
        // already disabling ingress. The callback never discards an unreported loss.
        let accepted = self.queue.borrow_mut().push(event, control);
        if !accepted && self.queue.borrow().disabled() {
            self.text.borrow_mut().take();
            self.composition.borrow_mut().take();
            self.no_target.set(false);
            self.queue.borrow_mut().set_external_payload(0);
        }
        super::ticks::wake();
    }
    pub fn fault(&self, reason: QueueFaultReason) {
        if self.active.get() {
            self.queue.borrow_mut().fault(reason);
            super::ticks::wake();
        }
    }
    pub fn fail(&self, reason: QueueFaultReason) {
        if self.active.get() {
            self.queue.borrow_mut().fail(reason);
            self.text.borrow_mut().take();
            self.composition.borrow_mut().take();
            self.no_target.set(false);
            self.queue.borrow_mut().set_external_payload(0);
            super::ticks::wake();
        }
    }
    pub fn publish(&self, state: TextInputState, composition: Option<Composition>) -> bool {
        let bytes = state.text.len()
            + state.marked_attributes.len() * std::mem::size_of::<TextAttributeSpan>()
            + composition.as_ref().map_or(0, |c| {
                c.text.len() + c.attributes.len() * std::mem::size_of::<TextAttributeSpan>()
            });
        if !self.queue.borrow_mut().set_external_payload(bytes) {
            return false;
        }
        *self.text.borrow_mut() = Some(state);
        *self.composition.borrow_mut() = composition;
        self.no_target.set(false);
        true
    }
    pub fn snapshot(&self) -> Option<TextInputState> {
        if !self.active.get() || !self.focused.get() {
            return None;
        }
        let snapshot = self.text.borrow().clone();
        if snapshot.as_ref().is_none_or(|s| s.source_window != self.id) {
            if !self.no_target.get() {
                self.fault(QueueFaultReason::TextInputStateMissing);
            }
            None
        } else {
            snapshot
        }
    }
    pub fn invalidate(&self) {
        self.active.set(false);
        self.tick_generation
            .set(self.tick_generation.get().saturating_add(1));
        self.focused.set(false);
        self.text.borrow_mut().take();
        self.composition.borrow_mut().take();
        self.queue.borrow_mut().clear();
        self.native.borrow_mut().take();
    }
    pub fn callback<T>(&self, fallback: T, f: impl FnOnce() -> T) -> T {
        if !self.active.get() {
            return fallback;
        }
        match guard_native_call(f) {
            Ok(value) => value,
            Err(fault) => {
                self.native_fault.set(Some(fault));
                self.fail(QueueFaultReason::NativeCallbackFailure);
                fallback
            }
        }
    }
}
