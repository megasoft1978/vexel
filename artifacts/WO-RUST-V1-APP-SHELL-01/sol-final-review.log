   218	#[cfg(test)]
   219	mod tests {
   220	    use super::*;
   221	    #[test]
   222	    fn standard_workbench_keeps_stage_dominant_and_timeline_docked() {
   223	        let draw = Layout::new(1280, 820, Mode::Draw).unwrap();
   224	        assert!(draw.inspector.is_some());
   225	        assert!(draw.timeline.is_none());
   226	        assert!(draw.stage.width > 700 && draw.stage.height > 500);
   227	        let animate = Layout::new(1280, 820, Mode::Animate).unwrap();
   228	        assert!(animate.timeline.is_some());
   229	        assert!(animate.stage.width > 700);
   230	    }
   231	    #[test]
   232	    fn compact_bounds_hide_inspector_and_keep_stage_valid() {
   233	        let l = Layout::new(520, 420, Mode::Draw).unwrap();
   234	        assert!(l.inspector.is_none());
   235	        assert!(l.stage.width >= 400);
   236	        assert!(Layout::new(439, 420, Mode::Draw).is_none());
   237	        assert!(Layout::new(520, 299, Mode::Draw).is_none());
   238	    }
   239	    #[test]
   240	    fn mode_selection_works_by_keyboard_pointer_and_is_idempotent() {
   241	        let l = Layout::new(1280, 820, Mode::Draw).unwrap();
   242	        let mut model = Model::new(true);
   243	        assert!(model.key(0));
   244	        assert_eq!(model.mode, Mode::Animate);
   245	        model.dirty = false;
   246	        assert!(!model.key(0));
   247	        assert!(!model.dirty);
   248	        assert!(model.pointer(&l, (l.draw_mode.x + 2, l.draw_mode.y + 2)));
   249	        assert_eq!(model.mode, Mode::Draw);
   250	    }
   251	    #[test]
   252	    fn rejects_unsupported_backing_scales_and_oversized_frames() {
   253	        assert_eq!(checked_pixel_geometry((1280, 820), 2), Some((2560, 1640)));
   254	        assert_eq!(checked_pixel_geometry((4097, 1), 1), None);
   255	        assert_eq!(checked_pixel_geometry((1400, 820), 3), None);
   256	        assert_eq!(checked_pixel_geometry((4096, 4096), 1), Some((4096, 4096)));
   257	        assert_eq!(checked_pixel_geometry((100, 100), 2), Some((200, 200)));
   258	        assert_eq!(checked_pixel_geometry((100, 100), 4), None);
   259	    }
   260	    #[test]
   261	    fn pointer_hit_testing_is_deterministic_and_ignores_unavailable_actions() {
   262	        let l = Layout::new(1280, 820, Mode::Draw).unwrap();
   263	        assert_eq!(
   264	            l.hit_test((l.tools[2].x + 3, l.tools[2].y + 3)),
   265	            Some(Target::Tool(Tool::Rectangle))
   266	        );
   267	        let mut model = Model::new(true);
   268	        assert!(!model.pointer(&l, (l.tools[2].x + 3, l.tools[2].y + 3)));
   269	        assert_eq!(l.hit_test((0, 0)), None);
   270	        assert_eq!(l.hit_test((l.stage.x + 20, l.stage.y + 20)), None);
   271	        assert_eq!(
   272	            l.hit_test((l.animate_mode.x, l.animate_mode.y)),
   273	            Some(Target::AnimateMode)
   274	        );
   275	    }
   276	}
