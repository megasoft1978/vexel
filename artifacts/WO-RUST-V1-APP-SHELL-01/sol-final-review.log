     4	pub enum Mode {
     5	    Draw,
     6	    Animate,
     7	}
     8	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
     9	pub enum Tool {
    10	    Select,
    11	    Pen,
    12	    Rectangle,
    13	    Ellipse,
    14	}
    15	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
    16	pub enum Target {
