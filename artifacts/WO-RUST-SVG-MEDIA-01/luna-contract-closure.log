use vexel_base::Span;
use vexel_scene::{Diagnostic, ErrorKind, LimitKind, Result, TextRequest, TextState, TextStyle};
use vexel_svg_css::{CssPaint, Property};
use vexel_xml::{XmlSpan, XmlToken};

pub const MAX_TEXT_BYTES: usize = 64 * 1024;
pub const MAX_POSITION_VALUES: usize = 65_536;
pub const MAX_FAMILIES: usize = 32;
pub(crate) fn fail(kind: ErrorKind, offset: usize) -> Diagnostic {
    Diagnostic { kind, offset }
}
fn whitespace(b: u8) -> bool {
    matches!(b, b' ' | b'\t' | b'\r' | b'\n')
}

#[derive(Debug, Clone, PartialEq)]
pub struct TextStyleValues {
    pub families: Vec<Vec<u8>>,
    pub family_spans: Vec<Span>,
    pub size_points: f64,
    pub weight: f64,
    pub style: TextStyle,
    pub anchor: vexel_scene::TextAnchor,
    pub letter_spacing_points: f64,
    pub word_spacing: f64,
}
impl TextStyleValues {
    pub fn request<'a>(&'a self, text: &'a [u8], families: &'a [&'a [u8]]) -> TextRequest<'a> {
        TextRequest {
            text,
            font_families: families,
            size_points: self.size_points,
            weight: self.weight,
            style: self.style,
            letter_spacing_points: self.letter_spacing_points,
        }
    }
}

/// Decode entities then preserve or collapse XML whitespace with tspan state.
pub fn normalize_text(
    source: &[u8],
    raw: XmlSpan,
    preserve: bool,
    state: &mut TextState,
) -> Result<Vec<u8>> {
    normalize_text_kind(source, raw, preserve, state, true)
}

pub(crate) fn normalize_text_kind(
    source: &[u8], raw: XmlSpan, preserve: bool, state: &mut TextState, decode_entities: bool,
) -> Result<Vec<u8>> {
    let input = raw
        .slice(source)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, raw.offset))?;
    let mut decoded = Vec::new();
    decoded.try_reserve_exact(input.len())
        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    if decode_entities {
        decoded.resize(input.len(), 0);
        let length = vexel_xml::decode_attribute_value(source, raw, &mut decoded)
            .map_err(|offset| fail(ErrorKind::Unsupported, raw.offset.saturating_add(offset)))?;
        decoded.truncate(length);
    } else {
        decoded.extend_from_slice(input);
    }
    if preserve {
        if !decoded.is_empty() {
            state.has_position = true;
        }
        return Ok(decoded);
    }
    let mut result = Vec::new();
    let capacity = decoded.len().checked_add(1)
        .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), raw.offset))?;
    result
        .try_reserve_exact(capacity)
        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    for byte in decoded {
        if whitespace(byte) {
            if state.has_position || !result.is_empty() {
                state.pending_space = true;
            }
            continue;
        }
        if state.pending_space && (state.has_position || !result.is_empty()) {
            result.push(b' ');
        }
        state.pending_space = false;
        result.push(byte);
        state.has_position = true;
    }
    Ok(result)
}

/// Parse the x/y/dx/dy list grammar with percentages against the caller reference.
pub fn parse_position_list(source: &[u8], span: XmlSpan, reference: f64) -> Result<Vec<f64>> {
    let bytes = span
        .slice(source)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, span.offset))?;
    if bytes.is_empty() {
        return Err(fail(ErrorKind::Number, span.offset));
    }
    let mut values = Vec::new();
    values
        .try_reserve_exact(bytes.len().min(MAX_POSITION_VALUES))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    let mut i = 0;
    let mut need_value = true;
    while i < bytes.len() {
        while i < bytes.len() && whitespace(bytes[i]) {
            i += 1;
        }
        if i == bytes.len() {
            break;
        }
        if bytes[i] == b',' {
            if need_value {
                return Err(fail(ErrorKind::Number, span.offset + i));
            }
            need_value = true;
            i += 1;
            continue;
        }
        let start = i;
        while i < bytes.len() && bytes[i] != b',' && !whitespace(bytes[i]) {
            i += 1;
        }
        if values.len() == MAX_POSITION_VALUES {
            return Err(fail(
                ErrorKind::Number,
                span.offset + start,
            ));
        }
        let item = Span::from_offset_length(span.offset + start, i - start)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset + start))?;
        let value = vexel_svg_values::parse_length(source, item, reference)
            .map_err(|_| fail(ErrorKind::Number, item.start))?;
        values.push(value);
        need_value = false;
    }
    if values.is_empty() || need_value {
        return Err(fail(ErrorKind::Number, span.offset + span.length));
    }
    Ok(values)
}

/// Parse a comma-separated CSS family list, removing paired quotes as the C implementation does.
pub fn parse_families(source: &[u8], style: &CssPaint<'_>) -> Result<Vec<Vec<u8>>> {
    parse_families_with_spans(source, style).map(|(families, _)| families)
}

fn parse_families_with_spans(
    source: &[u8],
    style: &CssPaint<'_>,
) -> Result<(Vec<Vec<u8>>, Vec<Span>)> {
    let Some(value) = style.value(Property::FontFamily) else {
        return Ok((Vec::new(), Vec::new()));
    };
    let span = value.span;
    if span.slice(source) != Some(value.bytes) {
        return Err(fail(ErrorKind::Unsupported, span.offset));
    }
    let bytes = value.bytes;
    let mut i = 0;
    let mut families = Vec::new();
    let mut spans = Vec::new();
    families
        .try_reserve_exact(MAX_FAMILIES.min(bytes.len()))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    spans
        .try_reserve_exact(MAX_FAMILIES.min(bytes.len()))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    while i < bytes.len() {
        while i < bytes.len() && whitespace(bytes[i]) {
            i += 1;
        }
        if i == bytes.len() {
            break;
        }
        if families.len() == MAX_FAMILIES {
            return Err(fail(
                ErrorKind::Unsupported,
                span.offset + i,
            ));
        }
        let start;
        let end;
        if matches!(bytes[i], b'\'' | b'"') {
            let quote = bytes[i];
            i += 1;
            start = i;
            while i < bytes.len() && bytes[i] != quote {
                i += 1;
            }
            if i == bytes.len() {
                return Err(fail(ErrorKind::Unsupported, span.offset + start - 1));
            }
            end = i;
            i += 1;
        } else {
            start = i;
            while i < bytes.len() && bytes[i] != b',' {
                i += 1;
            }
            let mut trimmed = i;
            while trimmed > start && whitespace(bytes[trimmed - 1]) {
                trimmed -= 1;
            }
            end = trimmed;
        }
        if end == start {
            return Err(fail(ErrorKind::Unsupported, span.offset + start));
        }
        let mut family = Vec::new();
        family
            .try_reserve_exact(end - start)
            .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset + start))?;
        family.extend_from_slice(&bytes[start..end]);
        families.push(family);
        let absolute_start = span
            .offset
            .checked_add(start)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset))?;
        let absolute_end = span
            .offset
            .checked_add(end)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset))?;
        spans.push(Span {
            start: absolute_start,
            end: absolute_end,
        });
        while i < bytes.len() && bytes[i] != b',' {
            if !whitespace(bytes[i]) {
                return Err(fail(ErrorKind::Unsupported, span.offset + i));
            }
            i += 1;
        }
        if i < bytes.len() {
            i += 1;
            i += 1;
        }
    }
    if families.is_empty() {
        Err(fail(ErrorKind::Unsupported, span.offset))
    } else {
        Ok((families, spans))
    }
}

/// Apply the frozen CSS-to-CoreText style conversion and SVG defaults.
pub fn parse_text_style(
    source: &[u8],
    style: &CssPaint<'_>,
    viewport: [f64; 2],
) -> Result<TextStyleValues> {
    // Keep the original failure order and Unsupported classification. Position
    // attributes use Number errors; font style values do not.
    let size = parse_size(source, style, viewport[1])?;
    let weight = parse_weight(source, style)?;
    let (families, family_spans) = parse_families_with_spans(source, style)?;
    let letter_spacing = parse_spacing(source, style, Property::LetterSpacing, viewport[0])?;
    let word_spacing = parse_spacing(source, style, Property::WordSpacing, viewport[0])?;
    let text_style = if let Some(v) = style.value(Property::FontStyle) {
        if v.bytes.eq_ignore_ascii_case(b"normal") {
            TextStyle::Normal
        } else if v.bytes.eq_ignore_ascii_case(b"italic") {
            TextStyle::Italic
        } else if v.bytes.eq_ignore_ascii_case(b"oblique") {
            TextStyle::Oblique
        } else {
            return Err(fail(ErrorKind::Unsupported, v.span.offset));
        }
    } else {
        TextStyle::Normal
    };
    let anchor = if let Some(v) = style.value(Property::TextAnchor) {
        if v.bytes.eq_ignore_ascii_case(b"start") {
            vexel_scene::TextAnchor::Start
        } else if v.bytes.eq_ignore_ascii_case(b"middle") {
            vexel_scene::TextAnchor::Middle
        } else if v.bytes.eq_ignore_ascii_case(b"end") {
            vexel_scene::TextAnchor::End
        } else {
            return Err(fail(ErrorKind::Unsupported, v.span.offset));
        }
    } else {
        vexel_scene::TextAnchor::Start
    };
    Ok(TextStyleValues {
        families,
        family_spans,
        size_points: size * 0.75,
        weight,
        style: text_style,
        anchor,
        letter_spacing_points: letter_spacing * 0.75,
        word_spacing,
    })
}

pub fn parse_xml_space(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    parent_preserve: bool,
) -> Result<bool> {
    let token = tokens
        .get(element)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, 0))?;
    for attr in tokens
        .get(element + 1..end.min(tokens.len()))
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, token.name.offset))?
        .iter()
        .take_while(|t| t.kind == vexel_xml::TokenKind::Attribute)
    {
        if attr.local_name.slice(source) != Some(b"space")
            || attr.prefix.slice(source) != Some(b"xml")
        {
            continue;
        }
        return match attr.value.slice(source) {
            Some(v) if v.eq_ignore_ascii_case(b"preserve") => Ok(true),
            Some(v) if v.eq_ignore_ascii_case(b"default") => Ok(false),
            _ => Err(fail(ErrorKind::Unsupported, attr.value.offset)),
        };
    }
    Ok(parent_preserve)
}

/// Legacy helper name retained as a public pure operation for parity.
pub fn text_span_equal(source: &[u8], span: XmlSpan, literal: &[u8]) -> bool {
    span.slice(source) == Some(literal)
}

pub fn text_attribute(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    local: &[u8],
    prefix: Option<&[u8]>,
) -> Option<XmlSpan> {
    super::image::attribute(source, tokens, element, end, local, prefix)
}

pub fn parse_size(source: &[u8], style: &CssPaint<'_>, viewport_height: f64) -> Result<f64> {
    let Some(v) = style.value(Property::FontSize) else {
        return Ok(16.);
    };
    let value = vexel_svg_values::parse_length(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
        viewport_height,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
    if value <= 0. {
        return Err(fail(ErrorKind::Unsupported, v.span.offset));
    }
    Ok(value)
}

pub fn parse_weight(source: &[u8], style: &CssPaint<'_>) -> Result<f64> {
    let Some(v) = style.value(Property::FontWeight) else {
        return Ok(400.);
    };
    if v.bytes.eq_ignore_ascii_case(b"normal") {
        return Ok(400.);
    }
    if v.bytes.eq_ignore_ascii_case(b"bold") {
        return Ok(700.);
    }
    let n = vexel_svg_values::parse_number(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
    if !(100. ..=900.).contains(&n) || n % 100. != 0. {
        return Err(fail(ErrorKind::Unsupported, v.span.offset));
    }
    Ok(n)
}

pub fn parse_spacing(
    source: &[u8],
    style: &CssPaint<'_>,
    property: Property,
    reference: f64,
) -> Result<f64> {
    let Some(v) = style.value(property) else {
        return Ok(0.);
    };
    if v.bytes.eq_ignore_ascii_case(b"normal") {
        return Ok(0.);
    }
    vexel_svg_values::parse_length(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
        reference,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))
}
//! Required production boundary to the decoder's common custom-geometry pipeline.
//! No implementation is supplied here: native providers and the decoder's actual
//! paint/definition resolvers must be explicitly composed downstream.
use vexel_base::WorkControl;
use vexel_geometry::Affine;
use vexel_scene::{CssPaint, DraftToken, ElementView, Result, SceneBuilder, SceneId,
    ShapeAdmission, ShapeId, SourceMap};
use vexel_svg_css::Property;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MediaKind { Text, Image }

/// Canonical source/style and independent use-host annotation. Geometry is in
/// scene coordinates; `transform` is the actual canonical-to-scene transform,
/// while `source_map.transform` remains the host annotation, without substitution.
pub struct PublicationContext<'src, 'style> {
    pub element: ElementView<'src>,
    /// Effective authored boundary (TextDecodeRequest.end for text).
    pub end: usize,
    pub style: &'style CssPaint<'src>,
    pub source_map: SourceMap,
    pub transform: Affine,
    pub scene: SceneId,
    pub kind: MediaKind,
}

/// Transferred, fallibly allocated geometry. The publisher owns it on entry,
/// including on error. The optional image is already admitted in this request.
/// Text preserves all contour boundaries. No default paint/colors are provided.
pub struct CustomGeometry {
    pub path: vexel_svg_path::PathDocument,
    /// Real pregeometry slot; publish must consume with append_admitted_shape.
    pub admission: ShapeAdmission,
    pub source_map: SourceMap,
    pub image: Option<usize>,
}

/// Required adapter for the original traversal + shape_custom.c pipeline.
///
/// All methods are required. No neutral implementation or optional production
/// fallback exists. Callbacks may append/finalize ONLY the current request's
/// suffix using the supplied builder/draft. They must retain no owned resources,
/// admissions or mutable external state across calls; owned temporaries drop on
/// error. Resolver caches must be request-local or independently transactional.
/// Builder mutations are unconditionally rolled back by this crate on any
/// callback/provider/allocation/control/commit error. Errors propagate verbatim.
/// Callbacks must poll/charge all variable work and use fallible bounded storage.
///
/// `begin`: traversal opacity/filter/mask/blend/isolation validation/admission,
/// before font parsing/layout or image parsing/provider. Display has already
/// been checked. Hidden image skips its provider and prepare/publish after begin.
/// Text parses/layouts/admits/checks positions before visibility; successful runs
/// advance cursor even when hidden. Only nonzero outlines check visibility and
/// may invoke prepare/publish.
/// Hidden text skips geometry, not its provider or successful logical use.
/// Finish closes traversal effects for either media kind.
/// `prepare_geometry`: fill/currentColor + fill-rule validation only. The crate
/// then admits the shape before `prepare_admitted_geometry` performs fill-opacity
/// rounding, stroke/dashes/vector-effect/inverse validation, in C
/// order. Image: before media parsing/provider; text: after layout/positions and
/// before outlining, once per run with commands. No image gradient resolution.
/// `publish`: append the actual styled shape/colors retaining source_map; resolve
/// fill then stroke paint servers (pattern before gradient), then geometry-local
/// clip with actual bounds/inverse. Image keeps IMAGE paint and zero solid alpha.
/// Return its live shape handle; do not publish a neutral substitute on error.
/// `finish`: finalize opacity/filter/mask/blend/isolation and direct text
/// clipping over [first_shape, current shape count). This is the direct request
/// range; enclosing decoder traversal closes shared groups/clip only after
/// descendant tspans, retaining parent opacity semantics. Text custom clipping
/// must be deferred here, as original traversal removes clip-path per text run.
/// Original media does not attach markers. Other enclosing traversal effects
/// remain explicit decoder duties.
pub trait StylePublisher {
    fn begin(&self, context: &PublicationContext<'_, '_>, builder: &mut SceneBuilder,
        draft: &DraftToken, control: &mut dyn WorkControl) -> Result<()>;
    fn prepare_geometry(&self, context: &PublicationContext<'_, '_>, builder: &mut SceneBuilder,
        draft: &DraftToken, control: &mut dyn WorkControl) -> Result<()>;
    /// Fill-opacity/stroke validation after the crate reserves the shape slot.
    fn prepare_admitted_geometry(&self, context: &PublicationContext<'_, '_>,
        builder: &mut SceneBuilder, draft: &DraftToken,
        control: &mut dyn WorkControl) -> Result<()>;
    fn publish(&self, context: &PublicationContext<'_, '_>, geometry: CustomGeometry,
        builder: &mut SceneBuilder, draft: &DraftToken,
        control: &mut dyn WorkControl) -> Result<ShapeId>;
    fn finish(&self, context: &PublicationContext<'_, '_>, first_shape: usize,
        builder: &mut SceneBuilder, draft: &DraftToken, control: &mut dyn WorkControl) -> Result<()>;
}

pub(crate) fn display_none(context: &PublicationContext<'_, '_>) -> Result<bool> {
    if let Some(value) = context.style.value(Property::Display) {
        if value.bytes.eq_ignore_ascii_case(b"none") { return Ok(true); }
        if ![b"inline".as_slice(), b"block", b"contents"].iter()
            .any(|v| value.bytes.eq_ignore_ascii_case(v)) {
            return Err(super::text::fail(vexel_scene::ErrorKind::Unsupported, value.span.offset));
        }
    }
    Ok(false)
}

pub(crate) fn visibility_hidden(context: &PublicationContext<'_, '_>) -> bool {
    context.style.value(Property::Visibility).is_some_and(|value|
        value.bytes.eq_ignore_ascii_case(b"hidden") || value.bytes.eq_ignore_ascii_case(b"collapse"))
}

pub(crate) fn validate_visibility(context: &PublicationContext<'_, '_>) -> Result<()> {
    if let Some(value) = context.style.value(Property::Visibility) {
        if !value.bytes.eq_ignore_ascii_case(b"visible") {
            return Err(super::text::fail(vexel_scene::ErrorKind::Unsupported, value.span.offset));
        }
    }
    Ok(())
}

/// Production image route; None means display:none/hidden/collapse. Validates
/// real source/ledger/scene/host metadata before any callback or provider call.
pub fn publish_image_request(
    request: vexel_scene::ImageDecodeRequest<'_, '_>, publisher: &dyn StylePublisher,
    builder: &mut SceneBuilder, draft: &DraftToken, control: &mut dyn WorkControl,
) -> Result<Option<ShapeId>> {
    request.validate_source_map(builder, control)?;
    let context = PublicationContext { element: request.element, end: request.element.end, style: request.style,
        source_map: request.source_map, transform: request.transform,
        scene: request.scene, kind: MediaKind::Image };
    super::request::atomic_request(builder, draft, control, |builder, control, token| {
        if display_none(&context)? { return Ok(None); }
        let first = builder.scene(request.scene)?.shapes.len();
        publisher.begin(&context, builder, draft, control)?;
        if visibility_hidden(&context) {
            publisher.finish(&context, first, builder, draft, control)?;
            return Ok(None);
        }
        validate_visibility(&context)?;
        let admission = prepare_admission(publisher, &context, builder, draft, token, control)?;
        let viewport = builder.scene(request.scene)?.viewport;
        let plan = super::image_element(request.element,
            [viewport.view_width, viewport.view_height], request.provider, control)?;
        let id = super::image::append_image_plan_mapped(plan, request.source_map,
            request.scene, request.transform, builder, draft, control,
            Some((&context, publisher)), Some(admission))?;
        publisher.finish(&context, first, builder, draft, control)?;
        Ok(Some(id))
    })
}

/// Production text/tspan route. Same state/cache/document-budget rollback as
/// the compatibility helper, with required common-style callbacks per run.
pub fn publish_text_request(
    request: vexel_scene::TextDecodeRequest<'_, '_>, publisher: &dyn StylePublisher,
    builder: &mut SceneBuilder, draft: &DraftToken, control: &mut dyn WorkControl,
) -> Result<bool> {
    super::text_geometry::render_text_request_impl(request, builder, draft, control, Some(publisher))
}

/// Enforce live suffix publication and retained host/geometry ownership. A
/// delegate cannot return an earlier shape or report empty successful output.
pub(crate) fn publish_checked(
    publisher: &dyn StylePublisher, context: &PublicationContext<'_, '_>,
    geometry: CustomGeometry, builder: &mut SceneBuilder, draft: &DraftToken,
    control: &mut dyn WorkControl,
) -> Result<ShapeId> {
    let first = builder.scene(context.scene)?.shapes.len();
    let counts = (geometry.path.edges.len(), geometry.path.subpaths.len(), geometry.image);
    let id = publisher.publish(context, geometry, builder, draft, control)?;
    let scene = builder.scene(context.scene)?;
    let shape = scene.shape(id).ok_or_else(|| super::text::fail(
        vexel_scene::ErrorKind::InvalidArgument, context.source_map.element.start))?;
    if id.index() < first || shape.source != context.source_map
        || shape.edges.count != counts.0 || shape.subpaths.count != counts.1
        || shape.image != counts.2 {
        return Err(super::text::fail(vexel_scene::ErrorKind::InvalidArgument,
            context.source_map.element.start));
    }
    builder.finalize_shape(draft, id, *shape, control)?;
    Ok(id)
}

/// The crate owns the admission boundary, between fill-rule and opacity/stroke.
/// Text/image outlines are generated geometry, never canonical `<path d>` data.
pub(crate) fn prepare_admission(
    publisher: &dyn StylePublisher, context: &PublicationContext<'_, '_>,
    builder: &mut SceneBuilder, draft: &DraftToken, request: vexel_scene::RequestToken,
    control: &mut dyn WorkControl,
) -> Result<ShapeAdmission> {
    publisher.prepare_geometry(context, builder, draft, control)?;
    let admission = builder.admit_shape(draft, request,
        context.element.tokens()[context.element.element.0].name.offset, control)?;
    publisher.prepare_admitted_geometry(context, builder, draft, control)?;
    Ok(admission)
}
use super::text::{
    MAX_TEXT_BYTES, fail, parse_position_list, parse_text_style, parse_xml_space,
    text_attribute,
};
use vexel_base::WorkControl;
use vexel_scene::{Diagnostic, ErrorKind, LimitKind, Result, TextLayout, TextRequest, TextState};
use vexel_svg_css::CssPaint;
use vexel_xml::XmlToken;

/// Convert provider glyph outlines into the owned flattened path used by the
/// shared scene API. This follows the original 96/72 scale, baseline sign,
/// x/y overrides, accumulated dx/dy, anchor, and word-spacing rules.
pub fn text_geometry(
    layout: &TextLayout,
    text: &[u8],
    x: &[f64],
    y: &[f64],
    dx: &[f64],
    dy: &[f64],
    start: [f64; 2],
    anchor_offset: f64,
    word_spacing: f64,
    transform: vexel_geometry::Affine,
    control: &mut dyn WorkControl,
) -> Result<Vec<vexel_geometry::Edge>> {
    Ok(text_path_geometry(
        layout, text, x, y, dx, dy, start, anchor_offset, word_spacing, transform, control,
    )?
    .edges)
}

/// Preserve one closed subpath per provider contour, including contours closed
/// implicitly by a subsequent Move or the end of a glyph.
pub fn text_path_geometry(
    layout: &TextLayout,
    text: &[u8],
    x: &[f64],
    y: &[f64],
    dx: &[f64],
    dy: &[f64],
    start: [f64; 2],
    anchor_offset: f64,
    word_spacing: f64,
    transform: vexel_geometry::Affine,
    control: &mut dyn WorkControl,
) -> Result<vexel_svg_path::PathDocument> {
    let mut edges = Vec::new();
    let mut subpaths = Vec::new();
    let text = std::str::from_utf8(text)
        .map_err(|_| fail(ErrorKind::InvalidArgument, 0))?;
    let mut codepoints = text.chars();
    let mut extra_x = 0.;
    let mut extra_y = 0.;
    let mut word_offset = 0.;
    let scale = 96. / 72.;
    for (glyph_index, glyph) in layout.glyphs.iter().enumerate() {
        control.checkpoint().map_err(stopped)?;
        let x_override = glyph_index < x.len();
        let y_override = glyph_index < y.len();
        if x_override {
            extra_x = 0.;
        }
        if y_override {
            extra_y = 0.;
        }
        if glyph_index < dx.len() { extra_x += dx[glyph_index]; }
        if glyph_index < dy.len() { extra_y += dy[glyph_index]; }
        let gx = (if x_override {
            x[glyph_index]
        } else {
            start[0] + glyph.x * scale
        }) + extra_x
            + anchor_offset
            + word_offset;
        let gy = (if y_override {
            y[glyph_index]
        } else {
            start[1] - glyph.y * scale
        }) + extra_y;
        if codepoints.next().is_some_and(|scalar| scalar == ' ') {
            word_offset += word_spacing;
        }
        let range_end = glyph
            .commands
            .first
            .checked_add(glyph.commands.count)
            .filter(|&end| end <= layout.commands.len())
            .ok_or_else(|| fail(ErrorKind::Unsupported, 0))?;
        let mut current = vexel_geometry::Point { x: 0., y: 0. };
        let mut first = current;
        let mut open = false;
        let mut contour_first = edges.len();
        for command in &layout.commands[glyph.commands.first..range_end] {
            control
                .charge(vexel_base::WorkKind::Media, 1)
                .map_err(stopped)?;
            let point = |i: usize| vexel_geometry::Point {
                x: gx + command.values[i] * scale,
                y: gy - command.values[i + 1] * scale,
            };
            match command.verb {
                vexel_scene::TextVerb::Move => {
                    if open {
                        close_contour(current, first, contour_first, transform, &mut edges, &mut subpaths, control)?;
                    }
                    contour_first = edges.len();
                    current = point(0);
                    first = current;
                    open = true;
                }
                vexel_scene::TextVerb::Line => {
                    let next = point(0);
                    if !open {
                        contour_first = edges.len();
                        first = current;
                        open = true;
                    }
                    append_text_edge(current, next, transform, &mut edges, control)?;
                    current = next;
                }
                vexel_scene::TextVerb::Cubic => {
                    let c1 = point(0);
                    let c2 = point(2);
                    let next = point(4);
                    if !open {
                        contour_first = edges.len();
                        first = current;
                        open = true;
                    }
                    vexel_svg_path::flatten_cubic_controlled(
                        [current, c1, c2, next],
                        transform,
                        vexel_svg_path::ParseOptions::default(),
                        0,
                        &mut edges,
                        control,
                    )
                    .map_err(path_control_error)?;
                    current = next;
                }
                vexel_scene::TextVerb::Close => {
                    if open {
                        close_contour(current, first, contour_first, transform, &mut edges, &mut subpaths, control)?;
                    }
                    current = first;
                    open = false;
                }
            }
        }
        if open {
            close_contour(current, first, contour_first, transform, &mut edges, &mut subpaths, control)?;
        }
    }
    Ok(vexel_svg_path::PathDocument {
        edges,
        subpaths,
        segments: Vec::new(),
        numbers: Vec::new(),
    })
}

fn close_contour(
    current: vexel_geometry::Point,
    first: vexel_geometry::Point,
    first_edge: usize,
    transform: vexel_geometry::Affine,
    edges: &mut Vec<vexel_geometry::Edge>,
    subpaths: &mut Vec<vexel_svg_path::PathSubpath>,
    control: &mut dyn WorkControl,
) -> Result<()> {
    append_text_edge(current, first, transform, edges, control)?;
    subpaths.try_reserve(1).map_err(|_| fail(ErrorKind::OutOfMemory, 0))?;
    subpaths.push(vexel_svg_path::PathSubpath {
        first_edge,
        edge_count: edges.len() - first_edge,
        closed: true,
    });
    Ok(())
}

/// Geometry-only compatibility fixture helper. Production callers must use
/// `publish_text_request` with an explicit common-style publisher.
/// Decode direct text/CDATA children of a text or tspan element. Each authored
/// run creates one owned scene shape, with source identity fixed at append time.
/// A failed request or commit restores the scene suffix, document command
/// budget, external text state and newly admitted cache entries. Earlier scene
/// handles and cache layouts retain their identity.
pub fn render_text_request(
    request: vexel_scene::TextDecodeRequest<'_, '_>,
    builder: &mut vexel_scene::SceneBuilder,
    draft: &vexel_scene::DraftToken,
    control: &mut dyn WorkControl,
) -> Result<bool> {
    render_text_request_impl(request, builder, draft, control, None)
}

pub(crate) fn render_text_request_impl(
    request: vexel_scene::TextDecodeRequest<'_, '_>,
    builder: &mut vexel_scene::SceneBuilder,
    draft: &vexel_scene::DraftToken,
    control: &mut dyn WorkControl,
    publisher: Option<&dyn super::publication::StylePublisher>,
) -> Result<bool> {
    request.validate_source_map(builder, control)?;
    let context = super::publication::PublicationContext {
        element: request.element, end: request.end, style: request.style, source_map: request.source_map,
        transform: request.transform, scene: request.scene,
        kind: super::publication::MediaKind::Text,
    };
    let state_before = *request.state;
    let cache_before = (request.cache.entries.len(), request.cache.text_bytes, request.cache.commands);
    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
    super::request::atomic_request(builder, draft, control, |builder, control, token| {
        let first = builder.scene(request.scene)?.shapes.len();
        if let Some(publisher) = publisher {
            if super::publication::display_none(&context)? {
                return Ok(request.preserve_space);
            }
            publisher.begin(&context, builder, draft, control)?;
        }
        let preserve = render_text_element(
            request.element, request.end, request.scene, request.source_map,
            request.style, request.transform, &mut *request.state,
            request.preserve_space, request.provider, &mut *request.cache,
            builder, draft, token, control, publisher.map(|p| (&context, p)),
        )?;
        if let Some(publisher) = publisher {
            publisher.finish(&context, first, builder, draft, control)?;
        }
        Ok(preserve)
    })
    }));
    if !matches!(&outcome, Ok(Ok(_))) {
        *request.state = state_before;
        request.cache.entries.truncate(cache_before.0);
        request.cache.text_bytes = cache_before.1;
        request.cache.commands = cache_before.2;
    }
    match outcome {
        Ok(result) => result,
        Err(panic) => std::panic::resume_unwind(panic),
    }
}

