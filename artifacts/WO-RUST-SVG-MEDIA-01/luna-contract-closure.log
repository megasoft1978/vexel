            owner,
            source,
            generation,
            scenes: Vec::new(),
            animation: crate::decode_initialization::AnimationStorage::Parsed(animation),
            initialization: DecodeInitialization::Finalized,
            ignored: [Ignored::default(); 4],
            stats: MemoryStats {
                source_bytes: live,
                live_bytes: live,
                peak_live_bytes: live,
                total_allocated_bytes: 0,
                allocation_count: 0,
            },
            limits,
            drafts: [None; 64],
            draft_depth: 0,
            request: None,
            text_commands: 0,
            next_serial: 1,
            root,
        };
