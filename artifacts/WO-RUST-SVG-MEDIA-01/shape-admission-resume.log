        request: RequestToken,
        source_offset: usize,
        geometry: CanonicalPathSource<'_>,
        control: &mut dyn WorkControl,
    ) -> Result<ShapeAdmission> {
        if !geometry.belongs_to(self.source_owner()) {
            return Err(invalid(source_offset));
