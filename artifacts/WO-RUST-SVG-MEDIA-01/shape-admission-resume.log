pub(crate) fn edge(edges: &mut Vec<Edge>, transform: Affine, from: Point, to: Point, max_edges: usize, offset: usize)
    -> Result<(), ControlledError<Diagnostic>> {
    if edges.len() >= max_edges { return Err(ControlledError::Original(failure(DiagnosticKind::Limit, offset))); }
    let a = affine_map_point(transform, from).ok_or_else(|| ControlledError::Original(failure(DiagnosticKind::Number, offset)))?;
    let b = affine_map_point(transform, to).ok_or_else(|| ControlledError::Original(failure(DiagnosticKind::Number, offset)))?;
    crate::control::reserve(edges, 1, max_edges, offset)?;
    edges.push(Edge { a, b });
    Ok(())
}

