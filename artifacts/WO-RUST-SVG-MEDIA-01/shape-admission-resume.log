use vexel_base::Span;
use vexel_scene::{Diagnostic, ErrorKind, LimitKind, Result, TextRequest, TextState, TextStyle};
use vexel_svg_css::{CssPaint, Property};
use vexel_xml::{XmlSpan, XmlToken};

pub const MAX_TEXT_BYTES: usize = 64 * 1024;
pub const MAX_POSITION_VALUES: usize = 65_536;
pub const MAX_FAMILIES: usize = 32;
pub(crate) fn fail(kind: ErrorKind, offset: usize) -> Diagnostic {
    Diagnostic { kind, offset }
}
fn whitespace(b: u8) -> bool {
    matches!(b, b' ' | b'\t' | b'\r' | b'\n')
}

#[derive(Debug, Clone, PartialEq)]
pub struct TextStyleValues {
    pub families: Vec<Vec<u8>>,
    pub family_spans: Vec<Span>,
    pub size_points: f64,
    pub weight: f64,
    pub style: TextStyle,
    pub anchor: vexel_scene::TextAnchor,
    pub letter_spacing_points: f64,
    pub word_spacing: f64,
}
impl TextStyleValues {
    pub fn request<'a>(&'a self, text: &'a [u8], families: &'a [&'a [u8]]) -> TextRequest<'a> {
        TextRequest {
            text,
            font_families: families,
            size_points: self.size_points,
            weight: self.weight,
            style: self.style,
            letter_spacing_points: self.letter_spacing_points,
        }
    }
}

/// Decode entities then preserve or collapse XML whitespace with tspan state.
pub fn normalize_text(
    source: &[u8],
    raw: XmlSpan,
    preserve: bool,
    state: &mut TextState,
) -> Result<Vec<u8>> {
    let input = raw
        .slice(source)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, raw.offset))?;
    let mut decoded = Vec::new();
    decoded
        .try_reserve_exact(input.len())
        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    decoded.resize(input.len(), 0);
    let length = vexel_xml::decode_attribute_value(source, raw, &mut decoded)
        .map_err(|offset| fail(ErrorKind::Unsupported, raw.offset.saturating_add(offset)))?;
    decoded.truncate(length);
    if preserve {
        if !decoded.is_empty() {
            state.has_position = true;
        }
        return Ok(decoded);
    }
    let mut result = Vec::new();
    result
        .try_reserve_exact(decoded.len())
        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    for byte in decoded {
        if whitespace(byte) {
            if state.has_position || !result.is_empty() {
                state.pending_space = true;
            }
            continue;
        }
        if state.pending_space && (state.has_position || !result.is_empty()) {
            result.push(b' ');
        }
        state.pending_space = false;
        result.push(byte);
        state.has_position = true;
    }
    Ok(result)
}

/// Parse the x/y/dx/dy list grammar with percentages against the caller reference.
pub fn parse_position_list(source: &[u8], span: XmlSpan, reference: f64) -> Result<Vec<f64>> {
    let bytes = span
        .slice(source)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, span.offset))?;
    if bytes.is_empty() {
        return Err(fail(ErrorKind::Number, span.offset));
    }
    let mut values = Vec::new();
    values
        .try_reserve_exact(bytes.len().min(MAX_POSITION_VALUES))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    let mut i = 0;
    let mut need_value = true;
    while i < bytes.len() {
        while i < bytes.len() && whitespace(bytes[i]) {
            i += 1;
        }
        if i == bytes.len() {
            break;
        }
        if bytes[i] == b',' {
            if need_value {
                return Err(fail(ErrorKind::Number, span.offset + i));
            }
            need_value = true;
            i += 1;
            continue;
        }
        let start = i;
        while i < bytes.len() && bytes[i] != b',' && !whitespace(bytes[i]) {
            i += 1;
        }
        if values.len() == MAX_POSITION_VALUES {
            return Err(fail(
                ErrorKind::Number,
                span.offset + start,
            ));
        }
        let item = Span::from_offset_length(span.offset + start, i - start)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset + start))?;
        let value = vexel_svg_values::parse_length(source, item, reference)
            .map_err(|_| fail(ErrorKind::Number, item.start))?;
        values.push(value);
        need_value = false;
    }
    if values.is_empty() || need_value {
        return Err(fail(ErrorKind::Number, span.offset + span.length));
    }
    Ok(values)
}

/// Parse a comma-separated CSS family list, removing paired quotes as the C implementation does.
pub fn parse_families(source: &[u8], style: &CssPaint<'_>) -> Result<Vec<Vec<u8>>> {
    parse_families_with_spans(source, style).map(|(families, _)| families)
}

fn parse_families_with_spans(
    source: &[u8],
    style: &CssPaint<'_>,
) -> Result<(Vec<Vec<u8>>, Vec<Span>)> {
    let Some(value) = style.value(Property::FontFamily) else {
        return Ok((Vec::new(), Vec::new()));
    };
    let span = value.span;
    if span.slice(source) != Some(value.bytes) {
        return Err(fail(ErrorKind::Unsupported, span.offset));
    }
    let bytes = value.bytes;
    let mut i = 0;
    let mut families = Vec::new();
    let mut spans = Vec::new();
    families
        .try_reserve_exact(MAX_FAMILIES.min(bytes.len()))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    spans
        .try_reserve_exact(MAX_FAMILIES.min(bytes.len()))
        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    while i < bytes.len() {
        while i < bytes.len() && whitespace(bytes[i]) {
            i += 1;
        }
        if i == bytes.len() {
            break;
        }
        if families.len() == MAX_FAMILIES {
            return Err(fail(
                ErrorKind::Unsupported,
                span.offset + i,
            ));
        }
        let start;
        let end;
        if matches!(bytes[i], b'\'' | b'"') {
            let quote = bytes[i];
            i += 1;
            start = i;
            while i < bytes.len() && bytes[i] != quote {
                i += 1;
            }
            if i == bytes.len() {
                return Err(fail(ErrorKind::Unsupported, span.offset + start - 1));
            }
            end = i;
            i += 1;
        } else {
            start = i;
            while i < bytes.len() && bytes[i] != b',' {
                i += 1;
            }
            let mut trimmed = i;
            while trimmed > start && whitespace(bytes[trimmed - 1]) {
                trimmed -= 1;
            }
            end = trimmed;
        }
        if end == start {
            return Err(fail(ErrorKind::Unsupported, span.offset + start));
        }
        let mut family = Vec::new();
        family
            .try_reserve_exact(end - start)
            .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset + start))?;
        family.extend_from_slice(&bytes[start..end]);
        families.push(family);
        let absolute_start = span
            .offset
            .checked_add(start)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset))?;
        let absolute_end = span
            .offset
            .checked_add(end)
            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset))?;
        spans.push(Span {
            start: absolute_start,
            end: absolute_end,
        });
        while i < bytes.len() && bytes[i] != b',' {
            if !whitespace(bytes[i]) {
                return Err(fail(ErrorKind::Unsupported, span.offset + i));
            }
            i += 1;
        }
        if i < bytes.len() {
            i += 1;
        }
    }
    if families.is_empty() {
        Err(fail(ErrorKind::Unsupported, span.offset))
    } else {
        Ok((families, spans))
    }
}

/// Apply the frozen CSS-to-CoreText style conversion and SVG defaults.
pub fn parse_text_style(
    source: &[u8],
    style: &CssPaint<'_>,
    viewport: [f64; 2],
) -> Result<TextStyleValues> {
    // Keep the original failure order and Unsupported classification. Position
    // attributes use Number errors; font style values do not.
    let size = parse_size(source, style, viewport[1])?;
    let weight = parse_weight(source, style)?;
    let (families, family_spans) = parse_families_with_spans(source, style)?;
    let letter_spacing = parse_spacing(source, style, Property::LetterSpacing, viewport[0])?;
    let word_spacing = parse_spacing(source, style, Property::WordSpacing, viewport[0])?;
    let text_style = if let Some(v) = style.value(Property::FontStyle) {
        if v.bytes.eq_ignore_ascii_case(b"normal") {
            TextStyle::Normal
        } else if v.bytes.eq_ignore_ascii_case(b"italic") {
            TextStyle::Italic
        } else if v.bytes.eq_ignore_ascii_case(b"oblique") {
            TextStyle::Oblique
        } else {
            return Err(fail(ErrorKind::Unsupported, v.span.offset));
        }
    } else {
        TextStyle::Normal
    };
    let anchor = if let Some(v) = style.value(Property::TextAnchor) {
        if v.bytes.eq_ignore_ascii_case(b"start") {
            vexel_scene::TextAnchor::Start
        } else if v.bytes.eq_ignore_ascii_case(b"middle") {
            vexel_scene::TextAnchor::Middle
        } else if v.bytes.eq_ignore_ascii_case(b"end") {
            vexel_scene::TextAnchor::End
        } else {
            return Err(fail(ErrorKind::Unsupported, v.span.offset));
        }
    } else {
        vexel_scene::TextAnchor::Start
    };
    Ok(TextStyleValues {
        families,
        family_spans,
        size_points: size * 0.75,
        weight,
        style: text_style,
        anchor,
        letter_spacing_points: letter_spacing * 0.75,
        word_spacing,
    })
}

pub fn parse_xml_space(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    parent_preserve: bool,
) -> Result<bool> {
    let token = tokens
        .get(element)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, 0))?;
    for attr in tokens
        .get(element + 1..end.min(tokens.len()))
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, token.name.offset))?
        .iter()
        .take_while(|t| t.kind == vexel_xml::TokenKind::Attribute)
    {
        if attr.local_name.slice(source) != Some(b"space")
            || attr.prefix.slice(source) != Some(b"xml")
        {
            continue;
        }
        return match attr.value.slice(source) {
            Some(v) if v.eq_ignore_ascii_case(b"preserve") => Ok(true),
            Some(v) if v.eq_ignore_ascii_case(b"default") => Ok(false),
            _ => Err(fail(ErrorKind::Unsupported, attr.value.offset)),
        };
    }
    Ok(parent_preserve)
}

/// Legacy helper name retained as a public pure operation for parity.
pub fn text_span_equal(source: &[u8], span: XmlSpan, literal: &[u8]) -> bool {
    span.slice(source) == Some(literal)
}

pub fn text_attribute(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    local: &[u8],
    prefix: Option<&[u8]>,
) -> Option<XmlSpan> {
    super::image::attribute(source, tokens, element, end, local, prefix)
}

pub fn parse_size(source: &[u8], style: &CssPaint<'_>, viewport_height: f64) -> Result<f64> {
    let Some(v) = style.value(Property::FontSize) else {
        return Ok(16.);
    };
    let value = vexel_svg_values::parse_length(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
        viewport_height,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
    if value <= 0. {
        return Err(fail(ErrorKind::Unsupported, v.span.offset));
    }
    Ok(value)
}

pub fn parse_weight(source: &[u8], style: &CssPaint<'_>) -> Result<f64> {
    let Some(v) = style.value(Property::FontWeight) else {
        return Ok(400.);
    };
    if v.bytes.eq_ignore_ascii_case(b"normal") {
        return Ok(400.);
    }
    if v.bytes.eq_ignore_ascii_case(b"bold") {
        return Ok(700.);
    }
    let n = vexel_svg_values::parse_number(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
    if !(100. ..=900.).contains(&n) || n % 100. != 0. {
        return Err(fail(ErrorKind::Unsupported, v.span.offset));
    }
    Ok(n)
}

pub fn parse_spacing(
    source: &[u8],
    style: &CssPaint<'_>,
    property: Property,
    reference: f64,
) -> Result<f64> {
    let Some(v) = style.value(property) else {
        return Ok(0.);
    };
    if v.bytes.eq_ignore_ascii_case(b"normal") {
        return Ok(0.);
    }
    vexel_svg_values::parse_length(
        source,
        Span::from_offset_length(v.span.offset, v.span.length)
            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
        reference,
    )
    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))
}
use vexel_base::{Span, WorkControl, WorkKind};
use vexel_scene::{
    Diagnostic, ErrorKind, ImagePixels, LimitKind, MediaError, MediaProvider, Result,
};
use vexel_xml::{TokenKind, XmlSpan, XmlToken};

pub const MAX_ENCODED_IMAGE_BYTES: usize = 32 * 1024 * 1024;
pub const MAX_IMAGE_URI_BYTES: usize = 44_739_266;
pub const MAX_IMAGE_DIMENSION: u32 = 16_384;
pub const MAX_TOTAL_IMAGE_PIXELS: usize = 64 * 1024 * 1024;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ImagePayload {
    pub mime: ImageMime,
    pub encoded: XmlSpan,
}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ImageMime {
    Png,
    Jpeg,
}
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct ImageGeometry {
    pub x: f64,
    pub y: f64,
    pub width: f64,
    pub height: f64,
    pub draw_x: f64,
    pub draw_y: f64,
    pub draw_width: f64,
    pub draw_height: f64,
}
#[derive(Debug)]
pub struct ImagePlan {
    pub geometry: ImageGeometry,
    pub pixels: Option<ImagePixels>,
    pub source: XmlSpan,
}

fn fail(kind: ErrorKind, offset: usize) -> Diagnostic {
    Diagnostic { kind, offset }
}
fn valid_span(source: &[u8], span: XmlSpan) -> Option<&[u8]> {
    span.slice(source)
}

/// Exact byte comparison used by image attribute and URI parsing.
pub fn span_is(source: &[u8], span: XmlSpan, literal: &[u8]) -> bool {
    valid_span(source, span).is_some_and(|value| value == literal)
}

/// Find one unprefixed or explicitly prefixed attribute on a start element.
pub fn attribute(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    local: &[u8],
    prefix: Option<&[u8]>,
) -> Option<XmlSpan> {
    let token = tokens.get(element)?;
    if !matches!(
        token.kind,
        TokenKind::StartElement | TokenKind::EmptyElement
    ) {
        return None;
    }
    for attr in tokens
        .get(element + 1..end.min(tokens.len()))?
        .iter()
        .take_while(|t| t.kind == TokenKind::Attribute)
    {
        if !span_is(source, attr.local_name, local) {
            continue;
        }
        let has_prefix = attr.prefix.length != 0;
        if match prefix {
            None => !has_prefix,
            Some(p) => has_prefix && span_is(source, attr.prefix, p),
        } {
            return Some(attr.value);
        }
    }
    None
}

pub fn base64_value(byte: u8) -> Option<u8> {
    match byte {
        b'A'..=b'Z' => Some(byte - b'A'),
        b'a'..=b'z' => Some(byte - b'a' + 26),
        b'0'..=b'9' => Some(byte - b'0' + 52),
        b'+' => Some(62),
        b'/' => Some(63),
        _ => None,
    }
}

/// Decode canonical padded base64. Invalid alphabet/padding is unsupported;
/// invalid spans, empty data, and frozen size caps retain a source offset.
pub fn decode_base64(
    source: &[u8],
    payload: XmlSpan,
    control: &mut dyn WorkControl,
) -> Result<Vec<u8>> {
    let bytes = valid_span(source, payload)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, payload.offset))?;
    if bytes.is_empty() || bytes.len() > MAX_IMAGE_URI_BYTES || bytes.len() % 4 != 0 {
        return Err(fail(ErrorKind::Limit(LimitKind::Images), payload.offset));
    }
    let padding = usize::from(bytes.ends_with(b"=")) + usize::from(bytes.ends_with(b"=="));
    let groups = bytes.len() / 4;
    let decoded_len = groups
        .checked_mul(3)
        .and_then(|n| n.checked_sub(padding))
        .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), payload.offset))?;
    if decoded_len == 0 || decoded_len > MAX_ENCODED_IMAGE_BYTES {
        return Err(fail(ErrorKind::Limit(LimitKind::Images), payload.offset));
    }
    let mut output = Vec::new();
    output
        .try_reserve_exact(decoded_len)
        .map_err(|_| fail(ErrorKind::OutOfMemory, payload.offset))?;
    for (group_index, block) in bytes.chunks_exact(4).enumerate() {
        control
            .charge(WorkKind::Media, 1)
            .map_err(|stop| Diagnostic {
                kind: match stop {
                    vexel_base::Stop::Canceled => ErrorKind::Canceled,
                    vexel_base::Stop::Limit => ErrorKind::Limit(LimitKind::Work),
                    vexel_base::Stop::Overflow => ErrorKind::Limit(LimitKind::Arithmetic),
                },
                offset: payload.offset + group_index * 4,
            })?;
        let final_group = group_index + 1 == groups;
        let a = base64_value(block[0]);
        let b = base64_value(block[1]);
        let c = if block[2] == b'=' {
            Some(0)
        } else {
            base64_value(block[2])
        };
        let d = if block[3] == b'=' {
            Some(0)
        } else {
            base64_value(block[3])
        };
        let legal = final_group
            && ((block[2] == b'=' && block[3] == b'=') || (block[2] != b'=' && block[3] == b'='));
        if a.is_none()
            || b.is_none()
            || c.is_none()
            || d.is_none()
            || ((block[2] == b'=' || block[3] == b'=') && !legal)
            || (block[2] == b'=' && (b.unwrap_or(0) & 15) != 0)
            || (block[3] == b'=' && block[2] != b'=' && (c.unwrap_or(0) & 3) != 0)
        {
            return Err(fail(
                ErrorKind::Unsupported,
                payload.offset + group_index * 4,
            ));
        }
        let bits = ((a.unwrap() as u32) << 18)
            | ((b.unwrap() as u32) << 12)
            | ((c.unwrap() as u32) << 6)
            | d.unwrap() as u32;
        output.push((bits >> 16) as u8);
        if block[2] != b'=' {
            output.push((bits >> 8) as u8);
        }
        if block[3] != b'=' {
            output.push(bits as u8);
        }
    }
    if output.len() != decoded_len {
        return Err(fail(ErrorKind::Unsupported, payload.offset));
    }
    Ok(output)
}

/// Accept only the two frozen inline URI headers, with no external lookup.
pub fn parse_data_uri(source: &[u8], uri: XmlSpan) -> Result<ImagePayload> {
    let bytes =
        valid_span(source, uri).ok_or_else(|| fail(ErrorKind::InvalidArgument, uri.offset))?;
    let comma = bytes
        .iter()
        .position(|&b| b == b',')
        .ok_or_else(|| fail(ErrorKind::Unsupported, uri.offset))?;
    let mime = match &bytes[..comma] {
        b"data:image/png;base64" => ImageMime::Png,
        b"data:image/jpeg;base64" => ImageMime::Jpeg,
        _ => return Err(fail(ErrorKind::Unsupported, uri.offset)),
    };
    if comma + 1 == bytes.len() {
        return Err(fail(ErrorKind::Unsupported, uri.offset));
    }
    Ok(ImagePayload {
        mime,
        encoded: XmlSpan {
            offset: uri.offset + comma + 1,
            length: bytes.len() - comma - 1,
        },
    })
}

/// Parse SVG image x/y/width/height and meet/slice/none placement geometry.
pub fn image_geometry(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    viewport: [f64; 2],
    pixel_size: Option<[u32; 2]>,
    aspect: vexel_svg_values::Aspect,
) -> Result<ImageGeometry> {
    let names: [&[u8]; 4] = [b"x", b"y", b"width", b"height"];
    let mut values = [0.; 4];
    let mut seen = [false; 4];
    for i in 0..4 {
        let Some(span) = attribute(source, tokens, element, end, names[i], None) else {
            continue;
        };
        seen[i] = true;
        let reference = viewport[if i == 0 || i == 2 { 0 } else { 1 }];
        values[i] = vexel_svg_values::parse_length(
            source,
            Span::from_offset_length(span.offset, span.length)
                .ok_or_else(|| fail(ErrorKind::Number, span.offset))?,
            reference,
        )
        .map_err(|_| fail(ErrorKind::Number, span.offset))?;
    }
    if !seen[2] || !seen[3] || values[2] < 0. || values[3] < 0. {
        return Err(fail(
            ErrorKind::Number,
            tokens.get(element).map_or(0, |t| t.name.offset),
        ));
    }
    let mut g = ImageGeometry {
        x: values[0],
        y: values[1],
        width: values[2],
        height: values[3],
        draw_x: values[0],
        draw_y: values[1],
        draw_width: values[2],
        draw_height: values[3],
    };
    if let Some([pw, ph]) = pixel_size {
        if pw == 0 || ph == 0 {
            return Err(fail(ErrorKind::Unsupported, tokens[element].name.offset));
        }
        if !aspect.none {
            let sx = g.width / pw as f64;
            let sy = g.height / ph as f64;
            let scale = if aspect.slice { sx.max(sy) } else { sx.min(sy) };
            g.draw_width = pw as f64 * scale;
            g.draw_height = ph as f64 * scale;
            g.draw_x += (g.width - g.draw_width) * aspect.align_x;
            g.draw_y += (g.height - g.draw_height) * aspect.align_y;
        }
    }
    if [
        g.x,
        g.y,
        g.width,
        g.height,
        g.draw_x,
        g.draw_y,
        g.draw_width,
        g.draw_height,
    ]
    .iter()
    .any(|n| !n.is_finite())
    {
        return Err(fail(ErrorKind::Number, tokens[element].name.offset));
    }
    let right = g.x + g.width;
    let bottom = g.y + g.height;
    if [g.x, g.y, right, bottom]
        .iter()
        .any(|v| v.abs() > 1_000_000.)
    {
        return Err(fail(ErrorKind::Number, tokens[element].name.offset));
    }
    Ok(g)
}

/// Call the explicitly supplied decoder and enforce the frozen pixel bounds.
pub fn decode_image(
    provider: &mut dyn MediaProvider,
    encoded: &[u8],
    offset: usize,
    control: &mut dyn WorkControl,
) -> Result<ImagePixels> {
    let pixels = provider
        .decode_image(encoded, control)
        .map_err(|e| media_error(e, offset))?;
    pixels
        .validate(offset)
        .map_err(|_| fail(ErrorKind::Unsupported, offset))?;
    if pixels.width > MAX_IMAGE_DIMENSION || pixels.height > MAX_IMAGE_DIMENSION {
        return Err(fail(ErrorKind::Unsupported, offset));
    }
    let pixel_count = (pixels.width as usize)
        .checked_mul(pixels.height as usize)
        .ok_or_else(|| fail(ErrorKind::Unsupported, offset))?;
    if pixel_count > MAX_TOTAL_IMAGE_PIXELS {
        return Err(fail(ErrorKind::Limit(LimitKind::Images), offset));
    }
    Ok(pixels)
}
/// Rust ownership replaces the old provider release callback.
pub fn release_image(pixels: ImagePixels) {
    drop(pixels);
}

/// Parse one SVG image element and ask the explicit provider to decode inline
/// PNG/JPEG bytes. Zero-area images retain geometry and do not invoke a provider.
pub fn image_element(
    view: vexel_scene::ElementView<'_>,
    viewport: [f64; 2],
    provider: &mut dyn MediaProvider,
    control: &mut dyn WorkControl,
) -> Result<ImagePlan> {
    view.validate(control)?;
    let source = view.source();
    let tokens = view.tokens();
    let element = view.element.0;
    let end = view.end;
    let token = tokens
        .get(element)
        .ok_or_else(|| fail(ErrorKind::InvalidArgument, 0))?;
    let name = token.name;
    let base_geometry = image_geometry(
        source,
        tokens,
        element,
        end,
        viewport,
        None,
        vexel_svg_values::Aspect::default(),
    )?;
