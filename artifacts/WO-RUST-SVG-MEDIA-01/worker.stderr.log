#[test]
fn invalid_image_source_assignment_does_not_mutate_scene_draft() {
    let source = std::sync::Arc::new(b"<svg/>".to_vec());
    let (tokens, parsed) = vexel_xml::tokenize(&source, XmlLimits::default());
    assert_eq!(parsed.diagnostic.category, vexel_xml::XmlError::None);
    let animation =
        vexel_svg_animation::parse_owned(&source, &tokens[..parsed.token_count]).unwrap();
    let viewport = vexel_scene::Viewport {
        width: 8,
        height: 8,
        view_x: 0.,
        view_y: 0.,
        view_width: 8.,
        view_height: 8.,
        aspect: Default::default(),
    };
    let mut builder = vexel_scene::SceneBuilder::new(
        source,
        animation,
        1,
        viewport,
        vexel_scene::Limits::default(),
    )
    .unwrap();
    let scene = builder.root_id();
    let draft = builder.begin_draft(scene).unwrap();
    let plan = ImagePlan {
        geometry: ImageGeometry {
            x: 0.,
            y: 0.,
            width: 0.,
            height: 0.,
            draw_x: 0.,
            draw_y: 0.,
            draw_width: 0.,
            draw_height: 0.,
        },
        pixels: None,
        source: XmlSpan {
            offset: 0,
            length: 1,
        },
    };
    assert!(append_image_plan(
        plan,
        XmlSpan {
            offset: 99,
            length: 1,
        },
        scene,
        vexel_geometry::affine_identity(),
        &mut builder,
        &draft,
        &mut NoStop
    )
    .is_err());
    let view = builder.scene(scene).unwrap();
    assert!(view.shapes.is_empty() && view.images.is_empty());
    builder.rollback_draft(draft).unwrap();
}

