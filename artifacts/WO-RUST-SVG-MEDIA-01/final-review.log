struct FailingProvider { inner: Provider, calls: usize, failure: Option<MediaError> }
impl MediaProvider for FailingProvider {
    fn layout_text(&mut self, request: TextRequest<'_>, control: &mut dyn WorkControl)
        -> std::result::Result<TextLayout, MediaError>
    {
        self.calls += 1;
        if self.calls == 2 {
            if let Some(error) = self.failure { return Err(error); }
            let mut malformed = self.inner.layout_text(request, control)?;
            malformed.glyphs[0].commands = TableRange { first: usize::MAX, count: 2 };
            return Ok(malformed);
        }
        self.inner.layout_text(request, control)
    }
    fn decode_image(&mut self, _: &[u8], _: &mut dyn WorkControl)
        -> std::result::Result<ImagePixels, MediaError>
    { self.calls += 1; Err(self.failure.unwrap_or(MediaError::Corrupt)) }
}
fn errors() -> [MediaError; 8] {
    [MediaError::OutOfMemory, MediaError::Limit, MediaError::Unsupported, MediaError::Invalid,
        MediaError::InvalidArgument, MediaError::InvalidUtf8, MediaError::Animated, MediaError::Corrupt]
}
fn expected(error: MediaError, text: bool) -> ErrorKind {
    match error {
        MediaError::OutOfMemory => ErrorKind::OutOfMemory,
        MediaError::Limit => ErrorKind::Limit(if text { LimitKind::TextCommands } else { LimitKind::Images }),
        _ => ErrorKind::Unsupported,
    }
}

