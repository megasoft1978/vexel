    85	/// Parse the x/y/dx/dy list grammar with percentages against the caller reference.
    86	pub fn parse_position_list(source: &[u8], span: XmlSpan, reference: f64) -> Result<Vec<f64>> {
    87	    let bytes = span
    88	        .slice(source)
    89	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, span.offset))?;
    90	    if bytes.is_empty() {
    91	        return Err(fail(ErrorKind::Number, span.offset));
    92	    }
    93	    let mut values = Vec::new();
    94	    values
    95	        .try_reserve_exact(bytes.len().min(MAX_POSITION_VALUES))
    96	        .map_err(|_| fail(ErrorKind::OutOfMemory, span.offset))?;
    97	    let mut i = 0;
    98	    let mut need_value = true;
    99	    while i < bytes.len() {
   100	        while i < bytes.len() && whitespace(bytes[i]) {
   101	            i += 1;
   102	        }
   103	        if i == bytes.len() {
   104	            break;
   105	        }
   106	        if bytes[i] == b',' {
   107	            if need_value {
   108	                return Err(fail(ErrorKind::Number, span.offset + i));
   109	            }
   110	            need_value = true;
   111	            i += 1;
   112	            continue;
   113	        }
   114	        let start = i;
   115	        while i < bytes.len() && bytes[i] != b',' && !whitespace(bytes[i]) {
   116	            i += 1;
   117	        }
   118	        if values.len() == MAX_POSITION_VALUES {
   119	            return Err(fail(
   120	                ErrorKind::Number,
   121	                span.offset + start,
   122	            ));
   123	        }
   124	        let item = Span::from_offset_length(span.offset + start, i - start)
   125	            .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), span.offset + start))?;
   126	        let value = vexel_svg_values::parse_length(source, item, reference)
   127	            .map_err(|_| fail(ErrorKind::Number, item.start))?;
   128	        values.push(value);
   129	        need_value = false;
   130	    }
   131	    if values.is_empty() || need_value {
   132	        return Err(fail(ErrorKind::Number, span.offset + span.length));
   133	    }
   134	    Ok(values)
   135	}
