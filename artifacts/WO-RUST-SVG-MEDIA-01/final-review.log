   170	fn close_contour(
   171	    current: vexel_geometry::Point,
   172	    first: vexel_geometry::Point,
   173	    first_edge: usize,
   174	    transform: vexel_geometry::Affine,
   175	    edges: &mut Vec<vexel_geometry::Edge>,
   176	    subpaths: &mut Vec<vexel_svg_path::PathSubpath>,
   177	    control: &mut dyn WorkControl,
   178	) -> Result<()> {
   179	    append_text_edge(current, first, transform, edges, control)?;
   180	    subpaths.try_reserve(1).map_err(|_| fail(ErrorKind::OutOfMemory, 0))?;
   181	    subpaths.push(vexel_svg_path::PathSubpath {
   182	        first_edge,
   183	        edge_count: edges.len() - first_edge,
   184	        closed: true,
   185	    });
   186	    Ok(())
   187	}
