struct Interrupt {at:usize,calls:usize,stop:Stop}
impl WorkControl for Interrupt {
    fn checkpoint(&mut self)->std::result::Result<(),Stop>{
        self.calls+=1;if self.calls==self.at{Err(self.stop)}else{Ok(())}
    }
    fn charge(&mut self,_:WorkKind,_:u64)->std::result::Result<(),Stop>{self.checkpoint()}
}
fn probe_hidden(at:usize,stop:Stop,cached:bool)->usize {
    let source=br#"<svg><path d="M0 0L1 0L1 1Z"/><text style="visibility:hidden">A<![CDATA[B]]></text></svg>"#;
    let mut f=Fixture::new(source,Limits::default());let i=f.index(b"text");
    let mut shared=DecodeSource::new(&f.lex,&mut Run).unwrap();
    let style=shared.compute_style(ElementId(i),None,&mut Run).unwrap();
    let element=view(&f.lex,i);let map=f.map(i);let scene=f.builder.root_id();
    let draft=f.builder.begin_draft(scene).unwrap();
    let prefix=f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
    let prefix_value=*f.builder.scene(scene).unwrap().shape(prefix).unwrap();
    let mut state=TextState{cursor_x:11.,cursor_y:9.,text_bytes:13,glyph_count:2,
        pending_space:true,has_position:true};
    let mut cache=TextCache::default();let mut p=provider(Mode::Valid);let publisher=Publisher::default();
    let mut ledger=ChargeLedger::new(f.lex.source_owner(),1<<20,8).unwrap();
    if cached {
        publish_text_request(TextDecodeRequest{element,source_map:map,end:element.end,
            style:&style,transform:map.transform,state:&mut state,preserve_space:false,
            provider:&mut p,cache:&mut cache,scene,ledger:&mut ledger},&publisher,
            &mut f.builder,&draft,&mut Run).unwrap();
        assert_eq!(p.inner.seen.len(),2);
    }
    let before=state;let doc_before=f.builder.document_text_commands();
    let cache_before=(cache.entries.len(),cache.text_bytes,cache.commands);
    let pointers=cache.entries.iter().map(|e|(e.text.as_ptr(),e.layout.commands.as_ptr())).collect::<Vec<_>>();
    let mut control=Interrupt{at,calls:0,stop};
    let result=publish_text_request(TextDecodeRequest{element,source_map:map,end:element.end,
        style:&style,transform:map.transform,state:&mut state,preserve_space:false,
        provider:&mut p,cache:&mut cache,scene,ledger:&mut ledger},&publisher,
        &mut f.builder,&draft,&mut control);
    if at==usize::MAX {
        result.unwrap();assert!(state.cursor_x>before.cursor_x);
        assert_eq!(f.builder.document_text_commands(),doc_before+10);
        assert_eq!(f.builder.scene(scene).unwrap().shapes.len(),1);
    }else{
        let expected=match stop{Stop::Canceled=>ErrorKind::Canceled,Stop::Limit=>ErrorKind::Limit(LimitKind::Work),
            Stop::Overflow=>ErrorKind::Limit(LimitKind::Arithmetic)};
        assert_eq!(result.unwrap_err().kind,expected);
        assert_eq!(state_values(state),state_values(before));
        assert_eq!(f.builder.document_text_commands(),doc_before);
        assert_eq!((cache.entries.len(),cache.text_bytes,cache.commands),cache_before);
        assert_eq!(cache.entries.iter().map(|e|(e.text.as_ptr(),e.layout.commands.as_ptr())).collect::<Vec<_>>(),pointers);
        let s=f.builder.scene(scene).unwrap();assert_eq!(s.shapes.len(),1);
        assert_eq!(s.shape(prefix),Some(&prefix_value));assert_eq!(s.edges.len(),prefix_value.edges.count);
        assert!(s.images.is_empty());assert!(s.clips.is_empty());assert!(s.groups.is_empty());
        f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
    }
    f.builder.commit_draft(&draft,&mut Run).unwrap();control.calls
}
