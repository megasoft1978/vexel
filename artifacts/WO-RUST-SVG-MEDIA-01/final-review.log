mod support;
use support::*;
use std::cell::RefCell;
use vexel_base::{Stop, WorkControl, WorkKind};
use vexel_scene::*;
use vexel_svg_media::{CustomGeometry, PublicationContext, StylePublisher, publish_text_request};

// Explicit fixture delegate: real owned scene publication, no production fallback.
#[derive(Default)]
struct Publisher { calls: RefCell<Vec<&'static str>> }
impl StylePublisher for Publisher {
    fn begin(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {
        self.calls.borrow_mut().push("begin"); Ok(())
    }
    fn prepare_geometry(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {
        self.calls.borrow_mut().push("prepare"); Ok(())
    }
    fn prepare_admitted_geometry(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> { Ok(()) }
    fn publish(&self, _c: &PublicationContext<'_, '_>, g: CustomGeometry, b: &mut SceneBuilder,
        d: &DraftToken, control: &mut dyn WorkControl) -> Result<ShapeId> {
        self.calls.borrow_mut().push("publish");
        let colors=vec![[0,0,255,255];g.path.edges.len()];
        b.append_admitted_shape(d, &g.admission,ShapeInput{shape:Shape::new(g.source_map),path:g.path,edge_colors:colors},control)
    }
    fn finish(&self, _: &PublicationContext<'_, '_>, _: usize, _: &mut SceneBuilder,
        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {
        self.calls.borrow_mut().push("finish"); Ok(())
    }
}
#[derive(Clone,Copy)]
enum Mode { Valid, NoOutline, EmptyCommands, CommandCap, Malformed, Mismatch, MismatchNoOutline, Error(MediaError) }
struct LayoutProvider { inner: Provider, mode: Mode }
impl MediaProvider for LayoutProvider {
    fn layout_text(&mut self, request: TextRequest<'_>, control: &mut dyn WorkControl)
        -> std::result::Result<TextLayout,MediaError> {
        let mut output=self.inner.layout_text(request,control)?;
        match self.mode {
            Mode::Valid=>{},
            Mode::NoOutline=>for g in &mut output.glyphs {g.commands.count=0;},
            Mode::EmptyCommands=>{for g in &mut output.glyphs {g.commands.count=0;}output.commands.clear();},
            Mode::CommandCap=>output.commands.resize(vexel_svg_media::MAX_PATH_COMMANDS,
                TextCommand{verb:TextVerb::Close,values:[0.;6]}),
            Mode::Malformed=>output.advance_width=f64::NAN,
            Mode::Mismatch=>output.glyphs.push(output.glyphs[0]),
            Mode::MismatchNoOutline=>{
                output.glyphs.push(output.glyphs[0]);
                for glyph in &mut output.glyphs {glyph.commands.count=0;}
            },
            Mode::Error(e)=>return Err(e),
        }
        Ok(output)
    }
    fn decode_image(&mut self, _: &[u8], _: &mut dyn WorkControl)
        -> std::result::Result<ImagePixels,MediaError> {Err(MediaError::Unsupported)}
}
fn provider(mode:Mode)->LayoutProvider {LayoutProvider{inner:Provider::default(),mode}}
fn state_values(s:TextState)->(usize,usize,f64,f64,bool,bool) {
    (s.text_bytes,s.glyph_count,s.cursor_x,s.cursor_y,s.has_position,s.pending_space)
}

