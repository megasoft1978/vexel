   321	        .map_err(|stop| Diagnostic {
   322	            kind: match stop {
   323	                vexel_base::Stop::Canceled => ErrorKind::Canceled,
   324	                vexel_base::Stop::Limit => ErrorKind::Limit(LimitKind::Work),
   325	                vexel_base::Stop::Overflow => ErrorKind::Limit(LimitKind::Arithmetic),
   326	            },
   327	            offset: 0,
   328	        })
   329	}
