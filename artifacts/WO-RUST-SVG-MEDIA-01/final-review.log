   327	struct Interrupt { at: usize, calls: usize, stop: vexel_base::Stop }
   328	impl WorkControl for Interrupt {
   329	    fn checkpoint(&mut self) -> std::result::Result<(),vexel_base::Stop> {
   330	        self.calls+=1; if self.calls==self.at {Err(self.stop)}else{Ok(())}
   331	    }
   332	    fn charge(&mut self, _: vexel_base::WorkKind, _: u64) -> std::result::Result<(),vexel_base::Stop> {
   333	        self.checkpoint()
   334	    }
   335	}
   336	#[test]
   337	fn styled_routes_cancel_at_every_control_boundary_including_real_clip_group_and_commit() {
   338	    for is_text in [false,true] {
   339	        let mut boundaries=0;
   340	        for stop in [None,Some(vexel_base::Stop::Canceled),Some(vexel_base::Stop::Limit),Some(vexel_base::Stop::Overflow)] {
   341	            // First run counts successful boundaries, then interrupt every one.
   342	            let points = if stop.is_none() {vec![usize::MAX]}else{(1..=boundaries).collect()};
   343	            let stop=stop.unwrap_or(vexel_base::Stop::Canceled);
   344	            for at in points {
   345	                let source=br##"<svg><path d="M0 0L1 0L1 1Z"/><image width="8" height="4" style="opacity:.5;clip-path:url(#c)" href="data:image/png;base64,AQID"/><text style="opacity:.5;clip-path:url(#fixture)">A<![CDATA[B]]></text></svg>"##;
   346	                let mut f=Fixture::new(source,Limits::default());let i=f.index(if is_text{b"text"}else{b"image"});
   347	                let mut shared=DecodeSource::new(&f.lex,&mut Run).unwrap();
   348	                let style=shared.compute_style(ElementId(i),None,&mut Run).unwrap();
   349	                let element=view(&f.lex,i);let map=f.map(i);let scene=f.builder.root_id();
   350	                let draft=f.builder.begin_draft(scene).unwrap();
   351	                let prefix=f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
   352	                let prefix_shape=*f.builder.scene(scene).unwrap().shape(prefix).unwrap();
   353	                let mut state=TextState::default(); let mut cache=TextCache::default();
   354	                let mut provider=Provider::default();let p=Publisher::default();
   355	                let mut ledger=ChargeLedger::new(f.lex.source_owner(),1<<20,8).unwrap();
   356	                let mut control=Interrupt{at,calls:0,stop};
   357	                let result=if is_text {
   358	                    publish_text_request(TextDecodeRequest{element,source_map:map,end:element.end,
   359	                        style:&style,transform:map.transform,state:&mut state,preserve_space:false,
   360	                        provider:&mut provider,cache:&mut cache,scene,ledger:&mut ledger},&p,
   361	                        &mut f.builder,&draft,&mut control).map(|_|())
   362	                }else{
   363	                    publish_image_request(ImageDecodeRequest{element,source_map:map,style:&style,
   364	                        transform:map.transform,provider:&mut provider,scene,ledger:&mut ledger},&p,
   365	                        &mut f.builder,&draft,&mut control).map(|_|())
   366	                };
   367	                if at==usize::MAX {result.unwrap();boundaries=control.calls;continue;}
   368	                assert_eq!(result.unwrap_err().kind,match stop{
   369	                    vexel_base::Stop::Canceled=>ErrorKind::Canceled,
   370	                    vexel_base::Stop::Limit=>ErrorKind::Limit(LimitKind::Work),
   371	                    vexel_base::Stop::Overflow=>ErrorKind::Limit(LimitKind::Arithmetic)});
   372	                let s=f.builder.scene(scene).unwrap();
   373	                assert_eq!(s.shapes.len(),1);assert_eq!(s.shape(prefix),Some(&prefix_shape));
   374	                assert_eq!(s.edges.len(),prefix_shape.edges.count);
   375	                assert!(s.images.is_empty());assert!(s.clips.is_empty());assert!(s.groups.is_empty());
   376	                assert_eq!((state.text_bytes,state.glyph_count,state.cursor_x),(0,0,0.));
   377	                assert_eq!((cache.entries.len(),cache.text_bytes,cache.commands),(0,0,0));
   378	                assert_eq!(f.builder.document_text_commands(),0);
   379	                f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
   380	                f.builder.commit_draft(&draft,&mut Run).unwrap();
   381	            }
   382	        }
   383	        assert!(boundaries>20);
   384	    }
   385	}
