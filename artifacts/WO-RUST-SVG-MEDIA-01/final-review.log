   288	/// Call the explicitly supplied decoder and enforce the frozen pixel bounds.
   289	pub fn decode_image(
   290	    provider: &mut dyn MediaProvider,
   291	    encoded: &[u8],
   292	    offset: usize,
   293	    control: &mut dyn WorkControl,
   294	) -> Result<ImagePixels> {
   295	    let pixels = provider
   296	        .decode_image(encoded, control)
   297	        .map_err(|e| media_error(e, offset))?;
   298	    pixels
   299	        .validate(offset)
   300	        .map_err(|_| fail(ErrorKind::Unsupported, offset))?;
   301	    if pixels.width > MAX_IMAGE_DIMENSION || pixels.height > MAX_IMAGE_DIMENSION {
   302	        return Err(fail(ErrorKind::Unsupported, offset));
   303	    }
   304	    let pixel_count = (pixels.width as usize)
   305	        .checked_mul(pixels.height as usize)
   306	        .ok_or_else(|| fail(ErrorKind::Unsupported, offset))?;
   307	    if pixel_count > MAX_TOTAL_IMAGE_PIXELS {
   308	        return Err(fail(ErrorKind::Limit(LimitKind::Images), offset));
   309	    }
   310	    Ok(pixels)
   311	}
   312	/// Rust ownership replaces the old provider release callback.
   313	pub fn release_image(pixels: ImagePixels) {
   314	    drop(pixels);
   315	}
