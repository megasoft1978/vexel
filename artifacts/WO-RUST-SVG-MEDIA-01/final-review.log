   120	/// Run the owned layout engine using the accepted scene request cache storage.
   121	pub fn layout_shared<'a>(
   122	    cache: &'a mut vexel_scene::TextCache,
   123	    request: TextRequest<'_>,
   124	    family_spans: &[vexel_base::Span],
   125	    provider: &mut dyn MediaProvider,
   126	    control: &mut dyn WorkControl,
   127	    offset: usize,
   128	) -> Result<LayoutResult<'a>> {
   129	    request.validate(control)?;
   130	    let cached = cache.entries.iter().position(|entry| {
   131	        entry.text == request.text
   132	            && entry.owned_families.len() == request.font_families.len()
   133	            && entry
   134	                .owned_families
   135	                .iter()
   136	                .zip(request.font_families)
   137	                .all(|(a, b)| a.as_slice() == *b)
   138	            && entry.size_points == request.size_points
   139	            && entry.weight == request.weight
   140	            && entry.letter_spacing_points == request.letter_spacing_points
   141	            && entry.style == request.style
   142	    });
   143	    if let Some(index) = cached {
   144	        return Ok(LayoutResult::Cached(&cache.entries[index].layout));
   145	    }
   146	    let layout = provider
   147	        .layout_text(request, control)
   148	        .map_err(|e| provider_error(e, offset))?;
   149	    validate_layout(&layout, offset, control)?;
   150	    let text_bytes = cache
   151	        .entries
   152	        .iter()
   153	        .try_fold(0usize, |sum, entry| sum.checked_add(entry.text.len()));
   154	    let commands = cache.entries.iter().try_fold(0usize, |sum, entry| {
   155	        sum.checked_add(entry.layout.commands.len())
   156	    });
   157	    let text_bytes = text_bytes.ok_or_else(|| Diagnostic {
   158	        kind: ErrorKind::Limit(LimitKind::Arithmetic),
   159	        offset,
   160	    })?;
   161	    let commands = commands.ok_or_else(|| Diagnostic {
   162	        kind: ErrorKind::Limit(LimitKind::Arithmetic),
   163	        offset,
   164	    })?;
   165	    let can_cache = cache.entries.len() < TEXT_CACHE_ENTRIES
   166	        && request.text.len() <= TEXT_CACHE_BYTES.saturating_sub(text_bytes)
   167	        && layout.commands.len() <= MAX_PATH_COMMANDS.saturating_sub(commands);
   168	    if can_cache {
   169	        let mut text = Vec::new();
   170	        let mut owned_families = Vec::new();
   171	        let mut stored_family_spans = Vec::new();
   172	        if text.try_reserve_exact(request.text.len()).is_ok()
   173	            && owned_families
   174	                .try_reserve_exact(request.font_families.len())
   175	                .is_ok()
   176	            && stored_family_spans
   177	                .try_reserve_exact(family_spans.len())
   178	                .is_ok()
   179	        {
   180	            text.extend_from_slice(request.text);
   181	            stored_family_spans.extend_from_slice(family_spans);
   182	            let mut complete = true;
   183	            for family in request.font_families {
   184	                let mut owned = Vec::new();
   185	                if owned.try_reserve_exact(family.len()).is_err() {
   186	                    complete = false;
   187	                    break;
   188	                }
   189	                owned.extend_from_slice(family);
   190	                owned_families.push(owned);
   191	            }
   192	            if complete && cache.entries.try_reserve(1).is_ok() {
   193	                cache.text_bytes = text_bytes + request.text.len();
   194	                cache.commands = commands + layout.commands.len();
   195	                cache.entries.push(vexel_scene::TextCacheEntry {
   196	                    text,
   197	                    family_spans: stored_family_spans,
   198	                    owned_families,
   199	                    size_points: request.size_points,
   200	                    weight: request.weight,
   201	                    letter_spacing_points: request.letter_spacing_points,
   202	                    style: request.style,
   203	                    layout,
   204	                });
   205	                return Ok(LayoutResult::Cached(
   206	                    &cache.entries.last().expect("inserted").layout,
   207	                ));
   208	            }
   209	        }
   210	    }
   211	    Ok(LayoutResult::Owned(layout))
   212	}
