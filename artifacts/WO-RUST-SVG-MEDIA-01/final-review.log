    98	/// Decode canonical padded base64. Invalid alphabet/padding is unsupported;
    99	/// invalid spans, empty data, and frozen size caps retain a source offset.
   100	pub fn decode_base64(
   101	    source: &[u8],
   102	    payload: XmlSpan,
   103	    control: &mut dyn WorkControl,
   104	) -> Result<Vec<u8>> {
   105	    let bytes = valid_span(source, payload)
   106	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, payload.offset))?;
   107	    if bytes.is_empty() || bytes.len() > MAX_IMAGE_URI_BYTES || bytes.len() % 4 != 0 {
   108	        return Err(fail(ErrorKind::Limit(LimitKind::Images), payload.offset));
   109	    }
   110	    let padding = usize::from(bytes.ends_with(b"=")) + usize::from(bytes.ends_with(b"=="));
   111	    let groups = bytes.len() / 4;
   112	    let decoded_len = groups
   113	        .checked_mul(3)
   114	        .and_then(|n| n.checked_sub(padding))
   115	        .ok_or_else(|| fail(ErrorKind::Limit(LimitKind::Arithmetic), payload.offset))?;
   116	    if decoded_len == 0 || decoded_len > MAX_ENCODED_IMAGE_BYTES {
   117	        return Err(fail(ErrorKind::Limit(LimitKind::Images), payload.offset));
   118	    }
   119	    let mut output = Vec::new();
   120	    output
   121	        .try_reserve_exact(decoded_len)
   122	        .map_err(|_| fail(ErrorKind::OutOfMemory, payload.offset))?;
   123	    for (group_index, block) in bytes.chunks_exact(4).enumerate() {
   124	        control
   125	            .charge(WorkKind::Media, 1)
   126	            .map_err(|stop| Diagnostic {
   127	                kind: match stop {
   128	                    vexel_base::Stop::Canceled => ErrorKind::Canceled,
   129	                    vexel_base::Stop::Limit => ErrorKind::Limit(LimitKind::Work),
   130	                    vexel_base::Stop::Overflow => ErrorKind::Limit(LimitKind::Arithmetic),
   131	                },
   132	                offset: payload.offset + group_index * 4,
   133	            })?;
   134	        let final_group = group_index + 1 == groups;
   135	        let a = base64_value(block[0]);
   136	        let b = base64_value(block[1]);
   137	        let c = if block[2] == b'=' {
   138	            Some(0)
   139	        } else {
   140	            base64_value(block[2])
   141	        };
   142	        let d = if block[3] == b'=' {
   143	            Some(0)
   144	        } else {
   145	            base64_value(block[3])
   146	        };
   147	        let legal = final_group
   148	            && ((block[2] == b'=' && block[3] == b'=') || (block[2] != b'=' && block[3] == b'='));
   149	        if a.is_none()
   150	            || b.is_none()
   151	            || c.is_none()
   152	            || d.is_none()
   153	            || ((block[2] == b'=' || block[3] == b'=') && !legal)
   154	            || (block[2] == b'=' && (b.unwrap_or(0) & 15) != 0)
   155	            || (block[3] == b'=' && block[2] != b'=' && (c.unwrap_or(0) & 3) != 0)
   156	        {
   157	            return Err(fail(
   158	                ErrorKind::Unsupported,
   159	                payload.offset + group_index * 4,
   160	            ));
   161	        }
   162	        let bits = ((a.unwrap() as u32) << 18)
   163	            | ((b.unwrap() as u32) << 12)
   164	            | ((c.unwrap() as u32) << 6)
   165	            | d.unwrap() as u32;
   166	        output.push((bits >> 16) as u8);
   167	        if block[2] != b'=' {
   168	            output.push((bits >> 8) as u8);
   169	        }
   170	        if block[3] != b'=' {
   171	            output.push(bits as u8);
   172	        }
   173	    }
   174	    if output.len() != decoded_len {
   175	        return Err(fail(ErrorKind::Unsupported, payload.offset));
   176	    }
   177	    Ok(output)
   178	}
