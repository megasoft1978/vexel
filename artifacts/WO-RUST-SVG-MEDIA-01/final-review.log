#[test]
fn hidden_text_font_provider_position_and_wordspacing_errors_precede_visibility_geometry_skip() {
    let cases=[
        ("style=\"visibility:hidden;font-size:bad\"",Mode::Valid,ErrorKind::Unsupported,"bad",0),
        ("style=\"visibility:collapse;font-weight:bad\"",Mode::Valid,ErrorKind::Unsupported,"bad",0),
        ("style=\"visibility:hidden\"",Mode::Error(MediaError::Unsupported),ErrorKind::Unsupported,">A",1),
        ("style=\"visibility:hidden\"",Mode::Error(MediaError::OutOfMemory),ErrorKind::OutOfMemory,">A",1),
        ("style=\"visibility:hidden\"",Mode::Malformed,ErrorKind::Limit(LimitKind::TextCommands),">A",1),
        ("x=\"bad\" style=\"visibility:hidden\"",Mode::Valid,ErrorKind::Number,"bad",1),
        ("dy=\"bad\" style=\"visibility:collapse\"",Mode::NoOutline,ErrorKind::Number,"bad",1),
        ("x=\"bad\" style=\"visibility:bogus\"",Mode::NoOutline,ErrorKind::Number,"bad",1),
        ("style=\"visibility:hidden;word-spacing:1px\"",Mode::Mismatch,ErrorKind::Unsupported,">A",1),
        ("style=\"visibility:bogus;word-spacing:1px\"",Mode::MismatchNoOutline,ErrorKind::Unsupported,">A",1),
    ];
    for (attrs,mode,kind,needle,calls) in cases {
        let source=format!("<svg><path d=\"M0 0L1 0L1 1Z\"/><text {attrs}>A</text></svg>");
        let mut f=Fixture::new(source.as_bytes(),Limits::default());let i=f.index(b"text");
        let mut shared=DecodeSource::new(&f.lex,&mut Run).unwrap();
        let style=shared.compute_style(ElementId(i),None,&mut Run).unwrap();
        let element=view(&f.lex,i);let map=f.map(i);let scene=f.builder.root_id();
        let draft=f.builder.begin_draft(scene).unwrap();
        let prefix=f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
        let before_shape=*f.builder.scene(scene).unwrap().shape(prefix).unwrap();
        let mut state=TextState::default();state.cursor_x=17.;let before=state;
        let mut cache=TextCache::default();let mut p=provider(mode);let publisher=Publisher::default();
        let mut ledger=ChargeLedger::new(f.lex.source_owner(),1<<20,8).unwrap();
        let e=publish_text_request(TextDecodeRequest{element,source_map:map,end:element.end,
            style:&style,transform:map.transform,state:&mut state,preserve_space:false,
            provider:&mut p,cache:&mut cache,scene,ledger:&mut ledger},&publisher,
            &mut f.builder,&draft,&mut Run).unwrap_err();
        let offset=source.find(needle).unwrap()+usize::from(needle==">A");
        assert_eq!((e.kind,e.offset),(kind,offset));assert_eq!(p.inner.seen.len(),calls);
        assert_eq!(&*publisher.calls.borrow(), &["begin"]);
        assert_eq!(state_values(state),state_values(before));
        assert_eq!((cache.entries.len(),cache.text_bytes,cache.commands),(0,0,0));
        assert_eq!(f.builder.document_text_commands(),0);
        let s=f.builder.scene(scene).unwrap();assert_eq!(s.shapes.len(),1);
        assert_eq!(s.shape(prefix),Some(&before_shape));
        f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
        f.builder.commit_draft(&draft,&mut Run).unwrap();
    }
}

#[test]
fn invalid_visibility_is_checked_only_for_nonzero_referenced_outline_commands() {
    for mode in [Mode::NoOutline,Mode::EmptyCommands,Mode::Valid] {
        let source=br#"<svg><text x="20" y="30" dx="2" dy="3" style="visibility:bogus">A</text></svg>"#;
        let mut f=Fixture::new(source,Limits::default());let i=f.index(b"text");
        let mut shared=DecodeSource::new(&f.lex,&mut Run).unwrap();
        let style=shared.compute_style(ElementId(i),None,&mut Run).unwrap();
        let element=view(&f.lex,i);let map=f.map(i);let scene=f.builder.root_id();
        let draft=f.builder.begin_draft(scene).unwrap();let mut state=TextState::default();
        let mut cache=TextCache::default();let mut p=provider(mode);let publisher=Publisher::default();
        let mut ledger=ChargeLedger::new(f.lex.source_owner(),1<<20,8).unwrap();
        let result=publish_text_request(TextDecodeRequest{element,source_map:map,end:element.end,
            style:&style,transform:map.transform,state:&mut state,preserve_space:false,
            provider:&mut p,cache:&mut cache,scene,ledger:&mut ledger},&publisher,
            &mut f.builder,&draft,&mut Run);
        assert_eq!(p.inner.seen.len(),1);assert!(f.builder.scene(scene).unwrap().shapes.is_empty());
        match mode {
            Mode::Valid=>{
                let e=result.unwrap_err();let offset=source.windows(5).position(|b|b==b"bogus").unwrap();
                assert_eq!((e.kind,e.offset),(ErrorKind::Unsupported,offset));
                assert_eq!(state_values(state),state_values(TextState::default()));
                assert_eq!(f.builder.document_text_commands(),0);assert!(cache.entries.is_empty());
                assert_eq!(&*publisher.calls.borrow(), &["begin"]);
            },
            _=>{
                result.unwrap();assert_eq!((state.cursor_x,state.cursor_y),(30.,33.));
                assert_eq!((state.text_bytes,state.glyph_count,state.has_position),(1,1,true));
                let commands=if matches!(mode,Mode::NoOutline){5}else{0};
                assert_eq!(f.builder.document_text_commands(),commands);
                assert_eq!((cache.entries.len(),cache.text_bytes,cache.commands),(1,1,commands));
                assert_eq!(&*publisher.calls.borrow(), &["begin","finish"]);
            }
        }
        f.builder.commit_draft(&draft,&mut Run).unwrap();
    }
}

