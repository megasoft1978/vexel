   573	        let style=CssPaint::initial();let p=PanicPublisher {inner:Publisher::default(),stage};
   574	        let outcome=std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
   575	            publish_image_request(ImageDecodeRequest {element,source_map:map,style:&style,
   576	                transform:vexel_geometry::affine_identity(),provider:&mut provider,scene,ledger:&mut ledger},
