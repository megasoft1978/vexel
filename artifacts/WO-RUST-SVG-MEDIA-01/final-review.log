   205	/// Parse SVG image x/y/width/height and meet/slice/none placement geometry.
   206	pub fn image_geometry(
   207	    source: &[u8],
   208	    tokens: &[XmlToken],
   209	    element: usize,
   210	    end: usize,
   211	    viewport: [f64; 2],
   212	    pixel_size: Option<[u32; 2]>,
   213	    aspect: vexel_svg_values::Aspect,
   214	) -> Result<ImageGeometry> {
   215	    let names: [&[u8]; 4] = [b"x", b"y", b"width", b"height"];
   216	    let mut values = [0.; 4];
   217	    let mut seen = [false; 4];
   218	    for i in 0..4 {
   219	        let Some(span) = attribute(source, tokens, element, end, names[i], None) else {
   220	            continue;
   221	        };
   222	        seen[i] = true;
   223	        let reference = viewport[if i == 0 || i == 2 { 0 } else { 1 }];
   224	        values[i] = vexel_svg_values::parse_length(
   225	            source,
   226	            Span::from_offset_length(span.offset, span.length)
   227	                .ok_or_else(|| fail(ErrorKind::Number, span.offset))?,
   228	            reference,
   229	        )
   230	        .map_err(|_| fail(ErrorKind::Number, span.offset))?;
   231	    }
   232	    if !seen[2] || !seen[3] || values[2] < 0. || values[3] < 0. {
   233	        return Err(fail(
   234	            ErrorKind::Number,
   235	            tokens.get(element).map_or(0, |t| t.name.offset),
   236	        ));
   237	    }
   238	    let mut g = ImageGeometry {
   239	        x: values[0],
   240	        y: values[1],
   241	        width: values[2],
   242	        height: values[3],
   243	        draw_x: values[0],
   244	        draw_y: values[1],
   245	        draw_width: values[2],
   246	        draw_height: values[3],
   247	    };
   248	    if let Some([pw, ph]) = pixel_size {
   249	        if pw == 0 || ph == 0 {
   250	            return Err(fail(ErrorKind::Unsupported, tokens[element].name.offset));
   251	        }
   252	        if !aspect.none {
   253	            let sx = g.width / pw as f64;
   254	            let sy = g.height / ph as f64;
   255	            let scale = if aspect.slice { sx.max(sy) } else { sx.min(sy) };
   256	            g.draw_width = pw as f64 * scale;
   257	            g.draw_height = ph as f64 * scale;
   258	            g.draw_x += (g.width - g.draw_width) * aspect.align_x;
   259	            g.draw_y += (g.height - g.draw_height) * aspect.align_y;
   260	        }
   261	    }
   262	    if [
   263	        g.x,
   264	        g.y,
   265	        g.width,
   266	        g.height,
   267	        g.draw_x,
   268	        g.draw_y,
   269	        g.draw_width,
   270	        g.draw_height,
   271	    ]
   272	    .iter()
   273	    .any(|n| !n.is_finite())
   274	    {
   275	        return Err(fail(ErrorKind::Number, tokens[element].name.offset));
   276	    }
   277	    let right = g.x + g.width;
   278	    let bottom = g.y + g.height;
   279	    if [g.x, g.y, right, bottom]
   280	        .iter()
   281	        .any(|v| v.abs() > 1_000_000.)
   282	    {
   283	        return Err(fail(ErrorKind::Number, tokens[element].name.offset));
   284	    }
   285	    Ok(g)
   286	}
