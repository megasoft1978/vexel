   259	impl MediaProvider for Fixture {
   260	    fn layout_text(
   261	        &mut self,
   262	        request: TextRequest<'_>,
   263	        _: &mut dyn WorkControl,
   264	    ) -> Result<TextLayout, MediaError> {
   265	        self.layouts += 1;
   266	        let glyphs = request.text.iter().filter(|b| **b & 0xc0 != 0x80).count();
   267	        Ok(TextLayout {
   268	            glyphs: (0..glyphs)
   269	                .map(|i| TextGlyph {
   270	                    glyph_id: None,
   271	                    x: i as f64 * 8.,
   272	                    y: 0.,
   273	                    advance: 8.,
   274	                    commands: TableRange::EMPTY,
   275	                })
   276	                .collect(),
   277	            commands: Vec::new(),
   278	            advance_width: glyphs as f64 * 8.,
   279	            ascent: 9.,
   280	            descent: 3.,
   281	            leading: 0.,
   282	        })
   283	    }
   284	    fn decode_image(
   285	        &mut self,
   286	        _: &[u8],
   287	        _: &mut dyn WorkControl,
