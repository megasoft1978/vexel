   180	/// Accept only the two frozen inline URI headers, with no external lookup.
   181	pub fn parse_data_uri(source: &[u8], uri: XmlSpan) -> Result<ImagePayload> {
   182	    let bytes =
   183	        valid_span(source, uri).ok_or_else(|| fail(ErrorKind::InvalidArgument, uri.offset))?;
   184	    let comma = bytes
   185	        .iter()
   186	        .position(|&b| b == b',')
   187	        .ok_or_else(|| fail(ErrorKind::Unsupported, uri.offset))?;
   188	    let mime = match &bytes[..comma] {
   189	        b"data:image/png;base64" => ImageMime::Png,
   190	        b"data:image/jpeg;base64" => ImageMime::Jpeg,
   191	        _ => return Err(fail(ErrorKind::Unsupported, uri.offset)),
   192	    };
   193	    if comma + 1 == bytes.len() {
   194	        return Err(fail(ErrorKind::Unsupported, uri.offset));
   195	    }
   196	    Ok(ImagePayload {
   197	        mime,
   198	        encoded: XmlSpan {
   199	            offset: uri.offset + comma + 1,
   200	            length: bytes.len() - comma - 1,
   201	        },
   202	    })
   203	}
