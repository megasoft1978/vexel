   311	/// Work-accounting helper for consumers that traverse outline verbs.
   312	pub fn charge_outline(control: &mut dyn WorkControl, units: usize) -> Result<()> {
   313	    control
   314	        .charge(
   315	            WorkKind::Media,
   316	            u64::try_from(units).map_err(|_| Diagnostic {
   317	                kind: ErrorKind::Limit(LimitKind::Arithmetic),
   318	                offset: 0,
