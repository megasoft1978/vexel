     5	/// Sample one placed image at a document-space point using the frozen half-open
     6	/// bounds and bilinear interpolation of premultiplied RGBA8 pixels. Returned
     7	/// color is straight RGBA8 for the compositor, with nearest-integer rounding.
     8	pub fn sample_image(
     9	    image: &ImagePixels,
    10	    geometry: ImageGeometry,
    11	    inverse_transform: Affine,
    12	    x: f64,
    13	    y: f64,
    14	) -> Option<[u8; 4]> {
    15	    if image.validate(0).is_err()
    16	        || image.width == 0
    17	        || image.height == 0
    18	        || geometry.draw_width <= 0.
    19	        || geometry.draw_height <= 0.
    20	    {
    21	        return None;
    22	    }
    23	    let local = affine_map_point(inverse_transform, Point { x, y })?;
    24	    let right = geometry.x + geometry.width;
    25	    let bottom = geometry.y + geometry.height;
    26	    let draw_right = geometry.draw_x + geometry.draw_width;
    27	    let draw_bottom = geometry.draw_y + geometry.draw_height;
    28	    if ![local.x, local.y, right, bottom, draw_right, draw_bottom]
    29	        .iter()
    30	        .all(|v| v.is_finite())
    31	        || local.x < geometry.x
    32	        || local.y < geometry.y
    33	        || local.x >= right
    34	        || local.y >= bottom
    35	        || local.x < geometry.draw_x
    36	        || local.y < geometry.draw_y
    37	        || local.x >= draw_right
    38	        || local.y >= draw_bottom
    39	    {
    40	        return None;
    41	    }
    42	    let u = (local.x - geometry.draw_x) / geometry.draw_width;
    43	    let v = (local.y - geometry.draw_y) / geometry.draw_height;
    44	    let mut sx = u * f64::from(image.width) - 0.5;
    45	    let mut sy = v * f64::from(image.height) - 0.5;
    46	    sx = sx.clamp(0., f64::from(image.width - 1));
    47	    sy = sy.clamp(0., f64::from(image.height - 1));
    48	    let x0 = sx.floor() as u32;
    49	    let y0 = sy.floor() as u32;
    50	    let x1 = if x0 + 1 < image.width { x0 + 1 } else { x0 };
    51	    let y1 = if y0 + 1 < image.height { y0 + 1 } else { y0 };
    52	    let fx = sx - f64::from(x0);
    53	    let fy = sy - f64::from(y0);
    54	    let p00 = pixel(image, x0, y0)?;
    55	    let p10 = pixel(image, x1, y0)?;
    56	    let p01 = pixel(image, x0, y1)?;
    57	    let p11 = pixel(image, x1, y1)?;
    58	    let mut channels = [0.; 4];
    59	    for (channel, out) in channels.iter_mut().enumerate() {
    60	        let top = f64::from(p00[channel]) * (1. - fx) + f64::from(p10[channel]) * fx;
    61	        let lower = f64::from(p01[channel]) * (1. - fx) + f64::from(p11[channel]) * fx;
    62	        *out = top * (1. - fy) + lower * fy;
    63	    }
    64	    let alpha = (channels[3] + 0.5).floor().clamp(0., 255.) as u8;
    65	    if alpha == 0 {
    66	        return Some([0; 4]);
    67	    }
    68	    let mut result = [0; 4];
    69	    for channel in 0..3 {
    70	        result[channel] = (channels[channel] * 255. / channels[3] + 0.5)
    71	            .floor()
    72	            .clamp(0., 255.) as u8;
    73	    }
    74	    result[3] = alpha;
    75	    Some(result)
    76	}
    77	
    78	fn pixel(image: &ImagePixels, x: u32, y: u32) -> Option<[u8; 4]> {
    79	    let offset = (y as usize)
    80	        .checked_mul(image.row_stride)?
    81	        .checked_add((x as usize).checked_mul(4)?)?;
    82	    let end = offset.checked_add(4)?;
    83	    let pixel = image.rgba.get(offset..end)?;
    84	    Some([pixel[0], pixel[1], pixel[2], pixel[3]])
    85	}

