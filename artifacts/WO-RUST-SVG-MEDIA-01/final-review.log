   392	/// Geometry-only compatibility fixture helper. Production callers must use
   393	/// `publish_image_request` with an explicit common-style publisher.
   394	/// The host annotation is validated before parsing, provider calls, or mutation,
   395	/// then stored verbatim on the appended shape while `transform` maps geometry.
   396	pub fn decode_image_request(
   397	    request: vexel_scene::ImageDecodeRequest<'_, '_>,
   398	    builder: &mut vexel_scene::SceneBuilder,
   399	    draft: &vexel_scene::DraftToken,
   400	    control: &mut dyn WorkControl,
   401	) -> Result<vexel_scene::ShapeId> {
   402	    request.validate_source_map(builder, control)?;
