   404	        let viewport = builder.scene(request.scene)?.viewport;
   405	        let plan = image_element(
   406	            request.element,
   407	            [viewport.view_width, viewport.view_height],
   408	            request.provider,
   409	            control,
   410	        )?;
   411	        append_image_plan_mapped(
   412	            plan, request.source_map, request.scene, request.transform,
   413	            builder, draft, control, None, None,
   414	        )
   415	    })
   416	}
