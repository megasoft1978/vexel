   206	    let area = |first: usize, count: usize| path.edges[first..first + count].iter()
   207	        .map(|e| e.a.x * e.b.y - e.b.x * e.a.y).sum::<f64>();
   208	    assert!(area(0, 4) < 0. && area(4, 4) > 0., "opposite contour winding retains the hole");
   209	    for subpath in &path.subpaths {
   210	        let edges = &path.edges[subpath.first_edge..subpath.first_edge + subpath.edge_count];
   211	        assert_eq!(edges.last().unwrap().b, edges[0].a);
   212	        for pair in edges.windows(2) { assert_eq!(pair[0].b, pair[1].a); }
   213	    }
   214	    let mut fixture = Fixture::new(b"<svg><text>A</text></svg>", Limits::default());
   215	    let index = fixture.index(b"text");
   216	    let element = view(&fixture.lex, index);
   217	    let map = fixture.map(index);
   218	    let scene = fixture.builder.root_id();
   219	    let draft = fixture.builder.begin_draft(scene).unwrap();
   220	    let mut ledger = ChargeLedger::new(fixture.lex.source_owner(), 1 << 20, 8).unwrap();
   221	    render_text_request(TextDecodeRequest { element, source_map: map, end: element.end,
   222	        style: &CssPaint::initial(), transform: vexel_geometry::affine_identity(),
   223	        state: &mut TextState::default(), preserve_space: false,
   224	        provider: &mut CompoundProvider, cache: &mut TextCache::default(), scene,
   225	        ledger: &mut ledger }, &mut fixture.builder, &draft, &mut Run).unwrap();
   226	    let built = fixture.builder.scene(scene).unwrap();
   227	    assert_eq!(built.shapes[0].subpaths.count, 3);
   228	    assert_eq!(built.path_subpaths.len(), 3);
   229	    assert_eq!(built.edges, path.edges);
   230	    fixture.builder.commit_draft(&draft, &mut Run).unwrap();
   231	}
