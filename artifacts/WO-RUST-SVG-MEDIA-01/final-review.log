   442	pub(crate) fn append_image_plan_mapped(
   443	    plan: ImagePlan,
   444	    source_map: vexel_scene::SourceMap,
   445	    scene: vexel_scene::SceneId,
   446	    transform: vexel_geometry::Affine,
   447	    builder: &mut vexel_scene::SceneBuilder,
   448	    draft: &vexel_scene::DraftToken,
   449	    control: &mut dyn WorkControl,
   450	    publication: Option<(&super::publication::PublicationContext<'_, '_>, &dyn super::publication::StylePublisher)>,
   451	    admission: Option<vexel_scene::ShapeAdmission>,
   452	) -> Result<vexel_scene::ShapeId> {
   453	    let source = source_map.element;
   454	    if source.slice(builder.source_owner().as_slice()).is_none() {
   455	        return Err(fail(ErrorKind::InvalidArgument, source.start));
   456	    }
   457	    let geom = plan.geometry;
   458	    let mut image_index = None;
   459	    if let Some(pixels) = plan.pixels {
   460	        let index = builder.append_image(
   461	            scene,
   462	            vexel_scene::Image {
   463	                pixels,
   464	                x: geom.x,
   465	                y: geom.y,
   466	                width: geom.width,
   467	                height: geom.height,
   468	                draw_x: geom.draw_x,
   469	                draw_y: geom.draw_y,
   470	                draw_width: geom.draw_width,
   471	                draw_height: geom.draw_height,
   472	            },
   473	            control,
   474	        )?;
   475	        image_index = Some(index);
   476	    }
   477	    let points = [
   478	        vexel_geometry::Point {
   479	            x: geom.x,
   480	            y: geom.y,
   481	        },
   482	        vexel_geometry::Point {
   483	            x: geom.x + geom.width,
   484	            y: geom.y,
   485	        },
   486	        vexel_geometry::Point {
   487	            x: geom.x + geom.width,
   488	            y: geom.y + geom.height,
   489	        },
   490	        vexel_geometry::Point {
   491	            x: geom.x,
   492	            y: geom.y + geom.height,
   493	        },
   494	    ];
   495	    let mut edges = Vec::new();
   496	    edges
   497	        .try_reserve_exact(4)
   498	        .map_err(|_| fail(ErrorKind::OutOfMemory, plan.source.offset))?;
   499	    for i in 0..4 {
   500	        let a = vexel_geometry::affine_map_point(transform, points[i])
   501	            .ok_or_else(|| fail(ErrorKind::Number, source.start))?;
   502	        let b = vexel_geometry::affine_map_point(transform, points[(i + 1) % 4])
   503	            .ok_or_else(|| fail(ErrorKind::Number, source.start))?;
   504	        edges.push(vexel_geometry::Edge { a, b });
   505	    }
   506	    let mut subpaths = Vec::new();
   507	    subpaths
   508	        .try_reserve_exact(1)
   509	        .map_err(|_| fail(ErrorKind::OutOfMemory, plan.source.offset))?;
   510	    subpaths.push(vexel_svg_path::PathSubpath {
   511	        first_edge: 0,
   512	        edge_count: 4,
   513	        closed: true,
   514	    });
   515	    let path = vexel_svg_path::PathDocument {
   516	        edges,
   517	        subpaths,
   518	        segments: Vec::new(),
   519	        numbers: Vec::new(),
   520	    };
   521	    if let Some((context, publisher)) = publication {
   522	        return super::publication::publish_checked(publisher, context, super::publication::CustomGeometry {
   523	            path, source_map, image: image_index,
   524	            admission: admission.ok_or_else(|| fail(ErrorKind::InvalidArgument, source.start))?,
   525	        }, builder, draft, control);
   526	    }
   527	    let mut colors = Vec::new();
   528	    colors
   529	        .try_reserve_exact(4)
   530	        .map_err(|_| fail(ErrorKind::OutOfMemory, plan.source.offset))?;
   531	    colors.resize(4, [0; 4]);
   532	    let mut shape = vexel_scene::Shape::new(source_map);
   533	    shape.image = image_index;
   534	    let input = vexel_scene::ShapeInput { shape, path, edge_colors: colors };
   535	    let id = if let Some(admission) = admission {
   536	        builder.append_admitted_shape(draft, &admission, input, control)?
   537	    } else {
   538	        // Geometry-only fixture helper preserves its historical late-failure probes.
   539	        builder.append_shape(scene, input, control)?
   540	    };
   541	    let published = *builder
   542	        .scene(scene)?
   543	        .shape(id)
   544	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, source.start))?;
   545	    builder.finalize_shape(draft, id, published, control)?;
   546	    Ok(id)
   547	}
   548	fn xlink_is_bound(source: &[u8], tokens: &[XmlToken]) -> bool {
   549	    for (i, token) in tokens.iter().enumerate() {
   550	        if token.kind != TokenKind::StartElement || token.depth != 0 {
   551	            continue;
   552	        }
   553	        for attr in tokens
   554	            .get(i + 1..)
   555	            .unwrap_or_default()
   556	            .iter()
   557	            .take_while(|t| t.kind == TokenKind::Attribute)
   558	        {
   559	            if attr.name.slice(source) == Some(b"xmlns:xlink")
   560	                && attr.value.slice(source) == Some(b"http://www.w3.org/1999/xlink")
   561	            {
   562	                return true;
   563	            }
   564	        }
   565	        return false;
   566	    }
   567	    false
   568	}
   569	fn media_error(error: MediaError, offset: usize) -> Diagnostic {
   570	    let kind = match error {
   571	        MediaError::InvalidArgument
   572	        | MediaError::Unsupported
   573	        | MediaError::Invalid
   574	        | MediaError::InvalidUtf8
   575	        | MediaError::Animated
   576	        | MediaError::Corrupt => ErrorKind::Unsupported,
   577	        MediaError::Limit => ErrorKind::Limit(LimitKind::Images),
   578	        MediaError::OutOfMemory => ErrorKind::OutOfMemory,
   579	    };
   580	    fail(kind, offset)
   581	}

