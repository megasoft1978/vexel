    52	/// Find one unprefixed or explicitly prefixed attribute on a start element.
    53	pub fn attribute(
    54	    source: &[u8],
    55	    tokens: &[XmlToken],
    56	    element: usize,
    57	    end: usize,
    58	    local: &[u8],
    59	    prefix: Option<&[u8]>,
    60	) -> Option<XmlSpan> {
    61	    let token = tokens.get(element)?;
    62	    if !matches!(
    63	        token.kind,
    64	        TokenKind::StartElement | TokenKind::EmptyElement
    65	    ) {
    66	        return None;
    67	    }
    68	    for attr in tokens
    69	        .get(element + 1..end.min(tokens.len()))?
    70	        .iter()
    71	        .take_while(|t| t.kind == TokenKind::Attribute)
    72	    {
    73	        if !span_is(source, attr.local_name, local) {
    74	            continue;
    75	        }
    76	        let has_prefix = attr.prefix.length != 0;
    77	        if match prefix {
    78	            None => !has_prefix,
    79	            Some(p) => has_prefix && span_is(source, attr.prefix, p),
    80	        } {
    81	            return Some(attr.value);
    82	        }
    83	    }
    84	    None
    85	}
