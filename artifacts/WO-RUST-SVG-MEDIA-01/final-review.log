    88	#[test]
    89	fn image_geometry_preserves_meet_slice_none_and_viewport_lengths() {
    90	    let source = b"<image x=\"10%\" y=\"2\" width=\"4\" height=\"2\"/>";
    91	    let (tokens, _) = vexel_xml::tokenize(source, XmlLimits::default());
    92	    let elem = tokens
    93	        .iter()
    94	        .position(|t| t.kind == TokenKind::EmptyElement)
    95	        .unwrap();
    96	    let meet = image_geometry(
    97	        source,
    98	        &tokens,
    99	        elem,
   100	        tokens.len(),
   101	        [100., 20.],
   102	        Some([2, 2]),
   103	        vexel_svg_values::Aspect::default(),
   104	    )
   105	    .unwrap();
   106	    assert_eq!(
   107	        [
   108	            meet.x,
   109	            meet.y,
   110	            meet.draw_x,
   111	            meet.draw_width,
   112	            meet.draw_height
   113	        ],
   114	        [10., 2., 11., 2., 2.]
   115	    );
   116	    let slice = image_geometry(
   117	        source,
   118	        &tokens,
   119	        elem,
   120	        tokens.len(),
   121	        [100., 20.],
   122	        Some([2, 2]),
   123	        vexel_svg_values::Aspect {
   124	            slice: true,
   125	            ..Default::default()
   126	        },
   127	    )
   128	    .unwrap();
   129	    assert_eq!(
   130	        [slice.draw_x, slice.draw_width, slice.draw_height],
   131	        [10., 4., 4.]
   132	    );
   133	    let none = image_geometry(
   134	        source,
   135	        &tokens,
   136	        elem,
   137	        tokens.len(),
   138	        [100., 20.],
   139	        Some([2, 2]),
   140	        vexel_svg_values::Aspect {
   141	            none: true,
   142	            ..Default::default()
   143	        },
   144	    )
   145	    .unwrap();
   146	    assert_eq!(
   147	        [none.draw_x, none.draw_y, none.draw_width, none.draw_height],
   148	        [10., 2., 4., 2.]
   149	    );
   150	    let invalid = b"<image width=\"-1\" height=\"2\"/>";
   151	    let (bad_tokens, _) = vexel_xml::tokenize(invalid, XmlLimits::default());
   152	    let bad_elem = bad_tokens
   153	        .iter()
   154	        .position(|t| t.kind == TokenKind::EmptyElement)
   155	        .unwrap();
   156	    assert!(
   157	        image_geometry(
   158	            invalid,
   159	            &bad_tokens,
   160	            bad_elem,
   161	            bad_tokens.len(),
   162	            [8., 8.],
   163	            None,
   164	            Default::default()
   165	        )
   166	        .is_err()
   167	    );
   168	}
