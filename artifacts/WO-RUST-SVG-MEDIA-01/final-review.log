   214	fn try_key(request: TextRequest<'_>) -> Option<TextCacheKey> {
   215	    let mut text = Vec::new();
   216	    text.try_reserve_exact(request.text.len()).ok()?;
   217	    text.extend_from_slice(request.text);
   218	    let mut families = Vec::new();
   219	    families
   220	        .try_reserve_exact(request.font_families.len())
   221	        .ok()?;
   222	    for family in request.font_families {
   223	        let mut copy = Vec::new();
   224	        copy.try_reserve_exact(family.len()).ok()?;
   225	        copy.extend_from_slice(family);
   226	        families.push(copy);
   227	    }
   228	    Some(TextCacheKey {
   229	        text,
   230	        families,
   231	        size_points: request.size_points,
   232	        weight: request.weight,
   233	        letter_spacing_points: request.letter_spacing_points,
   234	        style: request.style,
   235	    })
   236	}
   237	fn validate_layout(
   238	    layout: &TextLayout,
   239	    offset: usize,
   240	    control: &mut dyn WorkControl,
   241	) -> Result<()> {
   242	    let invalid = || Diagnostic {
   243	        kind: ErrorKind::Unsupported,
   244	        offset,
   245	    };
   246	    if layout.glyphs.len() > MAX_GLYPHS
   247	        || layout.commands.len() > MAX_PATH_COMMANDS
   248	        || !layout.advance_width.is_finite()
   249	    {
   250	        return Err(Diagnostic {
   251	            kind: ErrorKind::Limit(LimitKind::TextCommands),
   252	            offset,
   253	        });
   254	    }
   255	    for glyph in &layout.glyphs {
   256	        control
   257	            .charge(WorkKind::Media, 1)
   258	            .map_err(|stop| work_error(stop, offset))?;
   259	        let end = glyph
   260	            .commands
   261	            .first
   262	            .checked_add(glyph.commands.count)
   263	            .ok_or_else(|| invalid())?;
   264	        if !glyph.x.is_finite()
   265	            || !glyph.y.is_finite()
   266	            || !glyph.advance.is_finite()
   267	            || end > layout.commands.len()
   268	        {
   269	            return Err(invalid());
   270	        }
   271	    }
   272	    for command in &layout.commands {
   273	        control
   274	            .charge(WorkKind::Media, 1)
   275	            .map_err(|stop| work_error(stop, offset))?;
   276	        if command.values.iter().any(|v| !v.is_finite()) {
   277	            return Err(invalid());
   278	        }
   279	    }
   280	    Ok(())
   281	}
   282	fn work_error(stop: vexel_base::Stop, offset: usize) -> Diagnostic {
   283	    Diagnostic {
   284	        kind: match stop {
   285	            vexel_base::Stop::Canceled => ErrorKind::Canceled,
   286	            vexel_base::Stop::Limit => ErrorKind::Limit(LimitKind::Work),
   287	            vexel_base::Stop::Overflow => ErrorKind::Limit(LimitKind::Arithmetic),
   288	        },
   289	        offset,
   290	    }
   291	}
   292	fn provider_error(error: MediaError, offset: usize) -> Diagnostic {
   293	    let kind = match error {
   294	        MediaError::Limit => ErrorKind::Limit(LimitKind::TextCommands),
   295	        MediaError::OutOfMemory => ErrorKind::OutOfMemory,
   296	        MediaError::InvalidArgument
   297	        | MediaError::Unsupported
   298	        | MediaError::Invalid
   299	        | MediaError::InvalidUtf8
   300	        | MediaError::Animated
   301	        | MediaError::Corrupt => ErrorKind::Unsupported,
   302	    };
   303	    Diagnostic { kind, offset }
   304	}
