   413	struct BadPublication { prefix: ShapeId, wrong_source: Option<SourceMap> }
   414	impl StylePublisher for BadPublication {
   415	    fn begin(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
   416	        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {Ok(())}
   417	    fn prepare_geometry(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
   418	        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {Ok(())}
   419	    fn prepare_admitted_geometry(&self, _: &PublicationContext<'_, '_>, _: &mut SceneBuilder,
   420	        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> { Ok(()) }
   421	    fn publish(&self, _c: &PublicationContext<'_, '_>, g: CustomGeometry, b: &mut SceneBuilder,
   422	        d: &DraftToken, control: &mut dyn WorkControl) -> Result<ShapeId> {
   423	        if let Some(source)=self.wrong_source {
   424	            let colors=vec![[255,0,0,255];g.path.edges.len()];
   425	            let mut shape=Shape::new(source);shape.image=g.image;
   426	            b.append_admitted_shape(d, &g.admission,ShapeInput{shape,path:g.path,edge_colors:colors},control)
   427	        }else{Ok(self.prefix)}
   428	    }
   429	    fn finish(&self, _: &PublicationContext<'_, '_>, _: usize, _: &mut SceneBuilder,
   430	        _: &DraftToken, _: &mut dyn WorkControl) -> Result<()> {Ok(())}
   431	}
