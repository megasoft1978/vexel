   170	#[test]
   171	fn text_entities_whitespace_and_position_lists_match_source_contract() {
   172	    let source = b" A &amp;  B ";
   173	    let mut state = vexel_scene::TextState::default();
   174	    let value = normalize_text(
   175	        source,
   176	        XmlSpan {
   177	            offset: 0,
   178	            length: source.len(),
   179	        },
   180	        false,
   181	        &mut state,
   182	    )
   183	    .unwrap();
   184	    assert_eq!(value, b"A & B");
   185	    let preserved = normalize_text(
   186	        source,
   187	        XmlSpan {
   188	            offset: 0,
   189	            length: source.len(),
   190	        },
   191	        true,
   192	        &mut state,
   193	    )
   194	    .unwrap();
   195	    assert_eq!(preserved, b" A &  B ");
   196	    let positions = b"1, 2 3.5%";
   197	    assert_eq!(
   198	        parse_position_list(
   199	            positions,
   200	            XmlSpan {
   201	                offset: 0,
   202	                length: positions.len()
   203	            },
   204	            200.
   205	        )
   206	        .unwrap(),
   207	        [1., 2., 7.]
   208	    );
   209	    for bad in [b"".as_slice(), b",1", b"1,,2", b"1,"] {
   210	        assert!(
   211	            parse_position_list(
   212	                bad,
   213	                XmlSpan {
   214	                    offset: 0,
   215	                    length: bad.len()
   216	                },
   217	                20.
   218	            )
   219	            .is_err()
   220	        );
   221	    }
   222	    let capped =
   223	        std::iter::repeat_n("1 ", vexel_svg_media::MAX_POSITION_VALUES + 1).collect::<String>();
   224	    let cap_error = parse_position_list(
   225	        capped.as_bytes(),
   226	        XmlSpan {
   227	            offset: 0,
   228	            length: capped.len(),
   229	        },
   230	        8.,
   231	    )
   232	    .unwrap_err();
   233	    assert_eq!(
   234	        cap_error.kind,
   235	        vexel_scene::ErrorKind::Number
   236	    );
   237	    assert_eq!(cap_error.offset, vexel_svg_media::MAX_POSITION_VALUES * 2);
   238	    let bad_entity = b"&#x110000;";
   239	    assert_eq!(
   240	        normalize_text(
   241	            bad_entity,
   242	            XmlSpan {
   243	                offset: 0,
   244	                length: bad_entity.len()
   245	            },
   246	            true,
   247	            &mut vexel_scene::TextState::default()
   248	        )
   249	        .unwrap_err()
   250	        .offset,
   251	        0
   252	    );
   253	}
