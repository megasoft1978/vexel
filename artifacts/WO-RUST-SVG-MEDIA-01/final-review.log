   224	                return Err(fail(ErrorKind::Unsupported, span.offset + i));
   225	            }
   226	            i += 1;
   227	        }
   228	        if i < bytes.len() {
   229	            i += 1;
   230	        }
   231	    }
   232	    if families.is_empty() {
   233	        Err(fail(ErrorKind::Unsupported, span.offset))
   234	    } else {
   235	        Ok((families, spans))
   236	    }
   237	}
