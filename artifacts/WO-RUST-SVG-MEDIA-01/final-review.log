    87	pub fn base64_value(byte: u8) -> Option<u8> {
    88	    match byte {
    89	        b'A'..=b'Z' => Some(byte - b'A'),
    90	        b'a'..=b'z' => Some(byte - b'a' + 26),
    91	        b'0'..=b'9' => Some(byte - b'0' + 52),
    92	        b'+' => Some(62),
    93	        b'/' => Some(63),
    94	        _ => None,
    95	    }
    96	}
