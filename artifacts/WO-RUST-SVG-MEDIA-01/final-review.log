   313	        let s=f.builder.scene(scene).unwrap();
   314	        assert_eq!(s.shapes.len(),1); assert_eq!(s.shape(prefix),Some(&old_shape));
   315	        assert_eq!(s.edges,old_edges); assert!(s.images.is_empty());
   316	        assert!(s.clips.is_empty());assert!(s.groups.is_empty());
   317	        assert_eq!((state.cursor_x,state.text_bytes,state.glyph_count),
   318	            (before.cursor_x,before.text_bytes,before.glyph_count));
   319	        assert!(cache.entries.is_empty());assert_eq!((cache.commands,cache.text_bytes),(0,0));
   320	        assert_eq!(f.builder.document_text_commands(),0);
   321	        // No caller rollback: the same real draft accepts another actual shape.
   322	        f.builder.append_shape(scene,f.prefix_input(),&mut Run).unwrap();
   323	        f.builder.commit_draft(&draft,&mut Run).unwrap();
   324	    }}
   325	}
