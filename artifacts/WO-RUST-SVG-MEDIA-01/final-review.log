    20	        .map_err(|_| error(ErrorKind::Number, v.span.offset))? / if percent {100.} else {1.};
    21	    if !(0. ..=1.).contains(&n) { return Err(error(ErrorKind::Number, v.span.offset)); }
    22	    Ok(n)
