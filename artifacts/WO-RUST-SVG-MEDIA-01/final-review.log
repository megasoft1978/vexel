    32	#[test]
    33	fn image_data_uri_and_base64_keep_exact_grammar_and_offsets() {
    34	    let source = b"data:image/png;base64,AQID";
    35	    let uri = XmlSpan {
    36	        offset: 0,
    37	        length: source.len(),
    38	    };
    39	    let payload = parse_data_uri(source, uri).unwrap();
    40	    assert_eq!(payload.mime, vexel_svg_media::ImageMime::Png);
    41	    let mut control = NoStop;
    42	    assert_eq!(
    43	        decode_base64(source, payload.encoded, &mut control).unwrap(),
    44	        [1, 2, 3]
    45	    );
    46	    let malformed = b"AQ!D";
    47	    assert_eq!(
    48	        decode_base64(
    49	            malformed,
    50	            XmlSpan {
    51	                offset: 0,
    52	                length: 4
    53	            },
    54	            &mut control
    55	        )
    56	        .unwrap_err()
    57	        .kind,
    58	        vexel_scene::ErrorKind::Unsupported
    59	    );
    60	    assert_eq!(
    61	        parse_data_uri(
    62	            b"https://host/x.png",
    63	            XmlSpan {
    64	                offset: 0,
    65	                length: 18
    66	            }
    67	        )
    68	        .unwrap_err()
    69	        .offset,
    70	        0
    71	    );
    72	    assert!(
    73	        decode_base64(
    74	            b"A",
    75	            XmlSpan {
    76	                offset: 0,
    77	                length: 1
    78	            },
    79	            &mut control
    80	        )
    81	        .is_err()
    82	    );
    83	    let stopped = decode_base64(source, payload.encoded, &mut StopOnCharge).unwrap_err();
    84	    assert_eq!(stopped.kind, vexel_scene::ErrorKind::Canceled);
    85	    assert_eq!(stopped.offset, payload.encoded.offset);
    86	}
