        let mut provider = FailingProvider { inner: Provider::default(), calls: 0, failure };
        let error = render_text_request(TextDecodeRequest { element, source_map: map, end: element.end,
            style: &CssPaint::initial(), transform: vexel_geometry::affine_identity(),
            state: &mut state, preserve_space: false, provider: &mut provider,
            cache: &mut cache, scene, ledger: &mut ledger },
            &mut fixture.builder, &draft, &mut Run).unwrap_err();
        assert_eq!((error.kind, error.offset), (failure.map_or(ErrorKind::Unsupported, |e| expected(e, true)), offset));
        assert_eq!(provider.calls, 2);
