   239	/// Apply the frozen CSS-to-CoreText style conversion and SVG defaults.
   240	pub fn parse_text_style(
   241	    source: &[u8],
   242	    style: &CssPaint<'_>,
   243	    viewport: [f64; 2],
   244	) -> Result<TextStyleValues> {
   245	    // Keep the original failure order and Unsupported classification. Position
   246	    // attributes use Number errors; font style values do not.
   247	    let size = parse_size(source, style, viewport[1])?;
   248	    let weight = parse_weight(source, style)?;
   249	    let (families, family_spans) = parse_families_with_spans(source, style)?;
   250	    let letter_spacing = parse_spacing(source, style, Property::LetterSpacing, viewport[0])?;
   251	    let word_spacing = parse_spacing(source, style, Property::WordSpacing, viewport[0])?;
   252	    let text_style = if let Some(v) = style.value(Property::FontStyle) {
   253	        if v.bytes.eq_ignore_ascii_case(b"normal") {
   254	            TextStyle::Normal
   255	        } else if v.bytes.eq_ignore_ascii_case(b"italic") {
   256	            TextStyle::Italic
   257	        } else if v.bytes.eq_ignore_ascii_case(b"oblique") {
   258	            TextStyle::Oblique
   259	        } else {
   260	            return Err(fail(ErrorKind::Unsupported, v.span.offset));
   261	        }
   262	    } else {
   263	        TextStyle::Normal
   264	    };
   265	    let anchor = if let Some(v) = style.value(Property::TextAnchor) {
   266	        if v.bytes.eq_ignore_ascii_case(b"start") {
   267	            vexel_scene::TextAnchor::Start
   268	        } else if v.bytes.eq_ignore_ascii_case(b"middle") {
   269	            vexel_scene::TextAnchor::Middle
   270	        } else if v.bytes.eq_ignore_ascii_case(b"end") {
   271	            vexel_scene::TextAnchor::End
   272	        } else {
   273	            return Err(fail(ErrorKind::Unsupported, v.span.offset));
   274	        }
   275	    } else {
   276	        vexel_scene::TextAnchor::Start
   277	    };
   278	    Ok(TextStyleValues {
   279	        families,
   280	        family_spans,
   281	        size_points: size * 0.75,
   282	        weight,
   283	        style: text_style,
   284	        anchor,
   285	        letter_spacing_points: letter_spacing * 0.75,
   286	        word_spacing,
   287	    })
   288	}
   289	
   290	pub fn parse_xml_space(
   291	    source: &[u8],
   292	    tokens: &[XmlToken],
   293	    element: usize,
   294	    end: usize,
   295	    parent_preserve: bool,
   296	) -> Result<bool> {
   297	    let token = tokens
   298	        .get(element)
   299	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, 0))?;
   300	    for attr in tokens
   301	        .get(element + 1..end.min(tokens.len()))
   302	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, token.name.offset))?
   303	        .iter()
   304	        .take_while(|t| t.kind == vexel_xml::TokenKind::Attribute)
   305	    {
   306	        if attr.local_name.slice(source) != Some(b"space")
   307	            || attr.prefix.slice(source) != Some(b"xml")
   308	        {
   309	            continue;
   310	        }
   311	        return match attr.value.slice(source) {
   312	            Some(v) if v.eq_ignore_ascii_case(b"preserve") => Ok(true),
   313	            Some(v) if v.eq_ignore_ascii_case(b"default") => Ok(false),
   314	            _ => Err(fail(ErrorKind::Unsupported, attr.value.offset)),
   315	        };
   316	    }
   317	    Ok(parent_preserve)
   318	}
   319	
   320	/// Legacy helper name retained as a public pure operation for parity.
   321	pub fn text_span_equal(source: &[u8], span: XmlSpan, literal: &[u8]) -> bool {
   322	    span.slice(source) == Some(literal)
   323	}
   324	
   325	pub fn text_attribute(
   326	    source: &[u8],
   327	    tokens: &[XmlToken],
   328	    element: usize,
   329	    end: usize,
   330	    local: &[u8],
   331	    prefix: Option<&[u8]>,
   332	) -> Option<XmlSpan> {
   333	    super::image::attribute(source, tokens, element, end, local, prefix)
   334	}
   335	
   336	pub fn parse_size(source: &[u8], style: &CssPaint<'_>, viewport_height: f64) -> Result<f64> {
   337	    let Some(v) = style.value(Property::FontSize) else {
   338	        return Ok(16.);
   339	    };
   340	    let value = vexel_svg_values::parse_length(
   341	        source,
   342	        Span::from_offset_length(v.span.offset, v.span.length)
   343	            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
   344	        viewport_height,
   345	    )
   346	    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
   347	    if value <= 0. {
   348	        return Err(fail(ErrorKind::Unsupported, v.span.offset));
   349	    }
   350	    Ok(value)
   351	}
   352	
   353	pub fn parse_weight(source: &[u8], style: &CssPaint<'_>) -> Result<f64> {
   354	    let Some(v) = style.value(Property::FontWeight) else {
   355	        return Ok(400.);
   356	    };
   357	    if v.bytes.eq_ignore_ascii_case(b"normal") {
   358	        return Ok(400.);
   359	    }
   360	    if v.bytes.eq_ignore_ascii_case(b"bold") {
   361	        return Ok(700.);
   362	    }
   363	    let n = vexel_svg_values::parse_number(
   364	        source,
   365	        Span::from_offset_length(v.span.offset, v.span.length)
   366	            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
   367	    )
   368	    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))?;
   369	    if !(100. ..=900.).contains(&n) || n % 100. != 0. {
   370	        return Err(fail(ErrorKind::Unsupported, v.span.offset));
   371	    }
   372	    Ok(n)
   373	}
   374	
   375	pub fn parse_spacing(
   376	    source: &[u8],
   377	    style: &CssPaint<'_>,
   378	    property: Property,
   379	    reference: f64,
   380	) -> Result<f64> {
   381	    let Some(v) = style.value(property) else {
   382	        return Ok(0.);
   383	    };
   384	    if v.bytes.eq_ignore_ascii_case(b"normal") {
   385	        return Ok(0.);
   386	    }
   387	    vexel_svg_values::parse_length(
   388	        source,
   389	        Span::from_offset_length(v.span.offset, v.span.length)
   390	            .ok_or_else(|| fail(ErrorKind::Unsupported, v.span.offset))?,
   391	        reference,
   392	    )
   393	    .map_err(|_| fail(ErrorKind::Unsupported, v.span.offset))
   394	}
                &dy,
                [start_x, start_y],
                anchor_offset,
                values.word_spacing,
                transform,
                control,
            )?;
            if !path.edges.is_empty() {
                if let Some((context, publisher)) = publication {
                    super::publication::publish_checked(publisher, context, super::publication::CustomGeometry {
                        path, source_map, image: None, admission,
                    }, builder, draft, control)?;
                } else {
                    let mut colors = Vec::new();
                    colors
                        .try_reserve_exact(path.edges.len())
                        .map_err(|_| fail(ErrorKind::OutOfMemory, token.value.offset))?;
                    colors.resize(path.edges.len(), [0; 4]);
                    let mut shape = vexel_scene::Shape::new(source_map);
                    shape.filled = true;
                    let id = builder.append_admitted_shape(
                        draft, &admission,
                        vexel_scene::ShapeInput {
                            shape,
                            path,
                            edge_colors: colors,
                        },
                        control,
                    )?;
                    let published = *builder
                        .scene(scene)?
                        .shape(id)
                        .ok_or_else(|| fail(ErrorKind::InvalidArgument, source_map.element.start))?;
                    builder.finalize_shape(draft, id, published, control)?;
                }
            } else {
                builder.cancel_shape_admission(draft, &admission)?;
            }
        }
        state.cursor_x =
            start_x + layout.advance_width * (96. / 72.) + spaces as f64 * values.word_spacing;
        state.cursor_y = start_y;
        state.has_position = true;
    }
    Ok(preserve)
}

fn parse_positions_if_present(
    source: &[u8],
    tokens: &[XmlToken],
    element: usize,
    end: usize,
    name: &[u8],
    reference: f64,
) -> Result<Vec<f64>> {
    match text_attribute(source, tokens, element, end, name, None) {
        Some(span) => parse_position_list(source, span, reference),
        None => Ok(Vec::new()),
    }
}

fn append_text_edge(
    from: vexel_geometry::Point,
    to: vexel_geometry::Point,
    transform: vexel_geometry::Affine,
    edges: &mut Vec<vexel_geometry::Edge>,
    control: &mut dyn WorkControl,
) -> Result<()> {
    vexel_svg_path::append_edge(
        from,
        to,
        transform,
        vexel_svg_path::MAX_PATH_EDGES,
        0,
        edges,
    )
    .map_err(path_error)?;
    control
        .charge(vexel_base::WorkKind::Edge, 1)
        .map_err(stopped)
}

