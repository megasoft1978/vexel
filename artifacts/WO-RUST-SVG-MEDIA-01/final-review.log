   317	/// Parse one SVG image element and ask the explicit provider to decode inline
   318	/// PNG/JPEG bytes. Zero-area images retain geometry and do not invoke a provider.
   319	pub fn image_element(
   320	    view: vexel_scene::ElementView<'_>,
   321	    viewport: [f64; 2],
   322	    provider: &mut dyn MediaProvider,
   323	    control: &mut dyn WorkControl,
   324	) -> Result<ImagePlan> {
   325	    view.validate(control)?;
   326	    let source = view.source();
   327	    let tokens = view.tokens();
   328	    let element = view.element.0;
   329	    let end = view.end;
   330	    let token = tokens
   331	        .get(element)
   332	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, 0))?;
   333	    let name = token.name;
   334	    let base_geometry = image_geometry(
   335	        source,
   336	        tokens,
   337	        element,
   338	        end,
   339	        viewport,
   340	        None,
   341	        vexel_svg_values::Aspect::default(),
   342	    )?;
   343	    if base_geometry.width == 0. || base_geometry.height == 0. {
   344	        return Ok(ImagePlan {
   345	            geometry: base_geometry,
   346	            pixels: None,
   347	            source: token.source,
   348	        });
   349	    }
   350	    let plain = attribute(source, tokens, element, end, b"href", None);
   351	    let xlink = attribute(source, tokens, element, end, b"href", Some(b"xlink"));
   352	    let href = match (plain, xlink) {
   353	        (Some(_), Some(v)) => return Err(fail(ErrorKind::Unsupported, v.offset)),
   354	        (Some(v), None) => v,
   355	        (None, Some(v)) if xlink_is_bound(source, tokens) => v,
   356	        (None, Some(v)) => return Err(fail(ErrorKind::Unsupported, v.offset)),
   357	        (None, None) => return Err(fail(ErrorKind::Unsupported, name.offset)),
   358	    };
   359	    let payload = parse_data_uri(source, href)?;
   360	    let encoded = decode_base64(source, payload.encoded, control)?;
   361	    let pixels = decode_image(provider, &encoded, payload.encoded.offset, control)?;
   362	    let aspect =
   363	        if let Some(span) = attribute(source, tokens, element, end, b"preserveAspectRatio", None) {
   364	            vexel_svg_values::parse_preserve_aspect(
   365	                source,
   366	                Span::from_offset_length(span.offset, span.length)
   367	                    .ok_or_else(|| fail(ErrorKind::Unsupported, span.offset))?,
   368	            )
   369	            .map_err(|_| fail(ErrorKind::Unsupported, span.offset))?
   370	        } else {
   371	            vexel_svg_values::Aspect {
   372	                set: true,
   373	                ..Default::default()
   374	            }
   375	        };
   376	    let geometry = image_geometry(
   377	        source,
   378	        tokens,
   379	        element,
   380	        end,
   381	        viewport,
   382	        Some([pixels.width, pixels.height]),
   383	        aspect,
   384	    )?;
   385	    Ok(ImagePlan {
   386	        geometry,
   387	        pixels: Some(pixels),
   388	        source: token.source,
   389	    })
   390	}
