     3	
     4	/// Keep request cleanup independent of cancellation. A failed commit still
     5	/// owns its request token, so scene validation failures follow the same path.
     6	pub(crate) fn atomic_request<T>(
     7	    builder: &mut SceneBuilder,
     8	    draft: &DraftToken,
     9	    control: &mut dyn WorkControl,
    10	    operation: impl FnOnce(&mut SceneBuilder, &mut dyn WorkControl, RequestToken) -> Result<T>,
    11	) -> Result<T> {
    12	    let token = builder.begin_request(draft, control)?;
    13	    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
    14	        operation(builder, control, token).and_then(|value| {
    15	        builder.commit_request(draft, token, control)?;
    16	        Ok(value)
    17	        })
    18	    }));
    19	    let result = match outcome {
    20	        Ok(result) => result,
    21	        Err(panic) => {
    22	            // No cancellation polling during recovery, including abandoned leases.
    23	            let _ = builder.rollback_request(draft, token);
    24	            std::panic::resume_unwind(panic);
    25	        }
    26	    };
    27	    if result.is_err() {
    28	        builder.rollback_request(draft, token)?;
    29	    }
    30	    result
    31	}
