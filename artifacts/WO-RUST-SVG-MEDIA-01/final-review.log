    40	/// Decode entities then preserve or collapse XML whitespace with tspan state.
    41	pub fn normalize_text(
    42	    source: &[u8],
    43	    raw: XmlSpan,
    44	    preserve: bool,
    45	    state: &mut TextState,
    46	) -> Result<Vec<u8>> {
    47	    let input = raw
    48	        .slice(source)
    49	        .ok_or_else(|| fail(ErrorKind::InvalidArgument, raw.offset))?;
    50	    let mut decoded = Vec::new();
    51	    decoded
    52	        .try_reserve_exact(input.len())
    53	        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    54	    decoded.resize(input.len(), 0);
    55	    let length = vexel_xml::decode_attribute_value(source, raw, &mut decoded)
    56	        .map_err(|offset| fail(ErrorKind::Unsupported, raw.offset.saturating_add(offset)))?;
    57	    decoded.truncate(length);
    58	    if preserve {
    59	        if !decoded.is_empty() {
    60	            state.has_position = true;
    61	        }
    62	        return Ok(decoded);
    63	    }
    64	    let mut result = Vec::new();
    65	    result
    66	        .try_reserve_exact(decoded.len())
    67	        .map_err(|_| fail(ErrorKind::OutOfMemory, raw.offset))?;
    68	    for byte in decoded {
    69	        if whitespace(byte) {
    70	            if state.has_position || !result.is_empty() {
    71	                state.pending_space = true;
    72	            }
    73	            continue;
    74	        }
    75	        if state.pending_space && (state.has_position || !result.is_empty()) {
    76	            result.push(b' ');
    77	        }
    78	        state.pending_space = false;
    79	        result.push(byte);
    80	        state.has_position = true;
    81	    }
    82	    Ok(result)
    83	}
