            &mut fixture.builder, &draft, &mut Run).unwrap_err();
        assert_eq!((error.kind, error.offset), (failure.map_or(ErrorKind::Unsupported, |e| expected(e, true)), offset));
        assert_eq!(provider.calls, 2);
        assert_eq!(state_value(state), state_value(TextState::default()));
        assert_eq!((cache.entries.len(), cache.text_bytes, cache.commands), (0, 0, 0));
        assert_eq!(fixture.builder.document_text_commands(), 0);
        assert_eq!(fixture.builder.scene(scene).unwrap().shapes.len(), 1);
        assert!(fixture.builder.scene(scene).unwrap().shape(prefix).is_some());
        fixture.builder.commit_draft(&draft, &mut Run).unwrap();
    }
}

