  "operations": [
    {
      "owner": "MEDIA",
      "name": "text/image builders",
      "signature": "fn text(element: ElementView<'_>, end: usize, style: &CssPaint<'_>, transform: Affine, state: &mut TextState, preserve_space: bool, provider: &mut dyn MediaProvider, cache: &mut TextCache, builder: &mut SceneBuilder, control: &mut dyn WorkControl) -> Result<bool>; fn image(element: ElementView<'_>, style: &CssPaint<'_>, transform: Affine, provider: &mut dyn MediaProvider, builder: &mut SceneBuilder, control: &mut dyn WorkControl) -> Result<ShapeId>",
      "contract": "Preserve tspan state/x-y-dx-dy, entities, whitespace, font fallback/style/anchor/spacing, source mapping; image exact PNG/JPEG data URI grammar and bilinear premultiplied sample placement/meet/slice. TextCache owns key text and family bytes/spans within source lifetime plus owned layouts; caller borrows cache hits, no multiple release. No product deterministic fake provider."
    }
