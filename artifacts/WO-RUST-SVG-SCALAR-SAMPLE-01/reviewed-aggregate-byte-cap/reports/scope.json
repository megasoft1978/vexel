      "owner": "RASTER_SAMPLE",
      "name": "dash and grid",
      "signature": "fn build_dash_cache(view: SceneView<'_>, local_edges: &[Edge], seams: &[bool], control: &mut dyn WorkControl) -> Result<DashCache>; fn build_stroke_grid(view: SceneView<'_>, cache: &mut DashCache, control: &mut dyn WorkControl) -> Result<()>; fn grid_lookup(range: &DashRange, x: f64, y: f64) -> Option<&GridCell>; fn sample_work(view: SceneView<'_>, shape: ShapeId, cache: &DashCache, x: f64, y: f64) -> (usize,bool,bool); fn subpath_closed_seam(view: SceneView<'_>, shape: ShapeId, subpath: usize, edges: &[Edge]) -> bool; fn shape_closed_seam(view: SceneView<'_>, shape: ShapeId, edges: &[Edge]) -> bool",
      "contract": "Full segment/cap/join/seam/dash accumulation, zero-length edges and miter extension; grid abandon uses exact C scalar fallback. Grids counted against shared dash byte cap, no unbounded refs/cells."
    },
    {
      "owner": "RASTER_SAMPLE",
      "name": "sample and fill",
      "signature": "fn stroke_contains(view: SceneView<'_>, shape: ShapeId, input: &SampleInput<'_>) -> bool; fn paint_sample(view: SceneView<'_>, shape: ShapeId, input: &SampleInput<'_>, alpha: AlphaMode) -> [u8;4]; fn paint_sample_inside(view: SceneView<'_>, shape: ShapeId, fill: [u8;4], input: &SampleInput<'_>, alpha: AlphaMode) -> [u8;4]; fn fill_row(view: SceneView<'_>, shape: ShapeId, y: u32, scratch: &mut RasterScratch, map: ViewMapping, alpha: AlphaMode, control: &mut dyn WorkControl) -> Result<()>",
      "contract": "Entire original image/pattern interpolation, wrapped indices, clip query, fill+stroke order and source-over math; 4x4 at .125,.375,.625,.875 plus center fast path only eligible interiors. FrozenOracleOnly synthetic-alpha adapter remains test-only."
    }
