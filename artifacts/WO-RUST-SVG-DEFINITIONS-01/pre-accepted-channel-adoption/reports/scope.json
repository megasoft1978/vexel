  "operations": [
    {
      "owner": "DEFINITIONS",
      "name": "plan definitions",
      "signature": "fn plan<'src, 'ctx>(ctx: &mut DefinitionContext<'src, 'ctx>, kind: DefinitionKind, element: ElementId, owner: ShapeId, transform: Affine, bounds: [f64;4], style: &CssPaint<'src>, control: &mut dyn WorkControl) -> Result<DefinitionPlan<'src>>",
      "contract": "DefinitionContext supplies borrowed source/tokens + mutable CSS/reference and shared counters/active-definition stack, builder append interface; DefinitionPlan<'src> contains one or more Expansion<'src> with source-borrowed CssPaint<'src>, postoperation and full parsed descriptor. CssSheet<'src> and ReferenceIndex<'src> retain their accepted source borrows; DefinitionContext<'src, 'ctx> separately ties mutable container, active-stack, counter and builder borrows to temporary 'ctx, while the result retains only 'src. Control is separately borrowed. This permits the context and all mutable control borrows to end when the method returns DefinitionPlan<'src>. Includes all clip/filter/mask/pattern/marker files, strict local hrefs, units, regions, viewBox, definition ancestor style, cache keys and instance limits. Engine executes expansions; definitions never recurse into engine directly."
    },
    {
      "owner": "DEFINITIONS",
      "name": "clip mutation",
      "signature": "fn create_rect(points: [Point;4], user_inverse: Affine, owner: Option<TransformId>, builder: &mut SceneBuilder) -> Result<ClipId>; fn apply_group(builder: &mut SceneBuilder, scene: SceneId, shapes: TableRange, clip: ClipId) -> Result<()>; fn clone_clips(view: SceneView<'_>, control: &mut dyn WorkControl) -> Result<ClipOverlay>; fn update_owner(overlay: &mut ClipOverlay, id: ClipId, owner: TransformId, user_inverse: Affine, attribute_inverse: Affine, bounds: [f64;4]) -> Result<()>",
