   144	    pub(crate) fn storage_bytes(&self) -> Result<usize> {
   145	        self.storage_bytes_controlled(&mut crate::builder::NoStop)
   146	    }
   147	    pub(crate) fn storage_bytes_controlled(&self, control: &mut dyn WorkControl) -> Result<usize> {
   148	        let mut total = bytes(&self.publications)?;
   149	        total = add(total, bytes(&self.edges)?)?;
   150	        total = add(total, bytes(&self.edge_colors)?)?;
   151	        total = add(total, bytes(&self.edge_shape_ids)?)?;
   152	        total = add(total, bytes(&self.shapes)?)?;
   153	        total = add(total, bytes(&self.path_subpaths)?)?;
   154	        total = add(total, bytes(&self.path_segments)?)?;
   155	        total = add(total, bytes(&self.path_numbers)?)?;
   156	        total = add(total, bytes(&self.transforms)?)?;
   157	        total = add(total, bytes(&self.images)?)?;
   158	        total = add(total, bytes(&self.groups)?)?;
   159	        total = add(total, bytes(&self.filters)?)?;
   160	        total = add(total, bytes(&self.filter_primitives)?)?;
   161	        total = add(total, bytes(&self.masks)?)?;
   162	        total = add(total, bytes(&self.patterns)?)?;
   163	        total = add(total, bytes(&self.fill_paints)?)?;
   164	        total = add(total, bytes(&self.stroke_paints)?)?;
   165	        total = add(total, bytes(&self.dash_values)?)?;
   166	        total = add(total, bytes(&self.stops)?)?;
   167	        total = add(total, bytes(&self.clips)?)?;
   168	        total = add(total, bytes(&self.shapes_serials)?)?;
   169	        total = add(total, bytes(&self.transforms_serials)?)?;
   170	        total = add(total, bytes(&self.clips_serials)?)?;
   171	        total = add(total, bytes(&self.patterns_serials)?)?;
   172	        total = add(total, bytes(&self.masks_serials)?)?;
   173	        total = add(total, bytes(&self.filters_serials)?)?;
   174	        total = add(total, bytes(&self.groups_serials)?)?;
   175	        total = add(total, bytes(&self.shape_admissions)?)?;
   176	        total = add(total, bytes(&self.geometry_sources)?)?;
   177	        for image in &self.images {
   178	            control
   179	                .charge(WorkKind::Media, 1)
   180	                .map_err(crate::types::stopped)?;
   181	            total = add(total, bytes(&image.pixels.rgba)?)?;
   182	        }
   183	        for clip in &self.clips {
   184	            control
   185	                .charge(WorkKind::ClipChild, 1)
   186	                .map_err(crate::types::stopped)?;
   187	            total = add(
   188	                total,
   189	                add(bytes(&clip.geometry.edges)?, bytes(&clip.geometry.shapes)?)?,
   190	            )?;
   191	        }
   192	        for pattern in &self.patterns {
   193	            control
   194	                .charge(WorkKind::PaintVisit, 1)
   195	                .map_err(crate::types::stopped)?;
   196	            total = add(total, pattern.tile.allocated_byte_count())?;
   197	        }
   198	        Ok(total)
   199	    }
   200	}
