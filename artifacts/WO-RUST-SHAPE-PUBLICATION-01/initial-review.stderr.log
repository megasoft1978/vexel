   253	impl CommonSampleInput<'_> {
   254	    pub fn validate(&self, view: RasterInput<'_>, control: &mut dyn WorkControl) -> Result<()> {
   255	        if !self.dash_cache.matches_source(view.source_owner()) {
   256	            return Err(invalid(0));
   257	        }
   258	        if ![self.px, self.py, self.paint_x, self.paint_y]
   259	            .into_iter()
   260	            .all(f64::is_finite)
   261	            || self.dash_seams.len() != self.local_edges.len()
   262	        {
   263	            return Err(invalid(0));
   264	        }
   265	        control.checkpoint().map_err(stopped)?;
   266	        for index in self.active_edges {
   267	            control.charge(WorkKind::Edge, 1).map_err(stopped)?;
   268	            if *index as usize >= view.edges().len() {
   269	                return Err(invalid(0));
   270	            }
   271	        }
   272	        Ok(())
   273	    }
