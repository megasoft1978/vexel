   398	    pub fn scene(&self, id: SceneId) -> Option<SceneView<'a, V, A>> {
   399	        let scene = self.scenes.get(id.index())?;
   400	        if id.owner != self.id.owner || id.serial != scene.serial || !scene.sealed {
   401	            return None;
   402	        }
   403	        if id == self.id {
   404	            return Some(*self);
   405	        }
   406	        Some(scene.view(
   407	            self.id.owner,
   408	            id.index(),
   409	            self.scenes,
   410	            self.source,
   411	            self.animation,
   412	            V::from_viewport(scene.viewport)?,
   413	            self.ignored,
   414	        ))
   415	    }
