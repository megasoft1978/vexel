    32	fn unresolved_admission_blocks_commit_and_cancel_releases_it() {
    33	    let mut b = builder();
    34	    let mut c = Run;
    35	    let (draft, request) = draft_request(&mut b, &mut c);
    36	    let token = b.admit_shape(&draft, request, 9, &mut c).unwrap();
    37	    let error = b.commit_request(&draft, request, &mut c).unwrap_err();
    38	    assert_eq!(error.offset, 9);
    39	    assert_eq!(error.kind, ErrorKind::InvalidArgument);
    40	    b.cancel_shape_admission(&draft, token).unwrap();
    41	    b.commit_request(&draft, request, &mut c).unwrap();
    42	    b.commit_draft(&draft, &mut c).unwrap();
    43	    assert!(b.freeze().is_ok());
    44	}
