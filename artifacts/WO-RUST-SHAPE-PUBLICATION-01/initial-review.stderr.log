    46	#[test]
    47	fn admissions_reserve_distinct_slots_and_direct_append_respects_them() {
    48	    let mut b = builder();
    49	    let mut c = Run;
    50	    let (draft, request) = draft_request(&mut b, &mut c);
    51	    let first = b.admit_shape(&draft, request, 10, &mut c).unwrap();
    52	    let second = b.admit_shape(&draft, request, 11, &mut c).unwrap();
    53	    let direct = b
    54	        .append_shape(b.root_id(), shape(b.source_owner()), &mut c)
    55	        .unwrap();
    56	    let a = b
    57	        .append_admitted_shape(&draft, second, shape(b.source_owner()), &mut c)
    58	        .unwrap();
    59	    let z = b
    60	        .append_admitted_shape(&draft, first, shape(b.source_owner()), &mut c)
    61	        .unwrap();
    62	    assert_ne!(direct, a);
    63	    assert_ne!(a, z);
    64	    b.commit_request(&draft, request, &mut c).unwrap();
    65	    b.commit_draft(&draft, &mut c).unwrap();
    66	    let root = b.root_id();
    67	    assert_eq!(b.freeze().unwrap().scene(root).unwrap().shapes.len(), 3);
    68	}
