   286	/// Complete immutable table view, including checked child lookup and source context.
   287	pub type ViewTables<'a> = SceneView<'a>;
   288	macro_rules! view_handle {
   289	    ($name:ident, $kind:ident, $field:ident, $serial:expr) => {
   290	        /// Retrieve an existing checked handle from this exact immutable view.
   291	        /// Enumeration includes records with no edges and preserves insertion
   292	        /// serials, so rollback/reused slots cannot authorize stale handles.
   293	        pub fn $name(&self, index: usize) -> Option<$kind> {
   294	            self.$field.get(index)?;
   295	            Some($kind {
   296	                owner: self.id.owner,
   297	                scene: self.id.slot,
   298	                slot: u32::try_from(index).ok()?,
   299	                serial: *self.serials[$serial].get(index)?,
   300	            })
   301	        }
   302	    };
   303	}
   304	impl<'a, V: ViewportRead, A: Copy> SceneView<'a, V, A> {
   305	    view_handle!(shape_id, ShapeId, shapes, 0);
   306	    view_handle!(transform_id, TransformId, transforms, 1);
   307	    view_handle!(clip_id, ClipId, clips, 2);
   308	    view_handle!(pattern_id, PatternId, patterns, 3);
   309	    view_handle!(mask_id, MaskId, masks, 4);
   310	    view_handle!(filter_id, FilterId, filters, 5);
   311	    view_handle!(group_id, GroupId, groups, 6);
   312	    /// Return canonical path provenance when this shape is a use instance.
   313	    /// Ordinary shapes continue to use their public `Shape::source` span.
   314	    pub fn shape_geometry_source(&self, shape: ShapeId) -> Option<crate::ShapeGeometrySource> {
   315	        self.shape(shape)?;
   316	        self.geometry_sources
   317	            .binary_search_by_key(&shape.slot, |value| value.shape_slot)
   318	            .ok()
   319	            .and_then(|index| self.geometry_sources.get(index).copied())
   320	    }
   321	    pub(crate) fn overlay<'b>(
   322	        &'b self,
   323	        edges: Option<&'b [Edge]>,
   324	        colors: Option<&'b [[u8; 4]]>,
   325	        shapes: Option<&'b [Shape]>,
   326	        fills: Option<&'b [Paint]>,
   327	        strokes: Option<&'b [Paint]>,
   328	        transforms: Option<&'b [TransformFrame]>,
   329	        clips: Option<&'b [Clip]>,
   330	    ) -> SceneView<'b, V, A> {
   331	        let mut view: SceneView<'b, V, A> = *self;
   332	        if let Some(v) = edges {
   333	            view.edges = v;
   334	        }
   335	        if let Some(v) = colors {
   336	            view.edge_colors = v;
   337	        }
   338	        if let Some(v) = shapes {
   339	            view.shapes = v;
   340	        }
   341	        if let Some(v) = fills {
   342	            view.fill_paints = v;
   343	        }
   344	        if let Some(v) = strokes {
   345	            view.stroke_paints = v;
   346	        }
   347	        if let Some(v) = transforms {
   348	            view.transforms = v;
   349	        }
   350	        if let Some(v) = clips {
   351	            view.clips = v;
   352	        }
   353	        view
   354	    }
