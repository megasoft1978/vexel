     5	fn draft_request(
     6	    b: &mut SceneBuilder,
     7	    control: &mut dyn WorkControl,
     8	) -> (DraftToken, RequestToken) {
     9	    let draft = b.begin_draft(b.root_id()).unwrap();
    10	    let request = b.begin_request(&draft, control).unwrap();
    11	    (draft, request)
    12	}
