   506	/// Groups are depth-first painter ranges. The previous group's ancestry is a
   507	/// bounded stack encoded by parent handles; no quadratic sibling search.
   508	fn group_order<V: ViewportRead, A: Copy>(
   509	    scene: SceneView<'_, V, A>,
   510	    value: &OpacityGroup,
   511	    index: usize,
   512	    control: &mut dyn WorkControl,
   513	) -> Result<()> {
   514	    if index == 0 {
   515	        return if value.parent.is_none() {
   516	            Ok(())
   517	        } else {
   518	            Err(invalid(0))
   519	        };
   520	    }
   521	    let mut cursor = index - 1;
   522	    for _ in 0..64 {
   523	        charge(control, WorkKind::ClipChain)?;
   524	        if value.parent.is_some_and(|parent| parent.index() == cursor) {
   525	            return Ok(());
   526	        }
   527	        let previous = scene.groups.get(cursor).ok_or_else(|| invalid(0))?;
   528	        if previous.parent == value.parent {
   529	            return if value.shapes.first >= previous.shapes.end().ok_or_else(|| invalid(0))? {
   530	                Ok(())
   531	            } else {
   532	                Err(invalid(0))
   533	            };
   534	        }
   535	        let parent = previous.parent.ok_or_else(|| invalid(0))?;
   536	        if parent.index() >= cursor || scene.group(parent).is_none() {
   537	            return Err(invalid(0));
   538	        }
   539	        cursor = parent.index();
   540	    }
   541	    Err(limit(LimitKind::Depth))
   542	}
