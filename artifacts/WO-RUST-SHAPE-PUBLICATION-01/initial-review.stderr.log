    14	#[test]
    15	fn admitted_shape_is_real_request_scoped_and_commits() {
    16	    let mut b = builder();
    17	    let mut c = Run;
    18	    let (draft, request) = draft_request(&mut b, &mut c);
    19	    let token = b.admit_shape(&draft, request, 6, &mut c).unwrap();
    20	    let id = b
    21	        .append_admitted_shape(&draft, token, shape(b.source_owner()), &mut c)
    22	        .unwrap();
    23	    b.commit_request(&draft, request, &mut c).unwrap();
    24	    b.commit_draft(&draft, &mut c).unwrap();
    25	    let graph = b.freeze().unwrap();
    26	    let view = graph.root();
    27	    assert_eq!(view.shape_id(0), Some(id));
    28	    assert_eq!(view.shapes.len(), 1);
    29	}
