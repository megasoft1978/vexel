   499	/// Immutable, source-coherent scene graph suitable for worker ownership transfer.
   500	#[derive(Debug)]
   501	pub struct SceneGraph {
   502	    pub(crate) owner: u64,
   503	    pub(crate) source: SourceOwner,
   504	    pub(crate) generation: u64,
   505	    pub(crate) root: SceneId,
   506	    pub(crate) scenes: Vec<SceneData>,
   507	    pub(crate) animation: OwnedAnimation,
   508	    pub(crate) ignored: [Ignored; 4],
   509	    pub(crate) stats: MemoryStats,
   510	}
   511	impl SceneGraph {
   512	    pub fn scene_id(&self, index: usize) -> Option<SceneId> {
   513	        let scene = self.scenes.get(index)?;
   514	        Some(SceneId {
   515	            owner: self.owner,
   516	            slot: u32::try_from(index).ok()?,
   517	            serial: scene.serial,
   518	        })
   519	    }
   520	    pub fn source_owner(&self) -> &SourceOwner {
   521	        &self.source
   522	    }
   523	    pub fn source(&self) -> &[u8] {
   524	        self.source.as_slice()
   525	    }
   526	    pub fn generation(&self) -> u64 {
   527	        self.generation
   528	    }
   529	    pub fn root(&self) -> SceneView<'_> {
   530	        self.scene(self.root).expect("validated root")
   531	    }
   532	    pub fn scene(&self, id: SceneId) -> Option<SceneView<'_>> {
   533	        let scene = self.scenes.get(id.index())?;
