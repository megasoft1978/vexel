   210	                .path_segments
   211	                .push(ScenePathSegment { path, shape: id });
   212	        }
   213	        for number in input.path.numbers {
   214	            control.charge(WorkKind::SourceRead, 1).map_err(stopped)?;
   215	            scene.path_numbers.push(number);
   216	        }
   217	        control.checkpoint().map_err(stopped)?;
   218	        scene.shapes.push(shape);
   219	        scene.shapes_serials.push(id.serial);
   220	        if let Some(proof) = geometry {
   221	            scene.geometry_sources.push(crate::ShapeGeometrySource {
   222	                shape_slot: id.slot,
   223	                proof,
   224	                number_range: TableRange {
   225	                    first: number_first,
   226	                    count: number_count,
   227	                },
   228	            });
