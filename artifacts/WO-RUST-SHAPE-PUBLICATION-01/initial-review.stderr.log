     6	/// Original [min x, min y, max x, max y], including zero extent.
     7	/// Rejects overflowed extents even when each coordinate itself is finite.
     8	pub fn ordered_bounds_extent(bounds: [f64; 4]) -> Option<[f64; 2]> {
     9	    if !bounds.into_iter().all(f64::is_finite) {
    10	        return None;
    11	    }
    12	    let extent = [bounds[2] - bounds[0], bounds[3] - bounds[1]];
    13	    extent
    14	        .into_iter()
    15	        .all(|v| v.is_finite() && v >= 0.)
    16	        .then_some(extent)
    17	}
