    45	macro_rules! room {
    46	    ($self:ident,$index:expr,$field:ident,$extra:expr,$cap:expr,$pending:expr) => {{
    47	        let pending = $pending;
    48	        let current = add($self.stats.live_bytes, pending)?;
    49	        let available = $self
    50	            .limits
    51	            .reserved_bytes
    52	            .checked_sub(current)
    53	            .ok_or_else(|| limit(LimitKind::ReservedBytes))?;
    54	        // Check all counters before the mutating reserve can transfer old values.
    55	        let history_room = usize::MAX - $self.stats.total_allocated_bytes;
    56	        let available = available.min(history_room);
    57	        if $self.stats.allocation_count == usize::MAX {
    58	            return Err(arithmetic());
    59	        }
    60	        let (new, old) = reserve(&mut $self.scenes[$index].$field, $extra, $cap, available)?;
    61	        if new != 0 {
    62	            $self.stats.peak_live_bytes = $self.stats.peak_live_bytes.max(add(current, new)?);
    63	            $self.stats.total_allocated_bytes = add($self.stats.total_allocated_bytes, new)?;
    64	            $self.stats.allocation_count += 1;
    65	            $self.stats.live_bytes = add($self.stats.live_bytes - old, new)?;
    66	        }
    67	    }};
    68	}
