   561	// Sealed conversion keeps traversal reads from manufacturing renderable views.
   562	mod read_sealed {
   563	    pub trait Sealed {}
   564	    impl Sealed for super::Viewport {}
   565	    impl Sealed for Option<super::Viewport> {}
   566	}
   567	pub trait ViewportRead: Copy + read_sealed::Sealed {
   568	    #[doc(hidden)]
   569	    fn from_viewport(value: Option<Viewport>) -> Option<Self>;
   570	}
   571	impl ViewportRead for Viewport {
   572	    fn from_viewport(value: Option<Viewport>) -> Option<Self> { value }
   573	}
   574	impl ViewportRead for Option<Viewport> {
   575	    fn from_viewport(value: Option<Viewport>) -> Option<Self> { Some(value) }
   576	}
   577	/// Read-only traversal tables. Neither viewport nor animation is fabricated.
   578	/// This type cannot be passed to frame builders or scalar render APIs.
   579	/// ```compile_fail
   580	/// use vexel_scene::{FrameBuilder, SceneBuilder};
   581	/// fn unfinished_frame(builder: &SceneBuilder) {
   582	///     let read = builder.traversal_scene(builder.root_id()).unwrap();
   583	///     FrameBuilder::new(read, 1024).unwrap();
   584	/// }
   585	/// ```
   586	pub type TraversalView<'a> = SceneView<'a, Option<Viewport>, Option<AnimationView<'a>>>;
   587	impl<'a> SceneView<'a> {
   588	    pub fn animation(&self) -> AnimationView<'a> { self.animation }
   589	}
   590	impl<'a> TraversalView<'a> {
   591	    pub fn parsed_animation(&self) -> Option<AnimationView<'a>> { self.animation }
   592	}

