   288	macro_rules! view_handle {
   289	    ($name:ident, $kind:ident, $field:ident, $serial:expr) => {
   290	        /// Retrieve an existing checked handle from this exact immutable view.
   291	        /// Enumeration includes records with no edges and preserves insertion
   292	        /// serials, so rollback/reused slots cannot authorize stale handles.
   293	        pub fn $name(&self, index: usize) -> Option<$kind> {
