   240	        span(source, number.source)?;
   241	        if !number.value.is_finite() {
   242	            return Err(invalid(number.source.start));
   243	        }
   244	    }
   245	    Ok(())
   246	}
   247	fn segment_valid(
   248	    source: &[u8],
   249	    value: vexel_svg_path::PathSegment,
   250	    edges: usize,
   251	    numbers: usize,
   252	) -> Result<()> {
   253	    span(source, value.source)?;
   254	    TableRange {
   255	        first: value.first_edge,
   256	        count: value.edge_count,
   257	    }
   258	    .require(edges, value.source.start)?;
   259	    TableRange {
   260	        first: value.first_number,
   261	        count: value.number_count,
   262	    }
   263	    .require(numbers, value.source.start)?;
   264	    let count = match value.command.to_ascii_uppercase() {
   265	        b'M' | b'L' | b'T' => 2,
   266	        b'H' | b'V' => 1,
   267	        b'C' => 6,
   268	        b'S' | b'Q' => 4,
   269	        b'A' => 7,
   270	        b'Z' => 0,
   271	        _ => return Err(invalid(value.source.start)),
   272	    };
   273	    if value.number_count != count
   274	        || (value.command.eq_ignore_ascii_case(&b'M') && value.edge_count != 0)
   275	    {
   276	        return Err(invalid(value.source.start));
   277	    }
   278	    if matches!(
   279	        value.command.to_ascii_uppercase(),
   280	        b'L' | b'H' | b'V' | b'Z'
   281	    ) && value.edge_count > 1
   282	    {
   283	        return Err(invalid(value.source.start));
   284	    }
   285	    if let Some(offset) = value.command_offset {
   286	        if offset < value.source.start
   287	            || offset >= value.source.end
   288	            || source.get(offset).map(u8::to_ascii_uppercase)
   289	                != Some(value.command.to_ascii_uppercase())
   290	        {
   291	            return Err(invalid(offset));
   292	        }
   293	    }
   294	    Ok(())
   295	}
