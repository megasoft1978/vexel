   158	        total = add(total, bytes(&self.groups)?)?;
   159	        total = add(total, bytes(&self.filters)?)?;
   160	        total = add(total, bytes(&self.filter_primitives)?)?;
   161	        total = add(total, bytes(&self.masks)?)?;
   162	        total = add(total, bytes(&self.patterns)?)?;
   163	        total = add(total, bytes(&self.fill_paints)?)?;
   164	        total = add(total, bytes(&self.stroke_paints)?)?;
   165	        total = add(total, bytes(&self.dash_values)?)?;
