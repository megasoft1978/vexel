   154	pub(crate) fn shape_attributes_view<V: ViewportRead, A: Copy>(
   155	    scene: SceneView<'_, V, A>,
   156	    value: &Shape,
   157	    control: &mut dyn WorkControl,
   158	) -> Result<()> {
   159	    charge(control, WorkKind::TokenVisit)?;
