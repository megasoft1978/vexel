   223	            &value.subpaths,
   224	            TableRange {
   225	                first: 0,
   226	                count: value.edges.len(),
   227	            },
   228	            &value.edges,
   229	            source_range,
   230	            value.segments.iter().copied(),
   231	            control,
   232	        )?;
   233	    }
