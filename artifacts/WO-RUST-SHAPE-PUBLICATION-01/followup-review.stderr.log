   151	        total = add(total, bytes(&self.edge_shape_ids)?)?;
   152	        total = add(total, bytes(&self.shapes)?)?;
   153	        total = add(total, bytes(&self.path_subpaths)?)?;
   154	        total = add(total, bytes(&self.path_segments)?)?;
   155	        total = add(total, bytes(&self.path_numbers)?)?;
   156	        total = add(total, bytes(&self.transforms)?)?;
