   170	        total = add(total, bytes(&self.clips_serials)?)?;
   171	        total = add(total, bytes(&self.patterns_serials)?)?;
   172	        total = add(total, bytes(&self.masks_serials)?)?;
   173	        total = add(total, bytes(&self.filters_serials)?)?;
   174	        total = add(total, bytes(&self.groups_serials)?)?;
   175	        total = add(total, bytes(&self.shape_admissions)?)?;
   176	        total = add(total, bytes(&self.geometry_sources)?)?;
   177	        for image in &self.images {
   178	            control
   179	                .charge(WorkKind::Media, 1)
   180	                .map_err(crate::types::stopped)?;
   181	            total = add(total, bytes(&image.pixels.rgba)?)?;
   182	        }
   183	        for clip in &self.clips {
   184	            control
   185	                .charge(WorkKind::ClipChild, 1)
   186	                .map_err(crate::types::stopped)?;
   187	            total = add(
   188	                total,
