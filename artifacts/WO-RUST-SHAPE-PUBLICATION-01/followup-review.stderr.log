   326	/// Guard before calling the lower renderer. Its output remains in the same job.
   327	pub fn render_common_pattern(
   328	    kernel: &mut dyn CommonRasterKernel,
   329	    request: &StaticPatternRequest<'_>,
   330	    options: RenderOptions,
   331	    job: &mut RasterJob,
   332	    control: &mut dyn WorkControl,
   333	) -> Result<JobRenderOutput> {
   334	    let input = request.child.input();
   335	    input.validate_job(job, control)?;
   336	    let output = kernel.render_flat(
   337	        input,
   338	        TableRange {
   339	            first: 0,
   340	            count: input.shapes().len(),
   341	        },
   342	        options,
   343	        job,
   344	        control,
   345	    )?;
   346	    let validation = output.validate(job).and_then(|()| {
   347	        if Some(output.generation) != input.static_generation()
   348	            || output.width != request.descriptor.width
   349	            || output.height != request.descriptor.height
   350	        {
   351	            Err(invalid(request.descriptor.error_offset))
   352	        } else {
   353	            Ok(())
   354	        }
   355	    });
   356	    if let Err(error) = validation {
   357	        if job.require_pool(output.pixels, RasterPool::Output).is_ok()
   358	            && job.slice(output.pixels).is_ok()
   359	        {
   360	            job.release(output.pixels)?;
   361	        }
   362	        return Err(error);
   363	    }
   364	    Ok(output)
   365	}

