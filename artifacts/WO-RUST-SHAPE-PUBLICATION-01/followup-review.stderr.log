   161	    if !affine_valid(value.source.transform) || !affine_valid(value.stroke_inverse) {
   162	        return Err(invalid(value.source.element.start));
   163	    }
   164	    if let Some(node) = value.source.transform_node {
   165	        if scene.transform(node).is_none() {
   166	            return Err(invalid(0));
   167	        }
   168	    }
   169	    if let Some(clip) = value.clip {
   170	        if scene.clip(clip).is_none() {
   171	            return Err(invalid(0));
   172	        }
   173	    }
   174	    for (index, length) in [
   175	        (value.fill_paint, scene.fill_paints.len()),
   176	        (value.stroke_paint, scene.stroke_paints.len()),
   177	        (value.image, scene.images.len()),
   178	    ] {
   179	        if index.is_some_and(|i| i >= length) {
   180	            return Err(invalid(0));
   181	        }
   182	    }
   183	    let stroke = value.stroke;
   184	    if !stroke.width.is_finite()
   185	        || !(0.0..=1024.0).contains(&stroke.width)
   186	        || !stroke.miter_limit.is_finite()
   187	        || !(1.0..=64.0).contains(&stroke.miter_limit)
   188	        || !coord(stroke.dash_offset)
   189	        || stroke.paint_order > 5
   190	    {
   191	        return Err(invalid(0));
   192	    }
   193	    stroke.dash_values.require(scene.dash_values.len(), 0)?;
   194	    if stroke.dash_values.count > 16 {
   195	        return Err(limit(LimitKind::DashCache));
   196	    }
   197	    Ok(())
   198	}
   199	pub(crate) fn path(
   200	    source: &[u8],
   201	    value: &vexel_svg_path::PathDocument,
   202	    source_range: Span,
   203	    control: &mut dyn WorkControl,
   204	) -> Result<()> {
   205	    for &e in &value.edges {
   206	        charge(control, WorkKind::Edge)?;
   207	        edge(e)?;
   208	    }
   209	    let mut end = 0;
   210	    let mut overlap = false;
   211	    for subpath in &value.subpaths {
   212	        charge(control, WorkKind::TokenVisit)?;
   213	        let range = TableRange {
   214	            first: subpath.first_edge,
   215	            count: subpath.edge_count,
   216	        };
