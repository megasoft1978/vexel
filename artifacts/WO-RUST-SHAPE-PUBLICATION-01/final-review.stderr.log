   240	/// Same scalar coordinates/lattice/edge data as SampleInput. The lower engine
   241	/// changes its input type and propagates Result; its math and cost stay unchanged.
   242	pub struct CommonSampleInput<'a> {
   243	    pub resources: &'a dyn CommonKernelResources,
   244	    pub active_edges: &'a [u32],
   245	    pub local_edges: &'a [Edge],
