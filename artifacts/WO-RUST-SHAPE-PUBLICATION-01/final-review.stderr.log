   520	        };
   521	    }
   522	    let mut cursor = index - 1;
   523	    for _ in 0..64 {
   524	        charge(control, WorkKind::ClipChain)?;
   525	        if value.parent.is_some_and(|parent| parent.index() == cursor) {
