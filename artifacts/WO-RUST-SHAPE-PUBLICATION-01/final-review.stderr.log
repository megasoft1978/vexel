   122	fn shape_capacity_preflight_wins_before_path_provider_and_malformed_stroke() {
   123	    let source = owner();
   124	    let mut limits = Limits::default();
   125	    limits.shapes = 1;
   126	    let mut b =
   127	        SceneBuilder::new(source.clone(), animation(&source), 7, viewport(), limits).unwrap();
   128	    let mut c = Run;
   129	    let (draft, request) = draft_request(&mut b, &mut c);
   130	    let reserved = b.admit_shape(&draft, request, 11, &mut c).unwrap();
   131	    let malformed_shape = Shape::new(SourceMap {
   132	        element: Span { start: 5, end: 31 },
   133	        transform: vexel_geometry::affine_identity(),
   134	        transform_node: None,
   135	    });
   136	    let mut malformed_shape = malformed_shape;
   137	    malformed_shape.stroke.width = f64::NAN;
   138	    let mut provider_calls = 0;
   139	    let error = match b.admit_shape(&draft, request, 19, &mut c) {
   140	        Err(error) => error,
   141	        Ok(admission) => {
   142	            provider_calls += 1;
   143	            let path_start = source.windows(2).position(|bytes| bytes == b"M0").unwrap();
   144	            let path = vexel_svg_path::parse_path(
   145	                &source,
   146	                Span {
   147	                    start: path_start,
   148	                    end: path_start + b"M0 0 L1 1 2 3 Z".len(),
   149	                },
   150	                vexel_geometry::affine_identity(),
   151	                Default::default(),
   152	            )
   153	            .unwrap();
   154	            let edge_colors = (0..path.edges.len())
   155	                .map(|index| [index as u8, 2, 3, 255])
   156	                .collect();
   157	            b.append_admitted_shape(
   158	                &draft,
   159	                &admission,
   160	                ShapeInput {
   161	                    shape: malformed_shape,
   162	                    path,
   163	                    edge_colors,
   164	                },
   165	                &mut c,
   166	            )
   167	            .unwrap_err()
   168	        }
   169	    };
   170	    assert_eq!(error.kind, ErrorKind::Limit(LimitKind::Shapes));
   171	    assert_eq!(error.offset, 19);
   172	    assert_eq!(provider_calls, 0);
   173	    b.cancel_shape_admission(&draft, &reserved).unwrap();
   174	    b.commit_request(&draft, request, &mut c).unwrap();
   175	    b.commit_draft(&draft, &mut c).unwrap();
   176	    assert!(b.freeze().is_ok());
   177	}
