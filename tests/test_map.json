{
  "_doc": "Path prefix -> tests to run for quick checks. ctest = regex for ctest -R; python = unittest modules. First match of every prefix is unioned. 'always' runs on every quick check (cheap sanity).",
  "always": {"ctest": "cli-version|base-contract", "python": []},
  "map": [
    {"prefix": "src/base/", "ctest": ".", "python": []},
    {"prefix": "src/svg/xml/", "ctest": "xml-tokenizer|svg-index|svg-token|document", "python": ["tests.test_xml_tokenizer", "tests.test_svg_index"]},
    {"prefix": "src/svg/", "ctest": "shape-render|svg-text-image|svg-marker|css-cascade|viewer-frame|viewer-quality", "python": ["tests.test_shape_render", "tests.svg", "tests.realworld"]},
    {"prefix": "src/raster/", "ctest": "shape-render|svg-text-image|svg-marker|viewer-frame|viewer-quality", "python": ["tests.test_shape_render", "tests.svg", "tests.realworld"]},
    {"prefix": "src/geom/", "ctest": "shape-render|svg-|css-|viewer-", "python": ["tests.test_shape_render"]},
    {"prefix": "src/document/", "ctest": "document|source-save|editor|mcp", "python": ["tests.test_document_model", "tests.test_source_save"]},
    {"prefix": "src/mcp/", "ctest": "mcp", "python": []},
    {"prefix": "src/ui/", "ctest": "ui-|editor-|viewer-chrome|platform-text-ui", "python": ["tests.test_ui_chrome_golden"]},
    {"prefix": "src/app/", "ctest": "viewer-|editor-|ui-|mcp", "python": ["tests.test_viewer_frame", "tests.test_viewer_navigation"]},
    {"prefix": "src/platform/media", "ctest": "platform-media", "python": []},
    {"prefix": "src/platform/", "ctest": "platform-|viewer-|index-replay", "python": []},
    {"prefix": "app/", "ctest": "cli-|viewer-frame|render-soak", "python": ["tests.test_viewer_frame"]},
    {"prefix": "packaging/", "ctest": "cli-version", "python": ["tests.e2e.test_packaging"]},
    {"prefix": "scripts/", "ctest": "cli-version", "python": ["tests.test_dev", "tests.e2e"]},
    {"prefix": "tests/editor/", "ctest": "editor-", "python": ["tests.editor.test_smoke_supervisor"]},
    {"prefix": "tests/app/", "ctest": "viewer-timeline", "python": []},
    {"prefix": "tests/viewer/", "ctest": "viewer-", "python": ["tests.viewer.test_native_smoke"]},
    {"prefix": "tests/ui/", "ctest": "ui-|editor-|viewer-chrome|platform-text-ui", "python": []},
    {"prefix": "tests/svg/", "ctest": "shape-render|svg-", "python": ["tests.test_shape_render", "tests.svg"]},
    {"prefix": "tests/realworld/", "ctest": "shape-render", "python": ["tests.realworld"]},
    {"prefix": "tests/anim/", "ctest": "anim", "python": ["tests.anim"]},
    {"prefix": "tests/mcp/", "ctest": "mcp", "python": []},
    {"prefix": "CMakeLists.txt", "ctest": ".", "python": []},
    {"prefix": "dev", "ctest": "cli-version", "python": ["tests.test_dev"]}
  ]
}
