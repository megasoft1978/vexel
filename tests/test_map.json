{
  "_doc": "Path prefix -> tests to run for quick checks. ctest = regex for ctest -R; python = unittest modules. First match of every prefix is unioned. 'always' runs on every quick check (cheap sanity).",
  "always": {
    "ctest": "cli-version|base-contract",
    "python": []
  },
  "map": [
    {
      "prefix": "src/base/",
      "ctest": ".",
      "python": []
    },
    {
      "prefix": "src/svg/animation/",
      "ctest": "svg-animation|animation-authoring|viewer-timeline",
      "python": [
        "tests.anim.test_animation"
      ]
    },
    {
      "prefix": "src/svg/xml/",
      "ctest": "xml-tokenizer|svg-index|svg-token|document",
      "python": [
        "tests.test_xml_tokenizer",
        "tests.test_svg_index"
      ]
    },
    {
      "prefix": "src/svg/",
      "ctest": "shape-render|svg-text-image|svg-marker|css-cascade|viewer-frame|viewer-quality",
      "python": [
        "tests.test_shape_render",
        "tests.svg",
        "tests.realworld"
      ]
    },
    {
      "prefix": "src/raster/",
      "ctest": "shape-render|svg-text-image|svg-marker|viewer-frame|viewer-quality",
      "python": [
        "tests.test_shape_render",
        "tests.svg",
        "tests.realworld"
      ]
    },
    {
      "prefix": "src/geom/",
