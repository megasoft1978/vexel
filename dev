#!/bin/sh
set -eu

# lane: w2-bundle
usage() {
    printf '%s\n' 'usage: ./dev {build|test-fast|test|verify|help|doctor|bundle|dmg|e2e|soak}'
    printf '%s\n' '       ./dev run <file.svg>'
    printf '%s\n' '       ./dev viewer-smoke [<binary> [<first.svg> [<second.svg>]]]'
    printf '%s\n' '       ./dev editor-smoke [<binary>]'
    printf '%s\n' 'usage: ./dev index-bench [--sizes 10MiB,100MiB] [--output PATH]'
    printf '%s\n' 'usage: ./dev perf-gate [--output PATH] [--history PATH] [--baseline PATH]'
    printf '%s\n' 'usage: ./dev {asan|ubsan|fuzz|fuzz-xml|shape-fuzz}'
    # lane: w4-mcp
    printf '%s\n' '       ./dev mcp-fuzz [cases [seed]]'
    printf '%s\n' 'usage: ./dev bench-corpus [--run|--check]'
    printf '%s\n' '       ./dev tsan'
    printf '%s\n' '       ./dev e2e [--seed N] [--documents N] [--timeout-seconds N]'
    printf '%s\n' '       ./dev soak [--minutes N] [--seed N] [--output PATH]'
    printf '%s\n' '       ./dev wo-help'
}

command_name=${1:-help}
if [ "$command_name" = viewer-smoke ] && [ "$#" -gt 4 ]; then
    usage >&2
    exit 2
fi
if [ "$command_name" = editor-smoke ] && [ "$#" -gt 2 ]; then
    usage >&2
    exit 2
fi
if [ "$command_name" = run ]; then
    if [ "$#" -ne 2 ]; then
        usage >&2
        exit 2
    fi
elif [ "$#" -gt 1 ] && [ "${1:-}" != fuzz ] && [ "${1:-}" != fuzz-xml ] && [ "${1:-}" != shape-fuzz ] && [ "${1:-}" != mcp-fuzz ] && [ "${1:-}" != index-bench ] && [ "${1:-}" != perf-gate ] && [ "${1:-}" != bench-corpus ] && [ "${1:-}" != e2e ] && [ "${1:-}" != soak ] && [ "${1:-}" != viewer-smoke ] && [ "${1:-}" != editor-smoke ]; then
    usage >&2
    exit 2
fi

case "$command_name" in
    help)
        usage
        exit 0
        ;;
    build|test-fast|test|verify|run|index-bench|perf-gate|bench-corpus|asan|ubsan|tsan|fuzz|fuzz-xml|shape-fuzz|mcp-fuzz|viewer-smoke|editor-smoke|wo-help|doctor|bundle|dmg|e2e|soak)
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
run_cwd=$PWD
cd "$repo_root"

if [ "$(uname -s)" != "Darwin" ]; then
    printf '%s\n' 'vexel development commands currently require macOS.' >&2
    exit 2
fi

case "$command_name" in
    wo-help)
        "$repo_root/scripts/wo-run.sh" --help
        "$repo_root/scripts/wo-verify.sh" --help
        ;;
    # lane: w2-bundle
    doctor)
        python3 scripts/doctor.py
        ;;
    bundle)
        python3 packaging/vexel_packaging.py bundle
        ;;
    dmg)
        python3 packaging/vexel_packaging.py dmg
        ;;
    e2e)
        shift
        cmake --preset mac-release
        cmake --build --preset mac-release --target svgworkbench
        python3 scripts/e2e_svg.py "$@"
        ;;
    soak)
        shift
        python3 scripts/soak.py "$@"
        ;;
    build)
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        ;;
    run)
        cmake --preset mac-release
        cmake --build --preset mac-release
        cd "$run_cwd"
        exec "$repo_root/build/mac-release/bin/svgworkbench" "$2"
        ;;
    viewer-smoke)
        # lane: viewer2
        shift
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        "$repo_root/tests/viewer/native_smoke.sh" "$@"
        ;;
    editor-smoke)
        # lane: w3-editor
        shift
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        "$repo_root/tests/editor/native_smoke.sh" "$@"
        ;;
    test-fast|test)
        PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_runner.py --output .cache/test-results/latest.json
        python3 scripts/ledger.py validate ledger.jsonl
        ;;
    asan|ubsan)
        preset=mac-$command_name
        cmake --preset "$preset"
        cmake --build --preset "$preset"
        ctest --preset "$preset"
        ;;
    tsan)
        cmake --preset mac-tsan
        cmake --build --preset mac-tsan --target job_snapshot_test
        ctest --test-dir build/mac-tsan -R '^job-snapshot$' --output-on-failure
        ;;
    fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan
        python3 scripts/fuzz_smoke.py --binary build/mac-asan/bin/svgworkbench "$@"
        ;;
    fuzz-xml)
        shift
        duration=
        seed=
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --duration)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    duration=$2; shift 2 ;;
                --seed)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    seed=$2; shift 2 ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        case "$duration" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        case "$seed" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        [ "$duration" -ge 1 ] && [ "$duration" -le 600 ] || { usage >&2; exit 2; }
        [ "$seed" -le 4294967295 ] || { usage >&2; exit 2; }
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target xml_tokenizer_fuzz
        report=artifacts/WO-M2-03/pr-smoke.json
        [ "$duration" -ne 600 ] || report=artifacts/WO-M2-03/scheduled-campaign.json
        python3 scripts/xml_fuzz_campaign.py --binary build/mac-asan/bin/xml_tokenizer_fuzz \
            --duration "$duration" --seed "$seed" --output "$report"
        ;;
    shape-fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target shape_fuzz
        python3 tests/fuzz/shape/shape_fuzz.py --binary build/mac-asan/bin/shape_fuzz "$@"
        ;;
    # lane: w4-mcp
    mcp-fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target mcp_fuzz
        build/mac-asan/bin/mcp_fuzz "$@"
        ;;
    verify)
        "$repo_root/dev" build
        ctest --test-dir build/mac-debug --output-on-failure
        cmake --preset mac-release
        cmake --build --preset mac-release
        "$repo_root/dev" test-fast
        ;;
    index-bench)
        shift
        cmake --preset mac-release
        cmake --build --preset mac-release --target svg_index_bench
        python3 bench/generate/index_bench.py "$@"
        ;;
    perf-gate)
        shift
        python3 scripts/perf_gate.py "$@"
        ;;
    bench-corpus)
        shift
        if [ "$#" -eq 0 ]; then set -- --run; fi
        if [ "${1:-}" = --run ]; then
            cmake --preset mac-release
            cmake --build --preset mac-release --target svg_index_bench svgworkbench shape_render_cli
            cmake --preset mac-debug
            cmake --build --preset mac-debug --target svgworkbench shape_render_cli
        fi
        python3 reports/M4/head_to_head.py "$@"
        ;;
esac
