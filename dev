#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./dev {build|test-fast|test|verify|help}'
    printf '%s\n' 'usage: ./dev index-bench [--sizes 10MiB,100MiB] [--output PATH]'
    printf '%s\n' 'usage: ./dev perf-gate [--output PATH] [--history PATH] [--baseline PATH]'
    printf '%s\n' 'usage: ./dev {asan|ubsan|fuzz|fuzz-xml|shape-fuzz}'
    printf '%s\n' 'usage: ./dev bench-corpus [--run|--check]'
    printf '%s\n' '       ./dev tsan'
}

command_name=${1:-help}
if [ "$#" -gt 1 ] && [ "${1:-}" != fuzz ] && [ "${1:-}" != fuzz-xml ] && [ "${1:-}" != shape-fuzz ] && [ "${1:-}" != index-bench ] && [ "${1:-}" != perf-gate ] && [ "${1:-}" != bench-corpus ]; then
    usage >&2
    exit 2
fi

case "$command_name" in
    help)
        usage
        exit 0
        ;;
    build|test-fast|test|verify|index-bench|perf-gate|bench-corpus|asan|ubsan|tsan|fuzz|fuzz-xml|shape-fuzz)
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_root"

if [ "$(uname -s)" != "Darwin" ]; then
    printf '%s\n' 'vexel development commands currently require macOS.' >&2
    exit 2
fi

case "$command_name" in
    build)
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        ;;
    test-fast|test)
        PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_runner.py --output .cache/test-results/latest.json
        ;;
    asan|ubsan)
        preset=mac-$command_name
        cmake --preset "$preset"
        cmake --build --preset "$preset"
        ctest --preset "$preset"
        ;;
    tsan)
        cmake --preset mac-tsan
        cmake --build --preset mac-tsan --target job_snapshot_test
        ctest --test-dir build/mac-tsan -R '^job-snapshot$' --output-on-failure
        ;;
    fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan
        python3 scripts/fuzz_smoke.py --binary build/mac-asan/bin/svgworkbench "$@"
        ;;
    fuzz-xml)
        shift
        duration=
        seed=
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --duration)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    duration=$2; shift 2 ;;
                --seed)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    seed=$2; shift 2 ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        case "$duration" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        case "$seed" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        [ "$duration" -ge 1 ] && [ "$duration" -le 600 ] || { usage >&2; exit 2; }
        [ "$seed" -le 4294967295 ] || { usage >&2; exit 2; }
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target xml_tokenizer_fuzz
        report=artifacts/WO-M2-03/pr-smoke.json
        [ "$duration" -ne 600 ] || report=artifacts/WO-M2-03/scheduled-campaign.json
        python3 scripts/xml_fuzz_campaign.py --binary build/mac-asan/bin/xml_tokenizer_fuzz \
            --duration "$duration" --seed "$seed" --output "$report"
        ;;
    shape-fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target shape_fuzz
        python3 tests/fuzz/shape/shape_fuzz.py --binary build/mac-asan/bin/shape_fuzz "$@"
        ;;
    verify)
        "$repo_root/dev" build
        ctest --test-dir build/mac-debug --output-on-failure
        "$repo_root/dev" test-fast
        ;;
    index-bench)
        shift
        cmake --preset mac-release
        cmake --build --preset mac-release --target svg_index_bench
        python3 bench/generate/index_bench.py "$@"
        ;;
    perf-gate)
        shift
        python3 scripts/perf_gate.py "$@"
        ;;
    bench-corpus)
        shift
        if [ "$#" -eq 0 ]; then set -- --run; fi
        if [ "${1:-}" = --run ]; then
            cmake --preset mac-release
            cmake --build --preset mac-release --target svg_index_bench svgworkbench shape_render_cli
            cmake --preset mac-debug
            cmake --build --preset mac-debug --target svgworkbench shape_render_cli
        fi
        python3 reports/M4/head_to_head.py "$@"
        ;;
esac
