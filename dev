#!/bin/sh
set -eu

# lane: w2-bundle
usage() {
    printf '%s\n' 'usage: ./dev {build|test-fast|test|verify|help|doctor|bundle|dmg|e2e|soak}'
    printf '%s\n' '       ./dev run <file.svg>'
    printf '%s\n' '       ./dev viewer-smoke [<binary> [<file.svg>]]'
    printf '%s\n' '       ./dev viewer-panel-smoke [<binary> [<initial.svg> [<selected.svg>]]]'
    printf '%s\n' '       ./dev editor-smoke [<binary>]'
    printf '%s\n' 'usage: ./dev index-bench [--sizes 10MiB,100MiB] [--output PATH]'
    printf '%s\n' 'usage: ./dev perf-gate [--output PATH] [--history PATH] [--baseline PATH]'
    printf '%s\n' 'usage: ./dev {asan|ubsan|fuzz|fuzz-xml|shape-fuzz|animation-fuzz}'
    # lane: w4-mcp
    printf '%s\n' '       ./dev mcp-fuzz [cases [seed]]'
    printf '%s\n' '       ./dev animation-fuzz [cases [seed]]'
    printf '%s\n' 'usage: ./dev fuzz-xml [--duration N] [--seed N] [--output PATH]'
    printf '%s\n' 'usage: ./dev bench-corpus [--run|--check]'
    printf '%s\n' '       ./dev tsan'
    printf '%s\n' '       ./dev e2e [--seed N] [--documents N] [--timeout-seconds N]'
    printf '%s\n' '       ./dev soak [--minutes N] [--seed N] [--output PATH]'
    printf '%s\n' '       ./dev t [-k PATTERN | --all | --list]   fast tests for changed files (inner loop)'
    printf '%s\n' '       ./dev shot <file.svg> [--size WxH] [--zoom N] [--out FILE.png]   render and print a PNG path'
    printf '%s\n' '       ./dev pixdiff A B [--out diff.png] [--tolerance N]   precise image diff'
    printf '%s\n' '       ./dev final   full gate: verify + asan + ubsan + all fuzzers + e2e + soak + native smokes'
    printf '%s\n' '       ./dev wo-help'
}

command_name=${1:-help}

case "$command_name" in
    t|shot|pixdiff|final)
        repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
        cd "$repo_root"
        shift
        case "$command_name" in
            t) exec python3 scripts/quick_test.py "$@" ;;
            pixdiff) exec python3 scripts/pixdiff.py "$@" ;;
            shot)
                [ "$#" -ge 1 ] || { usage >&2; exit 2; }
                input=$1; shift
                size=1280x800; out=${TMPDIR:-/tmp}/vexel-shot.png; extra=
                while [ "$#" -gt 0 ]; do
                    case "$1" in
                        --size) size=$2; shift 2 ;;
                        --out) out=$2; shift 2 ;;
                        --zoom) extra="$extra --zoom $2"; shift 2 ;;
                        *) usage >&2; exit 2 ;;
                    esac
                done
                cmake --preset mac-debug >/dev/null && cmake --build --preset mac-debug --target svgworkbench >/dev/null
                ppm=${out%.png}.ppm
                # shellcheck disable=SC2086
                build/mac-debug/bin/svgworkbench --render-frame "$input" --size "$size" --out "$ppm" $extra || true
                sips -s format png "$ppm" --out "$out" >/dev/null && rm -f "$ppm"
                printf '%s\n' "$out"
                exit 0
                ;;
            final)
                started=$(date +%s)
                step() { printf '\n==> %s\n' "$*"; }
                step "verify (debug+release, ctest, python)"; "$repo_root/dev" verify
                step "asan"; "$repo_root/dev" asan
                step "ubsan"; "$repo_root/dev" ubsan
                step "shape fuzz"; "$repo_root/dev" shape-fuzz --seed 20261010 --output "$repo_root/.cache/qa/shape-fuzz-final.json"
                step "xml tokenizer fuzz (30 s)"; "$repo_root/dev" fuzz-xml --duration 30 --seed 20261010
                step "animation fuzz (200000 cases)"; "$repo_root/dev" animation-fuzz 200000 20261010
                step "mcp fuzz (200000 cases)"; "$repo_root/dev" mcp-fuzz 200000 20261010
                step "e2e (render matrix, mutations)"; "$repo_root/dev" e2e
                step "soak (1 minute)"; "$repo_root/dev" soak --minutes 1
                step "native editor smoke (real window, real mouse)"; "$repo_root/dev" editor-smoke
                step "native viewer smoke (real window)"; "$repo_root/dev" viewer-smoke
                printf '\nFINAL GATE PASSED in %ss\n' "$(( $(date +%s) - started ))"
                exit 0
                ;;
        esac
        ;;
esac
if [ "$command_name" = viewer-smoke ] && [ "$#" -gt 4 ]; then
    usage >&2
    exit 2
fi
if [ "$command_name" = viewer-panel-smoke ] && [ "$#" -gt 4 ]; then
    usage >&2
    exit 2
fi
if [ "$command_name" = editor-smoke ] && [ "$#" -gt 2 ]; then
    usage >&2
    exit 2
fi
if [ "$command_name" = run ]; then
    if [ "$#" -ne 2 ]; then
        usage >&2
        exit 2
    fi
elif [ "$#" -gt 1 ] && [ "${1:-}" != fuzz ] && [ "${1:-}" != fuzz-xml ] && [ "${1:-}" != shape-fuzz ] && [ "${1:-}" != animation-fuzz ] && [ "${1:-}" != mcp-fuzz ] && [ "${1:-}" != index-bench ] && [ "${1:-}" != perf-gate ] && [ "${1:-}" != bench-corpus ] && [ "${1:-}" != e2e ] && [ "${1:-}" != soak ] && [ "${1:-}" != viewer-smoke ] && [ "${1:-}" != viewer-panel-smoke ] && [ "${1:-}" != editor-smoke ]; then
    usage >&2
    exit 2
fi

case "$command_name" in
    help)
        usage
        exit 0
        ;;
    build|test-fast|test|verify|run|index-bench|perf-gate|bench-corpus|asan|ubsan|tsan|fuzz|fuzz-xml|shape-fuzz|animation-fuzz|mcp-fuzz|viewer-smoke|viewer-panel-smoke|editor-smoke|wo-help|doctor|bundle|dmg|e2e|soak)
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
run_cwd=$PWD
cd "$repo_root"

if [ "$(uname -s)" != "Darwin" ]; then
    printf '%s\n' 'vexel development commands currently require macOS.' >&2
    exit 2
fi

case "$command_name" in
    wo-help)
        "$repo_root/scripts/wo-run.sh" --help
        "$repo_root/scripts/wo-verify.sh" --help
        ;;
    # lane: w2-bundle
    doctor)
        python3 scripts/doctor.py
        ;;
    bundle)
        python3 packaging/vexel_packaging.py bundle
        ;;
    dmg)
        python3 packaging/vexel_packaging.py dmg
        ;;
    e2e)
        shift
        cmake --preset mac-release
        cmake --build --preset mac-release --target svgworkbench
        python3 scripts/e2e_svg.py "$@"
        ;;
    soak)
        shift
        python3 scripts/soak.py "$@"
        ;;
    build)
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        ;;
    run)
        cmake --preset mac-release
        cmake --build --preset mac-release
        cd "$run_cwd"
        exec "$repo_root/build/mac-release/bin/svgworkbench" "$2"
        ;;
    viewer-smoke)
        # lane: viewer2
        shift
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        "$repo_root/tests/viewer/native_smoke.sh" "$@"
        ;;
    viewer-panel-smoke)
        shift
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        "$repo_root/tests/viewer/panel_smoke.sh" "$@"
        ;;
    editor-smoke)
        # lane: w3-editor
        shift
        cmake --preset mac-debug
        cmake --build --preset mac-debug
        "$repo_root/tests/editor/native_smoke.sh" "$@"
        ;;
    test-fast|test)
        PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_runner.py --output .cache/test-results/latest.json
        python3 scripts/ledger.py validate ledger.jsonl
        ;;
    asan|ubsan)
        preset=mac-$command_name
        cmake --preset "$preset"
        cmake --build --preset "$preset"
        ctest --preset "$preset"
        ;;
    tsan)
        cmake --preset mac-tsan
        cmake --build --preset mac-tsan --target job_snapshot_test
        ctest --test-dir build/mac-tsan -R '^job-snapshot$' --output-on-failure
        ;;
    fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan
        python3 scripts/fuzz_smoke.py --binary build/mac-asan/bin/svgworkbench "$@"
        ;;
    fuzz-xml)
        shift
        duration=
        seed=
        report=
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --duration)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    duration=$2; shift 2 ;;
                --seed)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    seed=$2; shift 2 ;;
                --output)
                    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
                    report=$2; shift 2 ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        case "$duration" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        case "$seed" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        [ "$duration" -ge 1 ] && [ "$duration" -le 600 ] || { usage >&2; exit 2; }
        [ "$seed" -le 4294967295 ] || { usage >&2; exit 2; }
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target xml_tokenizer_fuzz
        # Default reports stay under the ignored .cache/ tree. Writing the pinned
        # WO-M2-03 packet requires an explicit --output.
        if [ -z "$report" ]; then
            mkdir -p .cache/qa
            report=.cache/qa/xml-fuzz-pr-smoke.json
            [ "$duration" -ne 600 ] || report=.cache/qa/xml-fuzz-scheduled.json
        fi
        python3 scripts/xml_fuzz_campaign.py --binary build/mac-asan/bin/xml_tokenizer_fuzz \
            --duration "$duration" --seed "$seed" --output "$report"
        ;;
    animation-fuzz)
        shift
        cases=200000
        seed=20261012
        [ "$#" -eq 0 ] || { cases=$1; shift; }
        [ "$#" -eq 0 ] || { seed=$1; shift; }
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        case "$cases" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        case "$seed" in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        [ "$cases" -ge 1 ] && [ "$cases" -le 100000000 ] || { usage >&2; exit 2; }
        [ "$seed" -le 4294967295 ] || { usage >&2; exit 2; }
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target animation_fuzz
        build/mac-asan/bin/animation_fuzz "$cases" "$seed"
        ;;
    shape-fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target shape_fuzz
        python3 tests/fuzz/shape/shape_fuzz.py --binary build/mac-asan/bin/shape_fuzz "$@"
        ;;
    # lane: w4-mcp
    mcp-fuzz)
        shift
        cmake --preset mac-asan
        cmake --build --preset mac-asan --target mcp_fuzz
        build/mac-asan/bin/mcp_fuzz "$@"
        ;;
    verify)
        "$repo_root/dev" build
        ctest --test-dir build/mac-debug --output-on-failure
        cmake --preset mac-release
        cmake --build --preset mac-release
        "$repo_root/dev" test-fast
        ;;
    index-bench)
        shift
        cmake --preset mac-release
        cmake --build --preset mac-release --target svg_index_bench
        python3 bench/generate/index_bench.py "$@"
        ;;
    perf-gate)
        shift
        python3 scripts/perf_gate.py "$@"
        ;;
    bench-corpus)
        shift
        if [ "$#" -eq 0 ]; then set -- --run; fi
        if [ "${1:-}" = --run ]; then
            cmake --preset mac-release
            cmake --build --preset mac-release --target svg_index_bench svgworkbench shape_render_cli
            cmake --preset mac-debug
            cmake --build --preset mac-debug --target svgworkbench shape_render_cli
        fi
        python3 reports/M4/head_to_head.py "$@"
        ;;
esac
